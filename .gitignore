/tools/code-contracts/node_modules/
/marvin/node_modules/
/marvin/dist/
result

# Erlang VM crash dumps from local runs
erl_crash.dump

# Property runner replay/shrink cache
/lyra/.hegel/

# NixOS interactive test-driver REPL history
.nixos-test-history

# Covenant writes runtime contract coverage on every test run; only
# contracts/coverage.static.json is a reviewed, committed inventory.
**/contracts/coverage.json
