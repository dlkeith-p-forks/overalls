+++ b/OvmfPkg/Include/IndustryStandard/CloudHv.h	2026-10-13 16:20:44.381521490 +0000
@@ -30,7 +30,12 @@
 //
 // 32-bit MMIO memory hole size
 //
-#define CLOUDHV_MMIO_HOLE_SIZE  0x38000000
+// Firecracker places its PCI MMCONFIG window at 0xdec00000 (256 MiB below the
+// IOAPIC minus 1 MiB per segment). Cloud Hypervisor's 896 MiB aperture would
+// let the PCI bus driver assign BARs inside that window, so the aperture ends
+// where Firecracker's 32-bit device window ends.
+//
+#define CLOUDHV_MMIO_HOLE_SIZE  0x1ec00000
 
