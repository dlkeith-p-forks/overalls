+        if !self.is_activated() {
+            return None;
+        }
+        // The transport keeps driving the device's own queue eventfds, so no
+        // clones are handed back: cloning would need an fcntl the vCPU thread's
+        // seccomp filter does not allow.
+        let queue_evts = Vec::new();
+        // Requests still in flight complete against rings the driver is
+        // abandoning; wait for them and discard their completions.
+        if let Err(err) = self.disk.file_engine.drain(true) {
+            error!("Failed to drain block requests on reset: {:?}", err);
+        }
+        self.is_io_engine_throttled = false;
+        match std::mem::replace(&mut self.device_state, DeviceState::Inactive) {
+            DeviceState::Activated(active) => Some((active.interrupt, queue_evts)),
+            DeviceState::Inactive => None,
+        }
