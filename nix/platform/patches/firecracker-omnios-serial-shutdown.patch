 use crate::utils::usize_to_u64;
 use crate::vstate::bus::BusDevice;

+/// OmniOS emits this fixed marker after all guest filesystems are synced.
+const ILLUMOS_SYNC_MARKER: &[u8] = b"syncing file systems... done";
+
+#[derive(Debug, Default)]
+struct ShutdownMarkerDetector {
+    matched: usize,
+}
+
+impl ShutdownMarkerDetector {
+    /// @cc [owner:ghuntley,label:recovery;protocol] illumos-serial-shutdown-marker
+    /// The detector MUST signal only after the exact contiguous sync marker has
+    /// been written, preserve partial matches across output calls, and retain no
+    /// guest output bytes beyond the bounded marker-match state.
+    fn observe(&mut self, bytes: &[u8]) -> bool {
+        for byte in bytes {
+            if *byte == ILLUMOS_SYNC_MARKER[self.matched] {
+                self.matched += 1;
+                if self.matched == ILLUMOS_SYNC_MARKER.len() {
+                    self.matched = 0;
+                    return true;
+                }
+            } else {
+                self.matched = usize::from(*byte == ILLUMOS_SYNC_MARKER[0]);
+            }
+        }
+        false
+    }
+}
+
