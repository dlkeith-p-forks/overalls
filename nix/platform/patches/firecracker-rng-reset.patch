+    /// @cc [owner:ghuntley,label:recovery;isolation] virtio-rng-reset-fence
+    /// An activated entropy device MUST release guest memory and interrupt on reset,
+    /// clear all guest descriptor references in its preallocated ring storage, and
+    /// return a reset result to the PCI transport. An inactive device MUST return no
+    /// reset result.
+    fn reset(&mut self) -> Option<(Arc<dyn VirtioInterrupt>, Vec<EventFd>)> {
+        if !self.is_activated() {
+            return None;
+        }
+        // Reset runs in the vCPU thread; reusing this IovDeque avoids memfd_create
+        // under the vCPU seccomp filter.
+        self.buffer.clear();
+        match std::mem::replace(&mut self.device_state, DeviceState::Inactive) {
+            DeviceState::Activated(active) => Some((active.interrupt, Vec::new())),
+            DeviceState::Inactive => None,
+        }
+    }
+
     fn is_activated(&self) -> bool {
         self.device_state.is_activated()
     }
