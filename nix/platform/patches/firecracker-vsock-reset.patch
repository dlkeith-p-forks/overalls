+    /// @cc [owner:ghuntley,label:recovery;isolation] virtio-vsock-reset-fence
+    /// An activated vsock device MUST release its guest memory and interrupt on a
+    /// transport reset, preserve its preallocated event and packet-ring resources,
+    /// and return status to the PCI transport so the guest can observe reset zero.
+    /// An inactive device MUST return no reset result.
+    fn reset(&mut self) -> Option<(Arc<dyn VirtioInterrupt>, Vec<EventFd>)> {
+        if !self.is_activated() {
+            return None;
+        }
+        // Reset runs in the vCPU thread, whose seccomp filter forbids memfd_create.
+        // Reuse the packet buffers' existing ring storage while dropping all guest
+        // descriptor references, then detach the active memory and interrupt.
+        self.rx_packet.reset();
+        self.tx_packet = VsockPacketTx::default();
+        self.pending_event_ack = false;
+        match std::mem::replace(&mut self.device_state, DeviceState::Inactive) {
+            DeviceState::Activated(active) => Some((active.interrupt, Vec::new())),
+            DeviceState::Inactive => None,
+        }
+    }
+
