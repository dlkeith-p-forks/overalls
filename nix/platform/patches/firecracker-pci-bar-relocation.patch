+    #[test]
+    fn test_bar_relocation_write_updates_address() {
+        let mut bars = Bars::default();
+        bars.set_bar_64(0, 0x40_0000_0000, 0x8_0000, BarPrefetchable::No);
+        assert_eq!(bars.get_bar_addr_64(0), 0x40_0000_0000);
+        // Sizing probe: the address is unchanged and the next read is the size
+        // mask with the 64-bit type bit kept in the low half only.
+        bars.write(0, 0, &0xffff_ffffu32.to_le_bytes());
+        let mut size = [0u8; 4];
+        bars.read(0, 0, &mut size);
+        assert_eq!(u32::from_le_bytes(size), 0xfff8_0004);
+        bars.write(1, 0, &0xffff_ffffu32.to_le_bytes());
+        bars.read(1, 0, &mut size);
+        assert_eq!(u32::from_le_bytes(size), 0xffff_ffff);
+        assert_eq!(bars.get_bar_addr_64(0), 0x40_0000_0000);
+        // Firmware moves the BAR to 0x1_4000_0000: low half then high half.
+        bars.write(0, 0, &0x4000_0000u32.to_le_bytes());
+        assert_eq!(bars.get_bar_addr_64(0), 0x40_4000_0000);
+        bars.write(1, 0, &0x1u32.to_le_bytes());
+        assert_eq!(bars.get_bar_addr_64(0), 0x1_4000_0000);
+        // Type bits survive and misaligned low bits are dropped.
+        let mut low = [0u8; 4];
+        bars.read(0, 0, &mut low);
+        assert_eq!(u32::from_le_bytes(low) & 0b1111, 0b100);
+        bars.write(0, 0, &0x4001_2345u32.to_le_bytes());
+        assert_eq!(bars.get_bar_addr_64(0), 0x1_4000_0000);
+        // Partial writes merge into the register.
+        bars.write(1, 0, &[0x02]);
+        assert_eq!(bars.get_bar_addr_64(0), 0x2_4000_0000);
+        // Unused BARs ignore address writes.
+        bars.write(3, 0, &0x8000_0000u32.to_le_bytes());
+        let mut unused = [0u8; 4];
+        bars.read(3, 0, &mut unused);
+        assert_eq!(unused, [0; 4]);
+    }
