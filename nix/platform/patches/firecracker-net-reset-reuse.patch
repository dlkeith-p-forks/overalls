     #[test]
+    fn test_native_rx_reset_reuses_mapping_without_memfd() {
+        let mut buffers = RxBuffers::new().unwrap();
+        let mapping = buffers.iovec.as_iovec_mut_slice().as_ptr() as usize;
+        buffers.min_buffer_size = 512;
+        buffers.used_descriptors = 1;
+        buffers.used_bytes = 128;
+        buffers.parsed_descriptors.push_back(ParsedDescriptorChain {
+            head_index: 7,
+            length: 512,
+            nr_iovecs: 1,
+        });
+        std::thread::spawn(move || {
+            // Load seccomp_data.nr; deny memfd_create with EPERM; allow others.
+            // Install on this disposable thread only, after initial allocation.
+            let instruction = |code: u16, jt: u8, jf: u8, k: u32| {
+                let [c0, c1] = code.to_ne_bytes();
+                let [k0, k1, k2, k3] = k.to_ne_bytes();
+                u64::from_ne_bytes([c0, c1, jt, jf, k0, k1, k2, k3])
+            };
+            let filter = [
+                instruction(0x20, 0, 0, 0),
+                instruction(0x15, 0, 1, libc::SYS_memfd_create as u32),
+                instruction(0x06, 0, 0, 0x0005_0001),
+                instruction(0x06, 0, 0, 0x7fff_0000),
+            ];
+            crate::seccomp::apply_filter(&filter).unwrap();
+            buffers.reset();
+            assert_eq!(buffers.iovec.as_iovec_mut_slice().as_ptr() as usize, mapping);
+            assert_eq!(buffers.min_buffer_size, 0);
+            assert_eq!(buffers.iovec.len(), 0);
+            assert!(buffers.parsed_descriptors.is_empty());
+            assert_eq!(buffers.used_descriptors, 0);
+            assert_eq!(buffers.used_bytes, 0);
+        })
+        .join()
+        .unwrap();
+    }
+
