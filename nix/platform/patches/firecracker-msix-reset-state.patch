+    fn test_native_msix_reset_state_matches_capability() {
+        let cap = MsixCap::new(4, 2, 0, 4, 0x40000);
+        let mut config = MsixConfig::new(msix_vector_group(2), PciSBDF::from(0x42));
+        assert_eq!({ cap.msg_ctl }, 1);
+        assert!(!config.enabled);
+        assert!(!config.masked);
+        assert!(config.table_entries.iter().all(MsixTableEntry::masked));
+
+        // illumos enables only when the guest-visible enable bit is clear.
+        if cap.msg_ctl & 0x8000 == 0 {
+            config.write_msg_ctl_register(2, &(cap.msg_ctl | 0x8000).to_le_bytes());
+        }
+        assert!(config.enabled);
+        assert!(!config.masked);
+    }
