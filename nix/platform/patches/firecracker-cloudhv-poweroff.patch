+// Copyright 2026 Overalls contributors.
+// SPDX-License-Identifier: Apache-2.0
+
+//! The fixed CloudHv firmware shutdown port, separate from ACPI PM registers.
+
+use std::sync::{Arc, Barrier};
+
+use vmm_sys_util::eventfd::EventFd;
+
+use crate::logger::error;
+use crate::vstate::bus::BusDevice;
+
+/// edk2 CloudHv ResetSystemLib's fixed shutdown port.
+pub const CLOUDHV_POWER_PORT: u64 = 0x600;
+/// The firmware uses one byte at this port.
+pub const CLOUDHV_POWER_SIZE: u64 = 1;
+
+/// A firmware poweroff request using the existing VMM exit event.
+#[derive(Debug)]
+pub struct CloudHvPower {
+    exit_evt: EventFd,
+}
+
+impl CloudHvPower {
+    /// Bind the same event which stops the VMM for a guest i8042 reset.
+    pub fn new(exit_evt: EventFd) -> Self {
+        Self { exit_evt }
+    }
+}
+
+/// @cc [owner:ghuntley,label:protocol;recovery] cloudhv-shutdown-exact-request
+/// Only the single-byte S5 value 0x34 at the fixed port and offset zero MUST
+/// signal the VMM exit event. Reads and malformed, partial, reset or unknown
+/// writes MUST NOT signal exit. No guest payload bytes may enter diagnostics.
+impl BusDevice for CloudHvPower {
+    fn read(&mut self, _base: u64, _offset: u64, data: &mut [u8]) {
+        data.fill(0xff);
+    }
+
+    fn write(&mut self, base: u64, offset: u64, data: &[u8]) -> Option<Arc<Barrier>> {
+        if base == CLOUDHV_POWER_PORT && offset == 0 && data == [0x34] {
+            if self.exit_evt.write(1).is_err() {
+                error!("Failed to signal firmware shutdown event");
+            }
+        }
+        None
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::io::ErrorKind;
+
+    use super::*;
+
+    #[test]
+    fn test_cloudhv_shutdown_exact_request_and_refusals() {
+        let event = EventFd::new(libc::EFD_NONBLOCK).unwrap();
+        let mut device = CloudHvPower::new(event.try_clone().unwrap());
+        let mut data = [0];
+        device.read(CLOUDHV_POWER_PORT, 0, &mut data);
+        assert_eq!(data, [0xff]);
+        for (base, offset, bytes) in [
+            (CLOUDHV_POWER_PORT, 0, &[][..]),
+            (CLOUDHV_POWER_PORT, 0, &[0x34, 0][..]),
+            (CLOUDHV_POWER_PORT, 1, &[0x34][..]),
+            (CLOUDHV_POWER_PORT + 1, 0, &[0x34][..]),
+            (CLOUDHV_POWER_PORT, 0, &[0][..]),
+            (CLOUDHV_POWER_PORT, 0, &[1][..]),
+            (CLOUDHV_POWER_PORT, 0, &[2][..]),
+            (CLOUDHV_POWER_PORT, 0, &[0xff][..]),
+        ] {
+            assert!(device.write(base, offset, bytes).is_none());
+            assert_eq!(event.read().unwrap_err().kind(), ErrorKind::WouldBlock);
+        }
+        assert!(device.write(CLOUDHV_POWER_PORT, 0, &[0x34]).is_none());
+        assert_eq!(event.read().unwrap(), 1);
+    }
+}
