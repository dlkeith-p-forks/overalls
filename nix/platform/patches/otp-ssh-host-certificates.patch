 -doc(#{group => <<"Options">>}).
 -type user_dir_fun_common_option() :: {user_dir_fun, user2dir()}.
+%% Local server certificate reader; user-key decoding deliberately stays unchanged.
+-spec host_certificate(atom(), list()) -> {ok, binary()} | {error, invalid_host_certificate}.
+host_certificate('ssh-ed25519-cert-v01@openssh.com', Opts) ->
+    Path = filename:join(proplists:get_value(system_dir, Opts, "/etc/ssh"),
+                         "ssh_host_ed25519_key-cert.pub"),
+    try
+        {ok, File} = file:open(Path, [read, binary, raw]),
+        Result = try file:read(File, 16385) after file:close(File) end,
+        {ok, Bytes} = Result,
+        true = byte_size(Bytes) =< 16384,
+        [<<"ssh-ed25519-cert-v01@openssh.com">>, Encoded | _] =
+            string:lexemes(Bytes, " \t\r\n"),
+        Blob = base64:decode(Encoded),
+        {ok, Blob}
+    catch _:_ -> {error, invalid_host_certificate}
+    end;
+host_certificate(_, _) -> {error, invalid_host_certificate}.
+
