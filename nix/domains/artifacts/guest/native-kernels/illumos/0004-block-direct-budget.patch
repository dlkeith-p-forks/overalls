-	    VIRTIO_BLK_REQ_BUFS);
+	vib->vib_reqs_capacity = vioblk_request_capacity(
+	    virtio_queue_size(vib->vib_vq), &vib->vib_seg_max,
+	    virtio_feature_present(vib->vib_virtio, VIRTIO_F_RING_INDIRECT_DESC));
@@ -983,0 +1012,6 @@
