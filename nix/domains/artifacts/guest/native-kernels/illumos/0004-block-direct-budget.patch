+/** @cc [owner:ghuntley,label:capacity;recovery] illumos-block-direct-descriptor-budget
+ * Every concurrent direct request MUST own its worst-case data descriptors plus
+ * its header and status descriptors. Clamp the data scatter limit before DMA
+ * setup and bound the request pool by the shared ring. Indirect requests retain
+ * one ring descriptor each; rings too small for a direct request MUST refuse.
+ */
+static uint_t
+vioblk_request_capacity(uint_t qsize, uint_t *segments, boolean_t indirect)
+{
+	if (qsize == 0 || *segments == 0)
+		return (0);
+	if (indirect)
+		return (MIN(qsize, VIRTIO_BLK_REQ_BUFS));
+	if (qsize < 3)
+		return (0);
+	*segments = MIN(*segments, qsize - 2);
+	return (MIN(qsize / (*segments + 2), VIRTIO_BLK_REQ_BUFS));
+}
+
@@ -822,2 +849,3 @@
