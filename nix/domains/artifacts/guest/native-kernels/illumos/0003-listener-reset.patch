+/**
+ * @cc [owner:ghuntley,label:security;recovery] opt-in-listener-disconnect
+ * Only SM_LISTENERR listeners opt into permanent accept failure. Disconnect
+ * MUST publish a sticky ECONNRESET fence and wake accept waiters under
+ * so_acceptq_lock before releasing so_lock. Ordinary protocols MUST retain
+ * existing behavior.
+ */
 int
 so_disconnected(sock_upper_handle_t sock_handle, sock_connid_t id, int error)
 {
@@ -1033,6 +1040,13 @@ so_disconnected(sock_upper_handle_t sock_handle, sock_connid_t id, int error)
 
 	so->so_proto_connid = id;
 	soisdisconnected(so, error);
+	if ((so->so_mode & SM_LISTENERR) != 0 &&
+	    (so->so_state & SS_ACCEPTCONN) != 0 && error != 0) {
+		mutex_enter(&so->so_acceptq_lock);
+		so->so_state |= SS_LISTENERR;
+		cv_broadcast(&so->so_acceptq_cv);
+		mutex_exit(&so->so_acceptq_lock);
+	}
 	so_notify_disconnected(so, connect_failed, error);
 
 	return (0);
@@ -1131,7 +1145,8 @@ so_newconn(sock_upper_handle_t parenthandle,
 	*sock_upcallsp = &so_upcalls;
 
 	mutex_enter(&so->so_acceptq_lock);
-	if (so->so_state & (SS_CLOSING|SS_FALLBACK_PENDING|SS_FALLBACK_COMP)) {
+	if (so->so_state &
+	    (SS_CLOSING|SS_FALLBACK_PENDING|SS_FALLBACK_COMP|SS_LISTENERR)) {
 		mutex_exit(&so->so_acceptq_lock);
 		ASSERT(nso->so_count == 1);
 		nso->so_count--;
