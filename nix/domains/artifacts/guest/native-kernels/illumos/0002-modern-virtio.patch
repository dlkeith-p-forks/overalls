+
+static uint16_t
+virtio_modern_devcfg_get16(virtio_t *vio, uintptr_t offset)
+{
+	return (virtio_le16toh(ddi_get16(vio->vio_cap_device.vpc_barh,
+	    (uint16_t *)(vio->vio_cap_device.vpc_bar + offset))));
