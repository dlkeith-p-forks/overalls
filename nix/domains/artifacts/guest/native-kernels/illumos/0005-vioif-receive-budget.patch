+/** @cc [owner:ghuntley,label:capacity;recovery] illumos-net-receive-descriptor-budget
+ * A receive buffer on loan to the network stack keeps its ring descriptors
+ * until the stack frees it. Without negotiated indirect descriptors each
+ * buffer costs its header descriptor plus every data cookie. Loans MUST be
+ * bounded by half the buffers the ring can hold, so a socket that stops
+ * reading can never leave the device without receive buffers. Indirect
+ * buffers retain one ring descriptor each.
+ */
+static uint_t
+vioif_rx_loan_limit(uint_t qsize, uint_t buffers, uint_t cookies,
+    boolean_t indirect)
+{
+	uint_t chains;
+
+	if (indirect) {
+		chains = qsize;
+	} else if (cookies == 0 || cookies >= qsize) {
+		chains = 0;
+	} else {
+		chains = qsize / (cookies + 1);
+	}
+	return (MIN(buffers, chains) / 2);
+}
+
 static int
 vioif_alloc_bufs(vioif_t *vif)
 {
@@ -509,12 +534,6 @@ vioif_alloc_bufs(vioif_t *vif)
