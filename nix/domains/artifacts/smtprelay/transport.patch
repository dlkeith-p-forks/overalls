+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func fixtureTLS(t *testing.T) (*tls.Config, string) {
+	t.Helper()
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cert := &x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "localhost"}, DNSNames: []string{"localhost"}, IPAddresses: []net.IP{net.ParseIP("127.0.0.1")}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), KeyUsage: x509.KeyUsageDigitalSignature | x509.KeyUsageCertSign, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}, IsCA: true, BasicConstraintsValid: true}
+	der, err := x509.CreateCertificate(rand.Reader, cert, cert, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	crt := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})
+	ca := filepath.Join(t.TempDir(), "ca.pem")
+	if err = os.WriteFile(ca, crt, 0600); err != nil {
+		t.Fatal(err)
+	}
+	return &tls.Config{MinVersion: tls.VersionTLS12, Certificates: []tls.Certificate{{Certificate: [][]byte{der}, PrivateKey: key}}}, ca
+}
+
+func TestOverallsTransport(t *testing.T) {
+	for _, mode := range []string{"implicit", "starttls"} {
+		for _, auth := range []string{"plain", "login"} {
+			t.Run(mode+"-"+auth, func(t *testing.T) {
+				tc, ca := fixtureTLS(t)
+				received := make(chan string, 1)
+				srv := &smtpd.Server{Hostname: "localhost", TLSConfig: tc, Authenticator: func(_ context.Context, _ smtpd.Peer, u, p string) error {
+					if u != "fixture" || p != "private" {
+						return fmt.Errorf("invalid auth")
+					}
+					return nil
+				}, Handler: func(_ context.Context, _ smtpd.Peer, e smtpd.Envelope) error { received <- string(e.Data); return nil }}
+				ln, err := net.Listen("tcp", "127.0.0.1:0")
+				if err != nil {
+					t.Fatal(err)
+				}
+				var listener net.Listener = ln
+				if mode == "implicit" {
+					listener = tls.NewListener(ln, tc)
+				}
+				ctx, cancel := context.WithCancel(context.Background())
+				defer cancel()
+				defer srv.Shutdown(false)
+				go srv.Serve(ctx, listener)
+				cfg := &config{remoteHost: ln.Addr().String(), remoteTLS: mode, remoteCA: ca, remoteAuth: auth, remoteUser: "fixture", remotePass: "private", hostName: "localhost"}
+				envelope := smtpd.Envelope{Sender: "from@example.test", Recipients: []string{"to@example.test"}, Data: []byte("Message-ID: <stable@example.test>\r\n\r\nprivate-link\r\n")}
+				if err = forward(ctx, cfg, envelope); err != nil {
+					t.Fatal(err)
+				}
+				select {
+				case body := <-received:
+					if !strings.Contains(body, "stable@example.test") {
+						t.Fatal("message altered")
+					}
+				case <-time.After(time.Second):
+					t.Fatal("missing message")
+				}
+				cfg.remotePass = "wrong"
+				if forward(ctx, cfg, envelope) == nil {
+					t.Fatal("wrong password accepted")
+				}
+				cfg.remoteCA = ""
+				if forward(ctx, cfg, envelope) == nil {
+					t.Fatal("untrusted certificate accepted")
+				}
+			})
+		}
+	}
+}
+
+func TestOverallsNoSTARTTLS(t *testing.T) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	done := make(chan string, 1)
+	go func() {
+		c, e := ln.Accept()
+		if e != nil {
+			return
+		}
+		defer c.Close()
+		c.SetDeadline(time.Now().Add(time.Second))
+		fmt.Fprint(c, "220 fixture\r\n")
+		r := bufio.NewReader(c)
+		r.ReadString('\n')
+		fmt.Fprint(c, "250 fixture\r\n")
+		line, _ := r.ReadString('\n')
+		done <- line
+	}()
+	cfg := &config{remoteHost: ln.Addr().String(), remoteTLS: "starttls", remoteAuth: "plain", remoteUser: "fixture", remotePass: "private", hostName: "localhost"}
+	if forward(context.Background(), cfg, smtpd.Envelope{}) == nil {
+		t.Fatal("plaintext accepted")
+	}
+	if line := <-done; line != "" {
+		t.Fatal("sent data without TLS")
+	}
+}
+
+func TestOverallsCancellationAndDeadline(t *testing.T) {
+	for _, cancelEarly := range []bool{true, false} {
+		t.Run(fmt.Sprint(cancelEarly), func(t *testing.T) {
+			ln, err := net.Listen("tcp", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer ln.Close()
+			closed := make(chan struct{})
+			go func() {
+				c, e := ln.Accept()
+				if e != nil {
+					return
+				}
+				defer c.Close()
+				c.SetDeadline(time.Now().Add(10 * time.Second))
+				bufio.NewReader(c).ReadByte()
+				close(closed)
+			}()
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			if cancelEarly {
+				time.AfterFunc(100*time.Millisecond, cancel)
+			}
+			start := time.Now()
+			err = forward(ctx, &config{remoteHost: ln.Addr().String(), remoteTLS: "starttls"}, smtpd.Envelope{})
+			if err == nil || time.Since(start) > 9*time.Second {
+				t.Fatal("unbounded forwarding")
+			}
+			select {
+			case <-closed:
+			case <-time.After(time.Second):
+				t.Fatal("upstream connection retained")
+			}
+		})
+	}
+}
+
+func TestOverallsCredentialFiles(t *testing.T) {
+	file := filepath.Join(t.TempDir(), "credential")
+	for _, value := range []string{"", "line\nbreak", "nul\x00byte", strings.Repeat("a", 4097), "valid"} {
+		os.WriteFile(file, []byte(value), 0600)
+		got, err := readCredential(file)
+		if value == "valid" {
+			if err != nil || got != value {
+				t.Fatal("valid credential rejected")
+			}
+		} else if err == nil {
+			t.Fatal("invalid credential accepted")
+		}
+	}
+}
+
+func TestOverallsPrivateFailureAndHostname(t *testing.T) {
+	tc, ca := fixtureTLS(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	srv := &smtpd.Server{TLSConfig: tc, Authenticator: func(context.Context, smtpd.Peer, string, string) error { return nil }, Handler: func(context.Context, smtpd.Peer, smtpd.Envelope) error {
+		return &textproto.Error{Code: 451, Msg: "private-token-provider-reflection"}
+	}}
+	ln, err := net.Listen("tcp", "127.0.0.2:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer srv.Shutdown(false)
+	go srv.Serve(ctx, tls.NewListener(ln, tc))
+	cfg := &config{remoteHost: ln.Addr().String(), remoteTLS: "implicit", remoteCA: ca, remoteAuth: "plain", remoteUser: "fixture", remotePass: "private", hostName: "localhost"}
+	if forward(ctx, cfg, smtpd.Envelope{}) == nil {
+		t.Fatal("wrong hostname accepted")
+	}
+	// localhost resolves to 127.0.0.1, so use a second listener for the trusted case.
+	srv2 := &smtpd.Server{TLSConfig: tc, Authenticator: srv.Authenticator, Handler: srv.Handler}
+	ln2, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer srv2.Shutdown(false)
+	go srv2.Serve(ctx, tls.NewListener(ln2, tc))
+	cfg.remoteHost = ln2.Addr().String()
+	var logs bytes.Buffer
+	previous := slog.Default()
+	slog.SetDefault(slog.New(slog.NewJSONHandler(&logs, nil)))
+	defer slog.SetDefault(previous)
+	relay := &relay{cfg: cfg}
+	err = relay.mailHandler(cfg)(ctx, smtpd.Peer{Addr: &net.TCPAddr{IP: net.ParseIP("127.0.0.1"), Port: 1234}}, smtpd.Envelope{Sender: "from@example.test", Recipients: []string{"to@example.test"}, Data: []byte("Subject: private-token\r\n\r\nprivate-token\r\n")})
+	if err == nil || strings.Contains(err.Error()+logs.String(), "private-token") {
+		t.Fatal("unsafe provider failure")
+	}
+}
