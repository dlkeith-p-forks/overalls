+package main
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"io"
+	"net"
+	"net/smtp"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/grafana/smtprelay/v2/internal/smtpd"
+)
+
+var errRemote = errors.New("invalid upstream configuration")
+
+// Credentials are bounded opaque values read only from private runtime files.
+func readCredential(path string) (string, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return "", errRemote
+	}
+	defer f.Close()
+	b, err := io.ReadAll(io.LimitReader(f, 4097))
+	if err != nil || len(b) == 0 || len(b) > 4096 || strings.ContainsAny(string(b), "\r\n\x00") {
+		return "", errRemote
+	}
+	return string(b), nil
+}
+
+func configureRemote(cfg *config) error {
+	var err error
+	if cfg.remoteUserFile != "" {
+		cfg.remoteUser, err = readCredential(cfg.remoteUserFile)
+		if err != nil {
+			return errRemote
+		}
+	}
+	if cfg.remotePassFile == "" {
+		return errRemote
+	}
+	cfg.remotePass, err = readCredential(cfg.remotePassFile)
+	if err != nil {
+		return errRemote
+	}
+	if cfg.remoteTLS != "starttls" && cfg.remoteTLS != "implicit" {
+		return errRemote
+	}
+	if cfg.remoteAuth != "plain" && cfg.remoteAuth != "login" {
+		return errRemote
+	}
+	host, port, err := net.SplitHostPort(cfg.remoteHost)
+	if err != nil || host == "" || port == "" || cfg.remoteUser == "" {
+		return errRemote
+	}
+	_, err = upstreamTLS(cfg, host)
+	return err
+}
+
+func upstreamTLS(cfg *config, host string) (*tls.Config, error) {
+	var roots *x509.CertPool
+	if cfg.remoteCA != "" {
+		data, err := os.ReadFile(cfg.remoteCA)
+		if err != nil {
+			return nil, errRemote
+		}
+		roots = x509.NewCertPool()
+		if !roots.AppendCertsFromPEM(data) {
+			return nil, errRemote
+		}
+	}
+	return &tls.Config{MinVersion: tls.VersionTLS12, ServerName: host, RootCAs: roots}, nil
+}
+
+// The entire upstream exchange has a deadline, including DNS, TLS, AUTH and DATA.
+// No success is returned until DATA's final acceptance; no retry or disk spool exists.
+func forward(parent context.Context, cfg *config, env smtpd.Envelope) error {
+	ctx, cancel := context.WithTimeout(parent, 8*time.Second)
+	defer cancel()
+	host, _, err := net.SplitHostPort(cfg.remoteHost)
+	if err != nil {
+		return errRemote
+	}
+	tc, err := upstreamTLS(cfg, host)
+	if err != nil {
+		return err
+	}
+	conn, err := (&net.Dialer{Timeout: 3 * time.Second}).DialContext(ctx, "tcp", cfg.remoteHost)
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+	stop := context.AfterFunc(ctx, func() { _ = conn.Close() })
+	defer stop()
+	deadline, _ := ctx.Deadline()
+	if err = conn.SetDeadline(deadline); err != nil {
+		return err
+	}
+	var wire net.Conn = conn
+	if cfg.remoteTLS == "implicit" {
+		secure := tls.Client(conn, tc)
+		if err = secure.HandshakeContext(ctx); err != nil {
+			return err
+		}
+		wire = secure
+	} else if cfg.remoteTLS != "starttls" {
+		return errRemote
+	}
+	client, err := smtp.NewClient(wire, host)
+	if err != nil {
+		return err
+	}
+	defer client.Close()
+	if err = client.Hello(cfg.hostName); err != nil {
+		return err
+	}
+	if cfg.remoteTLS == "starttls" {
+		if ok, _ := client.Extension("STARTTLS"); !ok {
+			return errRemote
+		}
+		if err = client.StartTLS(tc); err != nil {
+			return err
+		}
+	}
+	var auth smtp.Auth
+	switch cfg.remoteAuth {
+	case "plain":
+		auth = smtp.PlainAuth("", cfg.remoteUser, cfg.remotePass, host)
+	case "login":
+		auth = &loginAuth{username: cfg.remoteUser, password: cfg.remotePass, host: host}
+	default:
+		return errRemote
+	}
+	if cfg.remoteUser == "" || cfg.remotePass == "" {
+		return errRemote
+	}
+	if err = client.Auth(auth); err != nil {
+		return err
+	}
+	sender := env.Sender
+	if cfg.remoteSender != "" {
+		sender = cfg.remoteSender
+	}
+	if err = client.Mail(sender); err != nil {
+		return err
+	}
+	for _, recipient := range env.Recipients {
+		if err = client.Rcpt(recipient); err != nil {
+			return err
+		}
+	}
+	data, err := client.Data()
+	if err != nil {
+		return err
+	}
+	if _, err = data.Write(env.Data); err != nil {
+		return err
+	}
+	return data.Close()
+}
+
+type loginAuth struct {
+	username, password, host string
+	step                     int
+}
+
+func (a *loginAuth) Start(server *smtp.ServerInfo) (string, []byte, error) {
+	if !server.TLS || server.Name != a.host {
+		return "", nil, errRemote
+	}
+	a.step = 0
+	return "LOGIN", nil, nil
+}
+func (a *loginAuth) Next(_ []byte, more bool) ([]byte, error) {
+	if !more {
+		return nil, nil
+	}
+	a.step++
+	switch a.step {
+	case 1:
+		return []byte(a.username), nil
+	case 2:
+		return []byte(a.password), nil
+	}
+	return nil, errRemote
+}
