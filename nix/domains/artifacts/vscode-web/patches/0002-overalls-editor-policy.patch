+export async function runOverallsPolicyChecks(): Promise<void> {
+	assert.equal(isBuiltInAIDisabled(), true, 'test runner must set immutable product policy before module import');
+	const disposables = new DisposableStore();
+	const log = new NullLogService();
+	const context = new MockContextKeyService();
+	const config = new TestConfigurationService({ 'chat.agent.enabled': true, 'chat.disableAIFeatures': false });
+	const agents = disposables.add(new ChatAgentService(context, config));
