@@ -0,0 +1,96 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { Emitter } from '../../../../base/common/event.js';
+import { ResourceMap } from '../../../../base/common/map.js';
+import { IProductConfiguration } from '../../../../base/common/product.js';
+import { URI } from '../../../../base/common/uri.js';
+import { NullLogService } from '../../../log/common/log.js';
+import { Workspace, WorkspaceFolder } from '../../../workspace/common/workspace.js';
+import { Configuration, ConfigurationModel, ConfigurationModelParser } from '../../common/configurationModels.js';
+import { IPolicyConfiguration } from '../../common/configurations.js';
+import { isBuiltInAIDisabled, withOverallsProductPolicy } from '../../common/overallsProductPolicy.js';
+
+const policyProduct: Pick<IProductConfiguration, 'overallsEditor'> = {
+	overallsEditor: { releaseId: 'test', protocol: 1, extensionSigningKeys: [], policy: { builtInAI: 'disabled', workspaceTrust: 'disabled' } }
+};
+const keys = ['chat.disableAIFeatures', 'workbench.disableAICustomizations'] as const;
+
+/** @cc [owner:ghuntley,label:verification] overalls-policy-configuration-matrix
+ * Tests MUST execute the actual policy overlay and configuration engine through
+ * every setting scope, language override, initialization and change event.
+ */
+export async function runOverallsPolicyChecks(): Promise<void> {
+	const log = new NullLogService();
+	const empty = (): ConfigurationModel => ConfigurationModel.createEmptyModel(log);
+	const emitter = new Emitter<ConfigurationModel>();
+	let delegatedModel = empty();
+	delegatedModel.setValue('chat.disableAIFeatures', false);
+	delegatedModel.setValue('workbench.disableAICustomizations', false);
+	delegatedModel.setValue('unrelated.enterprise.policy', 'preserved');
+	const delegate: IPolicyConfiguration = {
+		onDidChangeConfiguration: emitter.event,
+		get configurationModel(): ConfigurationModel { return delegatedModel; },
+		async initialize(): Promise<ConfigurationModel> { return delegatedModel; }
+	};
+	assert.equal(isBuiltInAIDisabled({}), false);
+	assert.equal(isBuiltInAIDisabled(policyProduct), true);
+	assert.equal(withOverallsProductPolicy(delegate, log, {}), delegate);
+	const fixed = withOverallsProductPolicy(delegate, log, policyProduct);
+	function checkSnapshot(model: ConfigurationModel): void {
+		for (const key of keys) { assert.equal(model.getValue(key), true); }
+		assert.equal(model.getValue('unrelated.enterprise.policy'), 'preserved');
+	}
+	checkSnapshot(fixed.configurationModel);
+	checkSnapshot(await fixed.initialize());
+	let changes = 0;
+	const listener = fixed.onDidChangeConfiguration(model => { checkSnapshot(model); changes++; });
+	for (const value of [false, undefined, true]) {
+		delegatedModel = empty();
+		delegatedModel.setValue('unrelated.enterprise.policy', 'preserved');
+		for (const key of keys) {
+			if (value !== undefined) { delegatedModel.setValue(key, value); }
+		}
+		emitter.fire(delegatedModel);
+		checkSnapshot(fixed.configurationModel);
+	}
+	assert.equal(changes, 3);
+	listener.dispose();
+	emitter.dispose();
+
+	const folder = new WorkspaceFolder({ uri: URI.file('/project'), name: 'project', index: 0 });
+	const workspace = new Workspace('test', [folder], false, URI.file('/project/test.code-workspace'), () => false);
+	const resource = URI.file('/project/src/main.rs');
+	const parser = new ConfigurationModelParser('saved settings', log);
+	parser.parse(JSON.stringify({
+		'chat.disableAIFeatures': false,
+		'workbench.disableAICustomizations': false,
+		'editor.wordWrap': 'on',
+		'[rust]': { 'chat.disableAIFeatures': false, 'workbench.disableAICustomizations': false }
+	}));
+	const saved = parser.configurationModel;
+	for (const key of keys) { assert.equal(saved.override('rust').getValue(key), false); }
+	// Enumerate presence/absence in defaults, application, local/remote user,
+	// workspace, folder and memory; saved language settings ride with each scope.
+	for (let mask = 0; mask < 128; mask++) {
+		const scope = (bit: number): ConfigurationModel => mask & (1 << bit) ? saved : empty();
+		const folders = new ResourceMap<ConfigurationModel>();
+		folders.set(folder.uri, scope(5));
+		const memory = new ResourceMap<ConfigurationModel>();
+		memory.set(resource, saved);
+		const config = new Configuration(scope(0), fixed.configurationModel, scope(1), scope(2), scope(3), scope(4), folders, scope(6), memory, log);
+		for (const overrideIdentifier of [undefined, 'rust']) {
+			for (const key of keys) {
+				const overrides = { resource, overrideIdentifier };
+				assert.equal(config.getValue(key, overrides, workspace), true, `scope matrix ${mask}`);
+				assert.equal(config.inspect<boolean>(key, overrides, workspace).policyValue, true);
+				config.updateValue(key, false, { resource, overrideIdentifiers: ['rust'] });
+				assert.equal(config.getValue(key, overrides, workspace), true);
+			}
+		}
+		assert.equal(config.getValue('editor.wordWrap', { resource }, workspace), 'on');
+	}
+}
