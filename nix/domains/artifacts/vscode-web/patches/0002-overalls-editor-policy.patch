+	const called = (): never => { callbacks++; throw new Error('Disabled native callback executed'); };
+	const agentData: IChatAgentData = {
+		id: 'test.default', name: 'Test', extensionId: new ExtensionIdentifier('test.ai'), extensionVersion: undefined,
+		extensionPublisherId: 'test', extensionDisplayName: 'Test', isDefault: true,
+		metadata: {}, slashCommands: [], disambiguation: [], locations: [ChatAgentLocation.Chat], modes: [ChatModeKind.Ask]
+	};
+	const request: IChatAgentRequest = {
+		sessionResource: URI.parse('vscode-local-chat-session:/test'), requestId: 'test', agentId: agentData.id,
+		message: 'test', variables: { variables: [] }, location: ChatAgentLocation.Chat
+	};
+	try {
+		disposables.add(agents.registerAgent(agentData.id, agentData));
+		disposables.add(agents.registerAgentImplementation(agentData.id, { invoke: async () => called() }));
+		disposables.add(agents.registerDynamicAgent({ ...agentData, id: 'test.dynamic' }, { invoke: async () => called() }));
+		disposables.add(agents.registerAgentCompletionProvider(agentData.id, async () => called()));
+		disposables.add(agents.registerChatParticipantDetectionProvider(1, { provideParticipantDetection: async () => called() }));
+		assert.equal(agents.getAgents().length, 1, 'declarative extension contribution remains accepted');
+		assert.deepEqual(agents.getActivatedAgents(), []);
+		assert.equal(agents.hasToolsAgent, false);
+		assert.equal(agents.hasChatParticipantDetectionProviders(), false);
+		for (const key of [ChatContextKeys.enabled, ChatContextKeys.panelParticipantRegistered, ChatContextKeys.extensionParticipantRegistered]) {
+			assert.equal(context.getContextKeyValue(key.key), false);
+		}
+		await assert.rejects(agents.invokeAgent(agentData.id, request, called, [], CancellationToken.None), { message: builtInAIDisabledMessage });
+		assert.deepEqual(await agents.getAgentCompletionItems(agentData.id, 'test', CancellationToken.None), []);
+		assert.equal(await agents.detectAgentOrCommand(request, [], { location: ChatAgentLocation.Chat }, CancellationToken.None), undefined);
+
+		const extensionService = new class extends mock<IExtensionService>() {
+			override activateByEvent = async (): Promise<void> => called();
+			override whenInstalledExtensionsRegistered = async (): Promise<boolean> => called();
+		};
+		const storage = new class extends mock<IStorageService>() {
+			override readonly onWillSaveState = Event.None;
+		};
+		const languageModels = new LanguageModelsService(
+			extensionService, log, storage, context, new class extends mock<ILanguageModelsConfigurationService>() { },
+			new class extends mock<IQuickInputService>() { }, new class extends mock<ISecretStorageService>() { },
+			new class extends mock<IProductService>() { override readonly chatParticipantRegistry = 'https://example.invalid/native-chat'; },
+			new class extends mock<IRequestService>() { override request = async () => called(); },
+			new class extends mock<INotificationService>() { }, new class extends mock<IOpenerService>() { },
+			new class extends mock<ITelemetryService>() { }
+		);
+		disposables.add(languageModels);
+		languageModels.deltaLanguageModelChatProviderDescriptors([{ vendor: 'test', displayName: 'Test', configuration: undefined, managementCommand: undefined, when: undefined }], []);
+		const modelChanges = new Emitter<void>();
+		disposables.add(modelChanges);
+		disposables.add(languageModels.registerLanguageModelProvider('test', {
