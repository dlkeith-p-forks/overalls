+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { ErrorNoTelemetry } from '../../../base/common/errors.js';
+import { Event } from '../../../base/common/event.js';
+import { IProductConfiguration } from '../../../base/common/product.js';
+import { localize } from '../../../nls.js';
+import { ILogService } from '../../log/common/log.js';
+import product from '../../product/common/product.js';
+import { ConfigurationModel } from './configurationModels.js';
+import { IPolicyConfiguration } from './configurations.js';
+
+/** @cc [owner:ghuntley,label:security] overalls-built-in-ai-capability
+ * Bundled Chat, inline Chat and language-model entry points MUST honor the
+ * immutable product capability before activation, UI creation or provider calls.
+ * Independent extension UI and generic language completion APIs remain available.
+ */
+export function isBuiltInAIDisabled(configuration: Pick<IProductConfiguration, 'overallsEditor'> = product): boolean {
+	return configuration.overallsEditor?.policy?.builtInAI === 'disabled';
+}
+
+export const builtInAIDisabledMessage = localize('overalls.builtInAIDisabled', "Built-in AI features are disabled in this editor.");
+
+export function assertBuiltInAIEnabled(): void {
+	if (isBuiltInAIDisabled()) {
+		throw new ErrorNoTelemetry(builtInAIDisabledMessage);
+	}
+}
+
+/** @cc [owner:ghuntley,label:security] overalls-fixed-policy-precedence
+ * Product AI settings MUST merge after every delegated policy snapshot and
+ * change event, so user, workspace, folder and language settings cannot revive AI.
+ * Other policy values MUST be preserved; ordinary tooling defaults are not policy.
+ */
+export function withOverallsProductPolicy(delegate: IPolicyConfiguration, logService: ILogService, configuration: Pick<IProductConfiguration, 'overallsEditor'> = product): IPolicyConfiguration {
+	if (!isBuiltInAIDisabled(configuration)) {
+		return delegate;
+	}
+	const fixed = ConfigurationModel.createEmptyModel(logService);
+	fixed.setValue('chat.disableAIFeatures', true);
+	fixed.setValue('workbench.disableAICustomizations', true);
+	return {
+		onDidChangeConfiguration: Event.map(delegate.onDidChangeConfiguration, model => model.merge(fixed)),
+		get configurationModel(): ConfigurationModel { return delegate.configurationModel.merge(fixed); },
+		async initialize(): Promise<ConfigurationModel> { return (await delegate.initialize()).merge(fixed); }
+	};
+}
