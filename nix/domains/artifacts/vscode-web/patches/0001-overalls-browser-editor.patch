+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Overalls contributors. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+export interface IEditorWebviewOrigin {
+	readonly remoteAuthority: string;
+	readonly webviewEndpoint: string;
+}
+
+/**
+ * @cc [owner:ghuntley,label:security] trusted-editor-origin
+ * Editor authority and webview assets MUST derive only from the broker's canonical
+ * HTTPS origin and the packaged release. Missing or noncanonical origins MUST fail.
+ */
+export function getEditorWebviewOrigin(origin: string | undefined, releaseId: string | undefined): IEditorWebviewOrigin {
+	if (!origin || !releaseId || !/^[a-f0-9]{64}$/.test(releaseId)) {
+		throw new Error('A trusted editor origin and packaged release are required');
+	}
+	const parsed = new URL(origin);
+	const labels = parsed.hostname.split('.');
+	const zone = labels.slice(1).join('.');
+	if (parsed.protocol !== 'https:' || parsed.origin !== origin || parsed.username || parsed.password
+		|| !/^e-[a-z2-7]{25}[aeimquy4]-[a-z2-7]{25}[aeimquy4]$/.test(labels[0]) || labels.length < 3
+		|| !labels.slice(1).every(label => /^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/.test(label))) {
+		throw new Error('The trusted editor origin is not canonical');
+	}
+	return {
+		remoteAuthority: parsed.host,
+		webviewEndpoint: `https://{{uuid}}.${zone}${parsed.port ? `:${parsed.port}` : ''}/code-assets/${releaseId}/out/vs/workbench/contrib/webview/browser/pre/`
+	};
+}
