--- /dev/null
+++ b/src/vs/platform/extensionManagement/node/openVsxSignatureVerifier.ts
@@ -0,0 +1,62 @@
+/*---------------------------------------------------------------------------------------------
+ * Copyright (c) Overalls contributors. Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+import { createPublicKey, verify } from 'crypto';
+import { createReadStream, promises } from 'fs';
+import { buffer, validateZip } from '../../../base/node/zip.js';
+import { ExtensionSignatureVerificationCode } from '../common/extensionManagement.js';
+
+export const OPEN_VSX_MAX_VSIX_BYTES = 256 * 1024 * 1024;
+export const OPEN_VSX_MAX_SIGNATURE_BYTES = 1024 * 1024;
+
+/**
+ * @cc [owner:ghuntley,label:security] bounded-vsix-read
+ * VSIX reads MUST reject files exceeding the product byte limit, including a
+ * file that grows after its initial stat, before passing bytes to the verifier.
+ */
+async function readVsix(path: string): Promise<Buffer> {
+	const chunks: Buffer[] = [];
+	let size = 0;
+	for await (const chunk of createReadStream(path)) {
+		const bytes = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk);
+		size += bytes.length;
+		if (size > OPEN_VSX_MAX_VSIX_BYTES) {
+			throw new Error('VSIX exceeds the product byte limit');
+		}
+		chunks.push(bytes);
+	}
+	return Buffer.concat(chunks, size);
+}
+
+/**
+ * @cc [owner:ghuntley,label:security] whole-package-signature
+ * Verification MUST cover every VSIX byte using only the packaged Ed25519 key
+ * ring. Missing, duplicate, malformed, oversized and unknown signatures fail.
+ */
+export async function verifyOpenVsxSignature(vsixPath: string, signaturePath: string, publicKeys: readonly string[]): Promise<ExtensionSignatureVerificationCode> {
+	try {
+		const [vsixStat, signatureStat] = await Promise.all([promises.stat(vsixPath), promises.stat(signaturePath)]);
+		if (!vsixStat.isFile() || !signatureStat.isFile() || vsixStat.size > OPEN_VSX_MAX_VSIX_BYTES || signatureStat.size > OPEN_VSX_MAX_SIGNATURE_BYTES) {
+			return ExtensionSignatureVerificationCode.SignatureIsInvalid;
+		}
+		await validateZip(signaturePath, { maxEntries: 16, maxUncompressedSize: OPEN_VSX_MAX_SIGNATURE_BYTES, uniqueEntryNames: true });
+		const signature = await buffer(signaturePath, '.signature.sig');
+		if (signature.length !== 64) {
+			return ExtensionSignatureVerificationCode.SignatureIsInvalid;
+		}
+		const vsix = await readVsix(vsixPath);
+		for (const pem of publicKeys) {
+			const key = createPublicKey(pem);
+			if (key.asymmetricKeyType !== 'ed25519') {
+				return ExtensionSignatureVerificationCode.Untrusted;
+			}
+			if (verify(null, vsix, key, signature)) {
+				return ExtensionSignatureVerificationCode.Success;
+			}
+		}
+		return ExtensionSignatureVerificationCode.Untrusted;
+	} catch {
+		return ExtensionSignatureVerificationCode.SignatureIsInvalid;
+	}
+}
