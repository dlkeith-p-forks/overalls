+
+/* Replay from the durable checkpoint on enqueue failure. Duplicate delivery is
+ * preferable to advancing the journal past records that never entered storage. */
+static int overalls_systemd_retry(struct flb_systemd_config *ctx)
+{
+    char *checkpoint = NULL;
+    flb_log_event_encoder_reset(ctx->log_encoder);
+#ifdef FLB_HAVE_SQLDB
+    if (ctx->db) {
+        checkpoint = flb_systemd_db_get_cursor(ctx);
+    }
+#endif
+    if (checkpoint) {
+        sd_journal_seek_cursor(ctx->j, checkpoint);
+        sd_journal_next_skip(ctx->j, 1);
+        flb_free(checkpoint);
+    }
+    else {
+        sd_journal_seek_head(ctx->j);
+    }
+    ctx->pending_records = FLB_TRUE;
+    flb_plg_warn(ctx->ins, "journal enqueue failed; replaying durable checkpoint");
+    return FLB_SYSTEMD_BUSY;
 }
 
