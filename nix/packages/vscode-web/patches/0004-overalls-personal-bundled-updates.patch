+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import type { OverallsBundledExtensionId } from '../../../base/common/product.js';
+
+export interface IOverallsBundledExtensionUpdateConfiguration {
+	readonly overallsEditor?: {
+		readonly userUpdatableBundledExtensions?: unknown;
+	};
+}
+
+const userUpdatableBundledExtensions: readonly OverallsBundledExtensionId[] = [
+	'editorconfig.editorconfig',
+	'cab404.vscode-direnv',
+	'elixir-lsp.elixir-ls',
+	'rust-lang.rust-analyzer',
+];
+
+/** @cc [owner:ghuntley,label:security] overalls-personal-bundled-extension-updates
+ * Only the exact third-party bundle IDs explicitly enabled by immutable product
+ * metadata MAY use ordinary personal update paths. This MUST NOT grant core
+ * builtin install rights, force automatic updates or change signed bundle bytes.
+ */
+export function canUserUpdateOverallsBundledExtension(id: string, configuration: IOverallsBundledExtensionUpdateConfiguration): boolean {
+	const configured: unknown = configuration.overallsEditor?.userUpdatableBundledExtensions;
+	if (!Array.isArray(configured)) {
+		return false;
+	}
+	const normalized = id.toLowerCase();
+	return configured.some((entry: unknown) => typeof entry === 'string'
+		&& entry === normalized
+		&& userUpdatableBundledExtensions.some(bundledId => bundledId === entry));
+}
