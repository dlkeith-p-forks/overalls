From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Overalls maintainers <overalls@localhost>
Date: Sat, 17 Oct 2026 00:00:00 +0000
Subject: [PATCH 1/1] document the native virtio-vsock ABI contract

Keep the illumos transport's bounded ABI visible to the cross build and probe.
The implementation is intentionally isolated from the Linux UAPI.
---
 usr/src/uts/common/io/vsock/overalls_vsock_contract.h | 34 ++++++++++++++++++
 1 file changed, 34 insertions(+)
 create mode 100644 usr/src/uts/common/io/vsock/overalls_vsock_contract.h

--- /dev/null
+++ b/usr/src/uts/common/io/vsock/overalls_vsock_contract.h
@@ -0,0 +1,14 @@
+#ifndef _SYS_VSOCK_OVERALLS_CONTRACT_H
+#define _SYS_VSOCK_OVERALLS_CONTRACT_H
+
+#define OVERALLS_VSOCK_GUEST_CID 3ULL
+#define OVERALLS_VSOCK_HOST_CID 2ULL
+#define OVERALLS_VSOCK_MAX_SOCKETS 128U
+#define OVERALLS_VSOCK_MAX_FRAME 65536U
+#define OVERALLS_VSOCK_PORT_READINESS 1024U
+#define OVERALLS_VSOCK_PORT_FLUSH 1026U
+#define OVERALLS_VSOCK_PORT_TRUST 1030U
+#define OVERALLS_VSOCK_PORT_WORKSPACE 1031U
+#define OVERALLS_VSOCK_PORT_TERMINAL 1075U
+#define OVERALLS_VSOCK_PORT_ATTESTATION 1098U
+
+#endif
