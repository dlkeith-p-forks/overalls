# @cc [owner:ghuntley,label:security;recovery] ubuntu-workspace-receiver-unit
# The repository receiver MUST listen only after platform trust is installed,
# clone with the Ubuntu trust store and /usr/bin/git, and remain outside
# readiness (never in LILLY_REQUIRED_UNITS or ordered before lilly-readiness).
[Unit]
Description=Clone the Lilly-delivered public repository into /workspace
After=overalls-guest-trust.service
Wants=network-online.target
ConditionKernelCommandLine=lilly.boot_challenge

[Service]
Type=simple
ExecStart=/usr/local/bin/overalls-workspaced ubuntu
StateDirectory=overalls-workspace
StateDirectoryMode=0700
RuntimeDirectory=overalls-workspace
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/workspace

[Install]
WantedBy=multi-user.target
