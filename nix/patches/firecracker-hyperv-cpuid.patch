+    /// Install the Hyper-V interface leaves at `HYPERV_CPUID_BASE`.
+    ///
+    /// KVM implements the advertised MSRs unconditionally once the guest sees
+    /// the `Hv#1` interface signature; no `KVM_ENABLE_CAP` call is needed for
+    /// this feature set. The KVM signature leaves keep their content at
+    /// `KVM_CPUID_RELOCATED_BASE` so Linux guests still find kvmclock.
+    fn apply_hyperv_leaves(guest_cpuid: &mut BTreeMap<CpuidKey, CpuidEntry>) {
+        let kvm_leaves: Vec<(CpuidKey, CpuidEntry)> = guest_cpuid
+            .range(CpuidKey::leaf(HYPERV_CPUID_BASE)..CpuidKey::leaf(KVM_CPUID_RELOCATED_BASE))
+            .map(|(key, entry)| (key.clone(), entry.clone()))
+            .collect();
+        for (key, _) in &kvm_leaves {
+            guest_cpuid.remove(key);
+        }
+        for (key, mut entry) in kvm_leaves {
+            let relocated = key.leaf - HYPERV_CPUID_BASE + KVM_CPUID_RELOCATED_BASE;
+            if key.leaf == HYPERV_CPUID_BASE {
+                // Maximum leaf of the relocated KVM block.
+                entry.result.eax =
+                    entry.result.eax - HYPERV_CPUID_BASE + KVM_CPUID_RELOCATED_BASE;
+            }
+            guest_cpuid.insert(
+                CpuidKey {
+                    leaf: relocated,
+                    subleaf: key.subleaf,
+                },
+                entry,
+            );
+        }
+
+        let leaf = |leaf: u32, eax: u32, ebx: u32, ecx: u32, edx: u32| {
+            (
+                CpuidKey::leaf(leaf),
+                CpuidEntry {
+                    flags: KvmCpuidFlags::EMPTY,
+                    result: CpuidRegisters { eax, ebx, ecx, edx },
+                },
+            )
+        };
+        let hyperv_leaves = [
+            // Maximum leaf and vendor signature "Linux KVM Hv".
+            leaf(0x4000_0000, HYPERV_CPUID_MAX, 0x756e_694c, 0x564b_2078, 0x7648_204d),
+            // Interface signature "Hv#1".
+            leaf(0x4000_0001, 0x3123_7648, 0, 0, 0),
+            // Hypervisor build number and version.
+            leaf(0x4000_0002, 0x3839, 0xa_0000, 0, 0),
+            // Features.
+            leaf(
+                0x4000_0003,
+                HV_MSR_VP_RUNTIME_AVAILABLE
+                    | HV_MSR_TIME_REF_COUNT_AVAILABLE
+                    | HV_MSR_APIC_ACCESS_AVAILABLE
+                    | HV_MSR_HYPERCALL_AVAILABLE
+                    | HV_MSR_VP_INDEX_AVAILABLE
+                    | HV_MSR_REFERENCE_TSC_AVAILABLE
+                    | HV_ACCESS_FREQUENCY_MSRS,
+                0,
+                0,
+                HV_FEATURE_FREQUENCY_MSRS_AVAILABLE,
+            ),
+            // Recommendations; EBX is the spinlock retry count before trapping.
+            leaf(
+                0x4000_0004,
+                HV_X64_APIC_ACCESS_RECOMMENDED | HV_X64_RELAXED_TIMING_RECOMMENDED,
+                0xfff,
+                0,
+                0,
+            ),
+        ];
+        for (key, entry) in hyperv_leaves {
+            guest_cpuid.insert(key, entry);
+        }
+        for leaf_id in 0x4000_0005..=HYPERV_CPUID_MAX {
+            guest_cpuid.insert(CpuidKey::leaf(leaf_id), CpuidEntry::default());
+        }
+    }
 }
 
