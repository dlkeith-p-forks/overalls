     #[test]
+    fn test_apply_hyperv_leaves() {
+        let mut config = supported_cpu_config();
+        config.cpuid.inner_mut().insert(
+            CpuidKey::leaf(0x4000_0000),
+            CpuidEntry {
+                flags: KvmCpuidFlags::EMPTY,
+                result: CpuidRegisters {
+                    eax: 0x4000_0001,
+                    ebx: 0x4b4d_564b,
+                    ecx: 0x564b_4d56,
+                    edx: 0x4d,
+                },
+            },
+        );
+        config.cpuid.inner_mut().insert(
+            CpuidKey::leaf(0x4000_0001),
+            CpuidEntry {
+                flags: KvmCpuidFlags::EMPTY,
+                result: CpuidRegisters {
+                    eax: 0x7f,
+                    ..Default::default()
+                },
+            },
+        );
+        let without =
+            CpuConfiguration::apply_template(config.clone(), &CustomCpuTemplate::default())
+                .unwrap();
+        assert_eq!(without, config);
+
+        let template = CustomCpuTemplate {
+            hyperv: true,
+            ..Default::default()
+        };
+        let with = CpuConfiguration::apply_template(config, &template).unwrap();
+        let cpuid = with.cpuid.inner();
+        let base = &cpuid[&CpuidKey::leaf(HYPERV_CPUID_BASE)].result;
+        assert_eq!(base.eax, HYPERV_CPUID_MAX);
+        assert_eq!(base.ebx, 0x756e_694c);
+        assert_eq!(cpuid[&CpuidKey::leaf(0x4000_0001)].result.eax, 0x3123_7648);
+        let features = &cpuid[&CpuidKey::leaf(0x4000_0003)].result;
+        assert_ne!(features.eax & HV_MSR_REFERENCE_TSC_AVAILABLE, 0);
+        assert_ne!(features.eax & HV_MSR_HYPERCALL_AVAILABLE, 0);
+        for leaf_id in 0x4000_0005..=HYPERV_CPUID_MAX {
+            assert!(cpuid.contains_key(&CpuidKey::leaf(leaf_id)));
+        }
+        let kvm = &cpuid[&CpuidKey::leaf(KVM_CPUID_RELOCATED_BASE)].result;
+        assert_eq!(kvm.eax, KVM_CPUID_RELOCATED_BASE + 1);
+        assert_eq!(kvm.ebx, 0x4b4d_564b);
+        assert_eq!(cpuid[&CpuidKey::leaf(0x4000_0101)].result.eax, 0x7f);
+        assert!(!cpuid.contains_key(&CpuidKey::leaf(0x4000_000b)));
+    }
