+impl KvmVcpu {
+    /// Completes a `KVM_EXIT_HYPERV` exit.
+    ///
+    /// Firecracker enables neither the Hyper-V SynIC nor the synthetic debugger, so
+    /// the only exits KVM forwards are hypercalls it does not implement itself. They
+    /// are answered with `HV_STATUS_INVALID_HYPERCALL_CODE`, which makes the guest
+    /// fall back to its non-enlightened path; the other exit types are informational.
+    pub fn handle_hyperv_exit(&mut self) -> Result<VcpuEmulation, VcpuError> {
+        /// TLFS hypercall status: the hypercall code is not supported.
+        const HV_STATUS_INVALID_HYPERCALL_CODE: u64 = 2;
+        let run = self.fd.get_kvm_run();
+        // SAFETY: KVM filled the `hyperv` member of the exit union for KVM_EXIT_HYPERV.
+        let hyperv = unsafe { &mut run.__bindgen_anon_1.hyperv };
+        match hyperv.type_ {
+            KVM_EXIT_HYPERV_HCALL => {
+                // SAFETY: `hcall` is the active union member for a hypercall exit.
+                let hcall = unsafe { &mut hyperv.u.hcall };
+                warn!(
+                    "vcpu: unimplemented Hyper-V hypercall {:#x} answered with invalid code",
+                    hcall.input & 0xffff
+                );
+                hcall.result = HV_STATUS_INVALID_HYPERCALL_CODE;
+            }
+            KVM_EXIT_HYPERV_SYNIC => {
+                // SAFETY: `synic` is the active union member for a SynIC exit.
+                let msr = unsafe { hyperv.u.synic.msr };
+                warn!("vcpu: Hyper-V SynIC update through MSR {msr:#x} ignored");
+            }
+            KVM_EXIT_HYPERV_SYNDBG => warn!("vcpu: Hyper-V synthetic debugger exit ignored"),
+            other => warn!("vcpu: unknown Hyper-V exit type {other} ignored"),
+        }
+        Ok(VcpuEmulation::Handled)
+    }
+
+}
