+    #[test]
+    fn test_indirect_chain_refusals() {
+        // A head that chains onward, a table that is not whole descriptors, an
+        // empty table, a misaligned table and a nested indirect entry are refused;
+        // an 8-byte aligned table (viosock's) and a direct chain are accepted.
+        let cases: [(u64, u32, u16, u16); 4] = [
+            (INDIRECT_TABLE.0, 32, VIRTQ_DESC_F_INDIRECT | VIRTQ_DESC_F_NEXT, 0),
+            (INDIRECT_TABLE.0, 24, VIRTQ_DESC_F_INDIRECT, 0),
+            (INDIRECT_TABLE.0, 0, VIRTQ_DESC_F_INDIRECT, 0),
+            (INDIRECT_TABLE.0 + 4, 32, VIRTQ_DESC_F_INDIRECT, 0),
+        ];
+        for (addr, len, flags, extra) in cases {
+            create_context!(test_ctx, handler_ctx);
+            write_indirect_table(
+                &test_ctx.mem,
+                VIRTQ_DESC_F_WRITE,
+                &[(0x0040_0000, VSOCK_PKT_HDR_SIZE, extra), (0x0040_1000, 4096, 0)],
+            );
+            handler_ctx.guest_rxvq.dtable[0].set(addr, len, flags, 0);
+            let head = handler_ctx.device.queues[RXQ_INDEX].pop().unwrap().unwrap();
+            assert!(matches!(
+                VsockPacketRx::new().unwrap().parse(&test_ctx.mem, head),
+                Err(VsockError::IndirectDescriptor(_))
+            ));
+        }
+        {
+            create_context!(test_ctx, handler_ctx);
+            let bytes = write_indirect_table(
+                &test_ctx.mem,
+                VIRTQ_DESC_F_WRITE,
+                &[
+                    (0x0040_0000, VSOCK_PKT_HDR_SIZE, 0),
+                    (0x0040_1000, 4096, VIRTQ_DESC_F_INDIRECT),
+                ],
+            );
+            handler_ctx.guest_rxvq.dtable[0].set(INDIRECT_TABLE.0, bytes, VIRTQ_DESC_F_INDIRECT, 0);
+            let head = handler_ctx.device.queues[RXQ_INDEX].pop().unwrap().unwrap();
+            assert!(matches!(
+                VsockPacketRx::new().unwrap().parse(&test_ctx.mem, head),
+                Err(VsockError::IndirectDescriptor(_))
+            ));
+        }
+        {
+            // viosock's table lives at an 8-byte boundary inside its packet struct.
+            create_context!(test_ctx, handler_ctx);
+            let shifted = GuestAddress(INDIRECT_TABLE.0 + 8);
+            for (position, (addr, len)) in [(0x0040_0000u64, VSOCK_PKT_HDR_SIZE), (0x0040_1000, 4096)]
+                .into_iter()
+                .enumerate()
+            {
+                let last = position == 1;
+                let desc = Descriptor {
+                    addr,
+                    len,
+                    flags: VIRTQ_DESC_F_WRITE | if last { 0 } else { VIRTQ_DESC_F_NEXT },
+                    next: if last { 0 } else { 1 },
+                };
+                test_ctx
+                    .mem
+                    .write_obj(desc, GuestAddress(shifted.0 + (position * 16) as u64))
+                    .unwrap();
+            }
+            handler_ctx.guest_rxvq.dtable[0].set(shifted.0, 32, VIRTQ_DESC_F_INDIRECT, 0);
+            let head = handler_ctx.device.queues[RXQ_INDEX].pop().unwrap().unwrap();
+            let mut pkt = VsockPacketRx::new().unwrap();
+            pkt.parse(&test_ctx.mem, head).unwrap();
+            assert_eq!(pkt.buf_size(), 4096);
+        }
+        {
+            create_context!(test_ctx, handler_ctx);
+            let head = handler_ctx.device.queues[RXQ_INDEX].pop().unwrap().unwrap();
+            let resolved = head.resolve_indirect(&test_ctx.mem).unwrap();
+            assert_eq!(resolved.index, head.index);
+            assert_eq!(resolved.addr, head.addr);
+            assert_eq!(resolved.len, head.len);
+        }
+    }
