+    /// If the driver placed this chain's descriptors in an indirect table
+    /// (`VIRTQ_DESC_F_INDIRECT`). The virtio-win drivers do so for every
+    /// multi-descriptor buffer whenever they hold a table, whether or not the
+    /// feature was negotiated.
+    pub fn is_indirect(&self) -> bool {
+        self.flags & VIRTQ_DESC_F_INDIRECT != 0
+    }
+
+    /// Follows an indirect head into its table. The returned chain starts at the
+    /// table's first entry and walks the table, but keeps the head's ring `index`,
+    /// which is what `add_used` needs. A head that is not indirect is returned
+    /// unchanged. A head that also chains onward, a table that is empty, not a
+    /// whole number of descriptors, misaligned for a descriptor (viosock keeps
+    /// its tables 8-byte aligned inside its packet structures, so only the
+    /// descriptor's own alignment is required) or larger than the queue, and a
+    /// table entry that is itself indirect are refused.
+    pub fn resolve_indirect<M: GuestMemory>(self, mem: &M) -> Result<Self, QueueError> {
+        if !self.is_indirect() {
+            return Ok(self);
+        }
+        let entry = std::mem::size_of::<Descriptor>();
+        let len = u64_to_usize(u64::from(self.len));
+        let invalid = || QueueError::InvalidIndirectTable(self.addr.0, self.len);
+        if self.flags & VIRTQ_DESC_F_NEXT != 0
+            || len == 0
+            || len % entry != 0
+            || len / entry > usize::from(self.queue_size)
+            || self.addr.0 % std::mem::align_of::<Descriptor>() as u64 != 0
+        {
+            return Err(invalid());
+        }
+        let table = mem
+            .get_slice(self.addr, len)
+            .map_err(QueueError::MemoryError)?;
+        let table_ptr = table.ptr_guard_mut().as_ptr().cast::<Descriptor>();
+        let count = u16::try_from(len / entry).map_err(|_| invalid())?;
+        let mut chain = DescriptorChain::checked_new(table_ptr, count, 0).ok_or_else(invalid)?;
+        chain.index = self.index;
+        if chain.into_iter().any(|desc| desc.is_indirect()) {
+            return Err(invalid());
+        }
+        Ok(chain)
+    }
