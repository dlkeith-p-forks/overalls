+    // Overalls: the virtio-win viosock driver posts its header and data buffer
+    // through an indirect table whether or not the feature was negotiated.
+    const INDIRECT_TABLE: GuestAddress = GuestAddress(0x0050_0000);
+
+    fn write_indirect_table(mem: &GuestMemoryMmap, flags: u16, entries: &[(u64, u32, u16)]) -> u32 {
+        for (position, (addr, len, extra)) in entries.iter().enumerate() {
+            let last = position + 1 == entries.len();
+            let desc = Descriptor {
+                addr: *addr,
+                len: *len,
+                flags: flags | extra | if last { 0 } else { VIRTQ_DESC_F_NEXT },
+                next: if last { 0 } else { (position + 1) as u16 },
+            };
+            mem.write_obj(desc, GuestAddress(INDIRECT_TABLE.0 + (position * 16) as u64))
+                .unwrap();
+        }
+        (entries.len() * 16) as u32
+    }
+
+    #[test]
+    fn test_rx_packet_indirect_chain() {
+        create_context!(test_ctx, handler_ctx);
+        let bytes = write_indirect_table(
+            &test_ctx.mem,
+            VIRTQ_DESC_F_WRITE,
+            &[(0x0040_0000, VSOCK_PKT_HDR_SIZE, 0), (0x0040_1000, 4096, 0)],
+        );
+        handler_ctx.guest_rxvq.dtable[0].set(INDIRECT_TABLE.0, bytes, VIRTQ_DESC_F_INDIRECT, 0);
+        let head = handler_ctx.device.queues[RXQ_INDEX].pop().unwrap().unwrap();
+        assert_eq!(head.index, 0);
+        let mut pkt = VsockPacketRx::new().unwrap();
+        pkt.parse(&test_ctx.mem, head).unwrap();
+        assert_eq!(pkt.buf_size(), 4096);
+        // The header written through the packet lands in the table's first buffer.
+        pkt.hdr.set_len(7);
+        pkt.commit_hdr().unwrap();
+        let written: VsockPacketHeader = test_ctx.mem.read_obj(GuestAddress(0x0040_0000)).unwrap();
+        assert_eq!(written.len(), 7);
+    }
+
