+        .map(|segment| {
+            let slice = mem.get_slice(segment.addr, segment.len as usize)?;
+            Ok(libc::iovec {
+                iov_base: slice.ptr_guard_mut().as_ptr().cast::<libc::c_void>(),
+                iov_len: segment.len as usize,
+            })
+        })
