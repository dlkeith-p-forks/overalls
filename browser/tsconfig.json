{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["common/**/*.mjs", "scripts/**/*.mjs", "types/**/*.d.ts"]
}
