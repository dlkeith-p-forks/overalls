#: lib/porsche/ssh/channel.ex:113
#, elixir-autogen, elixir-format
msgid "Porsche machine management. Type help."
msgstr "Porsche مشین کا انتظام۔ help لکھیں۔"

#: lib/porsche/ssh/channel.ex:115
#, elixir-autogen, elixir-format
msgid "Docs:"
msgstr "دستاویزات:"

msgid "Show command help."
msgstr "کمانڈ کی مدد دکھائیں۔"

msgid "Show the authenticated account."
msgstr "تصدیق شدہ اکاؤنٹ دکھائیں۔"

#: lib/porsche/ssh/command_messages.ex:9
#, elixir-autogen, elixir-format
msgid "List available images."
msgstr "دستیاب امیجز کی فہرست دکھائیں۔"

#: lib/porsche/ssh/command_messages.ex:16
#, elixir-autogen, elixir-format
msgid "List machines you can access."
msgstr "ان مشینوں کی فہرست دکھائیں جن تک آپ کی رسائی ہے۔"

#: lib/porsche/ssh/command_messages.ex:36
#, elixir-autogen, elixir-format
msgid "Inspect a machine by name or UUID."
msgstr "نام یا UUID سے مشین کا معائنہ کریں۔"

#: lib/porsche/ssh/command_messages.ex:17
#, elixir-autogen, elixir-format
msgid "Create a machine. Disk maximum: 500 GiB. --source clones a public GitHub, GitLab, Codeberg or Bitbucket repository in the guest."
msgstr "مشین بنائیں۔ ڈسک کی زیادہ سے زیادہ گنجائش: 500 GiB۔ --source گیسٹ میں عوامی GitHub، GitLab، Codeberg یا Bitbucket ریپوزٹری کلون کرتا ہے۔"

#: lib/porsche/ssh/command_messages.ex:6
#, elixir-autogen, elixir-format
msgid "Queue an independent full-disk copy of a machine."
msgstr "مشین کی پوری ڈسک کی آزاد نقل قطار میں ڈالیں۔"

#: lib/porsche/ssh/command_messages.ex:24
#, elixir-autogen, elixir-format
msgid "Move a machine to an automatically selected host."
msgstr "مشین کو خودکار طور پر منتخب میزبان پر منتقل کریں۔"

#: lib/porsche/ssh/command_messages.ex:28
#, elixir-autogen, elixir-format
msgid "Change a machine's CPU and memory; disk may only grow. A running machine stops and restarts."
msgstr "مشین کا CPU اور میموری تبدیل کریں؛ ڈسک صرف بڑھائی جا سکتی ہے۔ چلتی مشین رک کر دوبارہ شروع ہوگی۔"

msgid "Retry a failed clone or relocation request."
msgstr "ناکام کلون یا منتقلی کی درخواست دوبارہ آزمائیں۔"

#: lib/porsche/ssh/command_messages.ex:25
#, elixir-autogen, elixir-format
msgid "Cancel an unpublished clone or uncommitted relocation request."
msgstr "غیر شائع شدہ کلون یا غیر حتمی منتقلی کی درخواست منسوخ کریں۔"

msgid "Start a machine."
msgstr "مشین شروع کریں۔"

# Reviewed English fallback pending translation of suspension behavior.
msgid "Stop a machine, retaining its disk and discarding suspended memory."
msgstr "Stop a machine, retaining its disk and discarding suspended memory."

#: lib/porsche/ssh/command_messages.ex:32
#, elixir-autogen, elixir-format
msgid "Delete a machine and its disk. Refused while its owner has it pinned."
msgstr "مشین اور اس کی ڈسک حذف کریں۔ مالک نے پن کیا ہو تو انکار ہوگا۔"

# Reviewed English fallback pending translation of suspension behavior.
msgid "Pin a machine to the top of your lists. Your owner pin wakes it, prevents automatic suspension, and prevents deletion."
msgstr "Pin a machine to the top of your lists. Your owner pin wakes it, prevents automatic suspension, and prevents deletion."

#: lib/porsche/ssh/command_messages.ex:51
#, elixir-autogen, elixir-format
msgid "Remove your pin from a machine."
msgstr "مشین سے اپنا پن ہٹائیں۔"

#: lib/porsche/ssh/command_messages.ex:35
#, elixir-autogen, elixir-format
msgid "List access grants."
msgstr "رسائی کی اجازتوں کی فہرست دکھائیں۔"

#: lib/porsche/ssh/command_messages.ex:33
#, elixir-autogen, elixir-format
msgid "Grant viewer, operator or manager access."
msgstr "ناظر، آپریٹر یا منتظم کی رسائی دیں۔"

msgid "Revoke an account's shared access."
msgstr "اکاؤنٹ کی مشترکہ رسائی واپس لیں۔"

#: lib/porsche/ssh/command_messages.ex:37
#, elixir-autogen, elixir-format
msgid "List your SSH keys."
msgstr "اپنی SSH کلیدوں کی فہرست دکھائیں۔"

msgid "Revoke one of your SSH keys."
msgstr "اپنی ایک SSH کلید منسوخ کریں۔"

#: lib/porsche/ssh/command_messages.ex:10
#, elixir-autogen, elixir-format
msgid "Create or replace a named integration at https://NAME.integration.internal."
msgstr "https://NAME.integration.internal پر نام والا انضمام بنائیں یا بدلیں۔"

#: lib/porsche/ssh/command_messages.ex:14
#, elixir-autogen, elixir-format
msgid "Remove a named integration."
msgstr "نام والا انضمام ہٹائیں۔"

#: lib/porsche/ssh/command_messages.ex:13
#, elixir-autogen, elixir-format
msgid "List your integrations."
msgstr "اپنے انضمامات کی فہرست دکھائیں۔"

#: lib/porsche/ssh/command_messages.ex:15
#, elixir-autogen, elixir-format
msgid "Inspect an integration without secrets."
msgstr "راز دکھائے بغیر انضمام کا معائنہ کریں۔"

#: lib/porsche/ssh/command_messages.ex:11
#, elixir-autogen, elixir-format
msgid "Make an integration available to a machine."
msgstr "مشین کے لیے انضمام دستیاب کریں۔"

#: lib/porsche/ssh/command_messages.ex:12
#, elixir-autogen, elixir-format
msgid "Remove a machine's explicit availability."
msgstr "مشین کی صریح طور پر دی گئی دستیابی ہٹائیں۔"

#: lib/porsche/ssh/command_messages.ex:41
#, elixir-autogen, elixir-format
msgid "Create a team you own."
msgstr "اپنی ملکیت میں ٹیم بنائیں۔"

#: lib/porsche/ssh/command_messages.ex:42
#, elixir-autogen, elixir-format
msgid "List your teams and roles."
msgstr "اپنی ٹیموں اور کرداروں کی فہرست دکھائیں۔"

#: lib/porsche/ssh/command_messages.ex:45
#, elixir-autogen, elixir-format
msgid "List a team's members."
msgstr "ٹیم کے ارکان کی فہرست دکھائیں۔"

#: lib/porsche/ssh/command_messages.ex:43
#, elixir-autogen, elixir-format
msgid "Add or change an admin or member."
msgstr "منتظم یا رکن شامل کریں یا بدلیں۔"

#: lib/porsche/ssh/command_messages.ex:44
#, elixir-autogen, elixir-format
msgid "Remove an account's membership."
msgstr "اکاؤنٹ کی رکنیت ہٹائیں۔"

#: lib/porsche/ssh/command_messages.ex:49
#, elixir-autogen, elixir-format
msgid "Offer team ownership to an admin."
msgstr "منتظم کو ٹیم کی ملکیت کی پیشکش کریں۔"

#: lib/porsche/ssh/command_messages.ex:46
#, elixir-autogen, elixir-format
msgid "Accept a pending ownership offer."
msgstr "زیر التوا ملکیت کی پیشکش قبول کریں۔"

#: lib/porsche/ssh/command_messages.ex:48
#, elixir-autogen, elixir-format
msgid "Decline a pending ownership offer."
msgstr "زیر التوا ملکیت کی پیشکش مسترد کریں۔"

#: lib/porsche/ssh/command_messages.ex:47
#, elixir-autogen, elixir-format
msgid "Cancel your pending ownership offer."
msgstr "اپنی زیر التوا ملکیت کی پیشکش منسوخ کریں۔"

#: lib/porsche/ssh/command_messages.ex:27
#, elixir-autogen, elixir-format
msgid "Inspect a previously accepted request."
msgstr "پہلے قبول شدہ درخواست کا معائنہ کریں۔"

#: lib/porsche/ssh/command_messages.ex:7
#, elixir-autogen, elixir-format
msgid "Close this interactive channel."
msgstr "یہ تعاملی چینل بند کریں۔"

msgid "We don't recognize this SSH key:\n  "
msgstr "ہم اس SSH کلید کو نہیں پہچانتے:\n  "

#: lib/porsche/ssh/onboarding.ex:58
#, elixir-autogen, elixir-format
msgid "\nOpen this link, sign in, and approve the matching fingerprint:\n  "
msgstr "\nیہ لنک کھولیں، سائن ان کریں اور ملتے فنگرپرنٹ کی منظوری دیں:\n  "

msgid "\n\nKeep this SSH connection open while approving the key.\n"
msgstr "\n\nکلید کی منظوری دیتے وقت یہ SSH کنکشن کھلا رکھیں۔\n"

#: lib/porsche/ssh/onboarding.ex:75
#, elixir-autogen, elixir-format
msgid "\nOpen an interactive Porsche connection without a remote command:"
msgstr "\nریموٹ کمانڈ کے بغیر تعاملی Porsche کنکشن کھولیں:"

#: lib/porsche/ssh/onboarding.ex:112
#, elixir-autogen, elixir-format
msgid "\nOr manage your keys at:\n  "
msgstr "\nیا یہاں اپنی کلیدوں کا انتظام کریں:\n  "

#: lib/porsche/ssh/onboarding.ex:64
#, elixir-autogen, elixir-format
msgid "After approval, retry your command here.\n"
msgstr "منظوری کے بعد اپنی کمانڈ یہاں دوبارہ آزمائیں۔\n"

#: lib/porsche/ssh/onboarding.ex:61
#, elixir-autogen, elixir-format
msgid "Approval links expire after %{minutes} minutes or when this connection closes.\n"
msgstr "منظوری کے لنکس %{minutes} منٹ بعد یا یہ کنکشن بند ہونے پر ختم ہو جاتے ہیں۔\n"

#: lib/porsche/ssh/output.ex:64
#, elixir-autogen, elixir-format
msgid "Approve this SSH key in your browser, then retry the command."
msgstr "براؤزر میں اس SSH کلید کی منظوری دیں، پھر کمانڈ دوبارہ آزمائیں۔"

#: lib/porsche/ssh/onboarding.ex:120
#, elixir-autogen, elixir-format
msgid "Follow the browser approval instructions, then run the setup command\n"
msgstr "براؤزر میں منظوری کی ہدایات پر عمل کریں، پھر سیٹ اپ کمانڈ چلائیں\n"

#: lib/porsche/ssh/output.ex:58
#, elixir-autogen, elixir-format
msgid "Invalid command. Type help to see available commands."
msgstr "غلط کمانڈ۔ دستیاب کمانڈز دیکھنے کے لیے help لکھیں۔"

#: lib/porsche/ssh/onboarding.ex:77
#, elixir-autogen, elixir-format
msgid "Keep that connection open while approving your key in the browser,\n"
msgstr "براؤزر میں کلید کی منظوری دیتے وقت وہ کنکشن کھلا رکھیں،\n"

#: lib/porsche/ssh/onboarding.ex:114
#, elixir-autogen, elixir-format
msgid "Register or check your SSH key in Overalls Account settings > SSH keys.\n\n"
msgstr "Overalls اکاؤنٹ کی ترتیبات > SSH کلیدیں میں اپنی SSH کلید رجسٹر کریں یا جانچیں۔\n\n"

#: lib/porsche/ssh/onboarding.ex:110
#, elixir-autogen, elixir-format
msgid "Register or check your key by connecting to:\n  ssh "
msgstr "یہاں جڑ کر اپنی کلید رجسٹر کریں یا جانچیں:\n  ssh "

#: lib/porsche/ssh/output.ex:104
#, elixir-autogen, elixir-format
msgid "Request %{id}: submitting"
msgstr "درخواست %{id}: جمع کی جا رہی ہے"

#: lib/porsche/ssh/output.ex:107
#, elixir-autogen, elixir-format
msgid "Request %{id}: waiting for completion"
msgstr "درخواست %{id}: تکمیل کا انتظار ہے"

# Reviewed English fallback pending translation of suspension behavior.
msgid "Suspend a machine, preserving its memory and disk."
msgstr "Suspend a machine, preserving its memory and disk."

# Reviewed English fallback pending translation of suspension behavior.
msgid "Resume preserved memory, waiting for capacity or relocation."
msgstr "Resume preserved memory, waiting for capacity or relocation."

# Reviewed English fallback pending translation of suspension behavior.
msgid "Resume a suspended machine's preserved memory."
msgstr "Resume a suspended machine's preserved memory."

#: lib/porsche/ssh/output.ex:73
#, elixir-autogen, elixir-format
msgid "The command could not be completed: %{reason}"
msgstr "کمانڈ مکمل نہیں ہو سکی: %{reason}"

#: lib/porsche/ssh/output.ex:67
#, elixir-autogen, elixir-format
msgid "The requested resource could not be found."
msgstr "درخواست کردہ وسیلہ نہیں مل سکا۔"

#: lib/porsche/ssh/output.ex:61
#, elixir-autogen, elixir-format
msgid "The service is temporarily unavailable. Please try again shortly."
msgstr ""
"سروس عارضی طور پر دستیاب نہیں ہے۔ براہ کرم تھوڑی دیر بعد دوبارہ کوشش کریں۔"

#: lib/porsche/ssh/onboarding.ex:100
#, elixir-autogen, elixir-format
msgid ""
"This SSH connection could not be authorized. Check your machine access and try again.\n"
"\n"
msgstr ""
"اس SSH کنکشن کو مجاز نہیں کیا جا سکا۔ اپنی مشین تک رسائی جانچیں اور دوبارہ کوشش کریں۔\n"
"\n"

#: lib/porsche/ssh/output.ex:52
#, elixir-autogen, elixir-format
msgid "This connection is not authorized. Please sign in and try again."
msgstr "یہ کنکشن مجاز نہیں ہے۔ براہ کرم سائن ان کر کے دوبارہ کوشش کریں۔"

#: lib/porsche/ssh/output.ex:70
#, elixir-autogen, elixir-format
msgid "Unexpected input. Please open a new SSH connection."
msgstr "غیر متوقع ان پٹ۔ براہ کرم نیا SSH کنکشن کھولیں۔"

#: lib/porsche/ssh/onboarding.ex:97
#, elixir-autogen, elixir-format
msgid ""
"We couldn't verify this SSH key right now. Please try again shortly.\n"
"\n"
msgstr ""
"ہم ابھی اس SSH کلید کی تصدیق نہیں کر سکے۔ براہ کرم تھوڑی دیر بعد دوبارہ کوشش کریں۔\n"
"\n"

#: lib/porsche/ssh/onboarding.ex:86
#, elixir-autogen, elixir-format
msgid ""
"Welcome to Overalls.\n"
"\n"
"This connection needs the Overalls SSH configuration.\n"
"\n"
msgstr ""
"Overalls میں خوش آمدید۔\n"
"\n"
"اس کنکشن کے لیے Overalls SSH ترتیب درکار ہے۔\n"
"\n"

#: lib/porsche/ssh/output.ex:55
#, elixir-autogen, elixir-format
msgid "You do not have permission to perform this action."
msgstr "آپ کو یہ کارروائی کرنے کی اجازت نہیں ہے۔"

#: lib/porsche/ssh/onboarding.ex:121
#, elixir-autogen, elixir-format
msgid "from your machine's page and reconnect without root@.\n"
msgstr "اپنی مشین کے صفحے سے اور root@ کے بغیر دوبارہ جڑیں۔\n"

#: lib/porsche/ssh/onboarding.ex:78
#, elixir-autogen, elixir-format
msgid "then retry your original command.\n"
msgstr "پھر اپنی اصل کمانڈ دوبارہ آزمائیں۔\n"

#: lib/porsche/ssh/output.ex:94
#, elixir-autogen, elixir-format
msgid "A clone request is already in progress for this machine."
msgstr "اس مشین کی کلون درخواست پہلے ہی جاری ہے۔"

#: lib/porsche/ssh/output.ex:76
#, elixir-autogen, elixir-format
msgid ""
"A failed machine cannot be pinned; an existing pin can still be removed."
msgstr "ناکام مشین کو پن نہیں کیا جا سکتا؛ موجودہ پن ہٹایا جا سکتا ہے۔"

#: lib/porsche/ssh/output.ex:121
#, elixir-autogen, elixir-format
msgid "A relocation is already in progress for this machine."
msgstr "اس مشین کی جگہ کی تبدیلی پہلے ہی جاری ہے۔"

#: lib/porsche/ssh/output.ex:202
#, elixir-autogen, elixir-format
msgid "A repository source is not allowed for this machine profile."
msgstr "اس مشین پروفائل میں ریپازٹری ماخذ کی اجازت نہیں ہے۔"

#: lib/porsche/ssh/output.ex:118
#, elixir-autogen, elixir-format
msgid "A resize request is already in progress for this machine."
msgstr "اس مشین کا حجم بدلنے کی درخواست پہلے ہی جاری ہے۔"

#: lib/porsche/ssh/output.ex:110
#, elixir-autogen, elixir-format
msgid ""
"A transfer is already using this host's transfer slot. Please try again "
"after it finishes."
msgstr ""
"اس میزبان کی منتقلی کی جگہ پہلے ہی ایک منتقلی کے استعمال میں ہے۔ اس کے مکمل "
"ہونے پر دوبارہ کوشش کریں۔"

#: lib/porsche/ssh/output.ex:270
#, elixir-autogen, elixir-format
msgid "Accepted"
msgstr "قبول شدہ"

#: lib/porsche/ssh/output.ex:272
#, elixir-autogen, elixir-format
msgid "Failed"
msgstr "ناکام"

#: lib/porsche/ssh/output.ex:265
#, elixir-autogen, elixir-format
msgid "Operation ID"
msgstr "کارروائی ID"

#: lib/porsche/ssh/output.ex:262
#, elixir-autogen, elixir-format
msgid "Protocol version"
msgstr "پروٹوکول ورژن"

#: lib/porsche/ssh/output.ex:264
#, elixir-autogen, elixir-format
msgid "Request ID"
msgstr "درخواست ID"

#: lib/porsche/ssh/output.ex:266
#, elixir-autogen, elixir-format
msgid "Result"
msgstr "نتیجہ"

#: lib/porsche/ssh/output.ex:115
#, elixir-autogen, elixir-format
msgid "Source cleanup is still pending. Wait for cleanup before retrying."
msgstr ""
"ماخذ کی صفائی ابھی باقی ہے۔ دوبارہ کوشش سے پہلے صفائی مکمل ہونے کا انتظار "
"کریں۔"

#: lib/porsche/ssh/output.ex:263
#, elixir-autogen, elixir-format
msgid "Status"
msgstr "حالت"

#: lib/porsche/ssh/output.ex:271
#, elixir-autogen, elixir-format
msgid "Succeeded"
msgstr "کامیاب"

#: lib/porsche/ssh/output.ex:273
#, elixir-autogen, elixir-format
msgid "Superseded"
msgstr "متبادل سے تبدیل شدہ"

#: lib/porsche/ssh/output.ex:242
#, elixir-autogen, elixir-format
msgid "The SSH public key is invalid. Check the key and try again."
msgstr "SSH عوامی کلید غلط ہے۔ کلید دیکھ کر دوبارہ کوشش کریں۔"

#: lib/porsche/ssh/output.ex:237
#, elixir-autogen, elixir-format
msgid ""
"The approval request limit has been reached. Close an unused connection and "
"try again."
msgstr ""
"منظوری کی درخواستوں کی حد پوری ہو گئی ہے۔ کوئی غیر استعمال شدہ کنکشن بند کر "
"کے دوبارہ کوشش کریں۔"

#: lib/porsche/ssh/output.ex:184
#, elixir-autogen, elixir-format
msgid "The available host does not meet the machine image's requirements."
msgstr "دستیاب میزبان مشین امیج کی ضروریات پوری نہیں کرتا۔"

#: lib/porsche/ssh/output.ex:160
#, elixir-autogen, elixir-format
msgid ""
"The connection to the control service was interrupted. Check the request "
"status before submitting it again."
msgstr ""
"کنٹرول سروس سے کنکشن میں خلل پڑا ہے۔ دوبارہ بھیجنے سے پہلے درخواست کی حالت "
"دیکھیں۔"

#: lib/porsche/ssh/output.ex:170
#, elixir-autogen, elixir-format
msgid ""
"The control service refused the request. Check the request status before "
"submitting it again."
msgstr ""
"کنٹرول سروس نے درخواست مسترد کر دی ہے۔ دوبارہ بھیجنے سے پہلے درخواست کی حالت"
" دیکھیں۔"

#: lib/porsche/ssh/output.ex:165
#, elixir-autogen, elixir-format
msgid ""
"The control service returned an invalid response. Check the request status "
"before submitting it again."
msgstr ""
"کنٹرول سروس نے غلط جواب دیا ہے۔ دوبارہ بھیجنے سے پہلے درخواست کی حالت "
"دیکھیں۔"

#: lib/porsche/ssh/output.ex:190
#, elixir-autogen, elixir-format
msgid "The machine's disk is not reserved for this operation."
msgstr "اس کارروائی کے لیے مشین کی ڈسک مختص نہیں ہے۔"

#: lib/porsche/ssh/output.ex:220
#, elixir-autogen, elixir-format
msgid ""
"The machine's execution generation has changed. Inspect its current state "
"before retrying."
msgstr ""
"مشین کی عمل درآمد کی جنریشن بدل گئی ہے۔ دوبارہ کوشش سے پہلے موجودہ حالت "
"دیکھیں۔"

#: lib/porsche/ssh/output.ex:85
#, elixir-autogen, elixir-format
msgid "The machine's host is unavailable. Please try again shortly."
msgstr "مشین کا میزبان دستیاب نہیں ہے۔ کچھ دیر بعد دوبارہ کوشش کریں۔"

#: lib/porsche/ssh/output.ex:133
#, elixir-autogen, elixir-format
msgid ""
"The machine's placement has changed. Inspect its current state before "
"retrying."
msgstr "مشین کی تعیناتی بدل گئی ہے۔ دوبارہ کوشش سے پہلے موجودہ حالت دیکھیں۔"

#: lib/porsche/ssh/output.ex:217
#, elixir-autogen, elixir-format
msgid ""
"The machine's stop has not been confirmed. Inspect its state before "
"retrying."
msgstr ""
"مشین کے رکنے کی تصدیق نہیں ہوئی ہے۔ دوبارہ کوشش سے پہلے اس کی حالت دیکھیں۔"

#: lib/porsche/ssh/output.ex:102
#, elixir-autogen, elixir-format
msgid ""
"The machine's workload is not stable enough for this operation. Check its "
"state before retrying."
msgstr ""
"اس کارروائی کے لیے مشین کا کام کا بوجھ کافی مستحکم نہیں ہے۔ دوبارہ کوشش سے "
"پہلے اس کی حالت دیکھیں۔"

#: lib/porsche/ssh/output.ex:73
#, elixir-autogen, elixir-format
msgid "The owner has this machine pinned; unpin it first: unpin MACHINE"
msgstr "مالک نے اس مشین کو پن کیا ہے؛ پہلے پن ہٹائیں: unpin MACHINE"

#: lib/porsche/ssh/output.ex:199
#, elixir-autogen, elixir-format
msgid "The recipient does not have a registered account."
msgstr "وصول کنندہ کا رجسٹرڈ اکاؤنٹ نہیں ہے۔"

#: lib/porsche/ssh/output.ex:208
#, elixir-autogen, elixir-format
msgid ""
"The repository source is invalid. Use a supported public repository URL."
msgstr "ریپازٹری ماخذ غلط ہے۔ معاونت یافتہ عوامی ریپازٹری URL استعمال کریں۔"

#: lib/porsche/ssh/output.ex:205
#, elixir-autogen, elixir-format
msgid "The repository source is unavailable."
msgstr "ریپازٹری ماخذ دستیاب نہیں ہے۔"

#: lib/porsche/ssh/output.ex:142
#, elixir-autogen, elixir-format
msgid ""
"The request conflicts with the current state. Inspect the machine or request"
" before retrying."
msgstr ""
"درخواست موجودہ حالت سے متصادم ہے۔ دوبارہ کوشش سے پہلے مشین یا درخواست "
"دیکھیں۔"

#: lib/porsche/ssh/output.ex:139
#, elixir-autogen, elixir-format
msgid "The request is invalid. Check the command and its arguments."
msgstr "درخواست غلط ہے۔ کمانڈ اور اس کے آرگومنٹس دیکھیں۔"

#: lib/porsche/ssh/output.ex:147
#, elixir-autogen, elixir-format
msgid "The request or response exceeds the permitted size."
msgstr "درخواست یا جواب مجاز حجم سے بڑا ہے۔"

#: lib/porsche/ssh/output.ex:228
#, elixir-autogen, elixir-format
msgid "The requested SSH key could not be found."
msgstr "مطلوبہ SSH کلید نہیں ملی۔"

#: lib/porsche/ssh/output.ex:225
#, elixir-autogen, elixir-format
msgid "The requested command receipt could not be found."
msgstr "مطلوبہ کمانڈ کی رسید نہیں ملی۔"

#: lib/porsche/ssh/output.ex:181
#, elixir-autogen, elixir-format
msgid "The requested machine image is unavailable."
msgstr "مطلوبہ مشین امیج دستیاب نہیں ہے۔"

#: lib/porsche/ssh/output.ex:187
#, elixir-autogen, elixir-format
msgid ""
"The requested machine size is invalid. Check the CPU, memory and disk "
"limits."
msgstr "مطلوبہ مشین کا حجم غلط ہے۔ CPU، میموری اور ڈسک کی حدود دیکھیں۔"

#: lib/porsche/ssh/output.ex:175
#, elixir-autogen, elixir-format
msgid "The service configuration is invalid. Contact your operator."
msgstr "سروس کی ترتیب غلط ہے۔ اپنے آپریٹر سے رابطہ کریں۔"

#: lib/porsche/ssh/output.ex:155
#, elixir-autogen, elixir-format
msgid ""
"The service does not support this protocol version. Ask your operator to "
"update the compatible services."
msgstr ""
"سروس اس پروٹوکول ورژن کی معاونت نہیں کرتی۔ اپنے آپریٹر سے ہم آہنگ سروسز کی "
"تازہ کاری کو کہیں۔"

#: lib/porsche/ssh/output.ex:234
#, elixir-autogen, elixir-format
msgid ""
"The session limit has been reached. Close an unused connection and try "
"again."
msgstr ""
"نشستوں کی حد پوری ہو گئی ہے۔ کوئی غیر استعمال شدہ کنکشن بند کر کے دوبارہ "
"کوشش کریں۔"

#: lib/porsche/ssh/output.ex:107
#, elixir-autogen, elixir-format
msgid "The source machine is unavailable for this operation."
msgstr "اس کارروائی کے لیے ماخذ مشین دستیاب نہیں ہے۔"

#: lib/porsche/ssh/output.ex:82
#, elixir-autogen, elixir-format
msgid "There is not enough available capacity for this request."
msgstr "اس درخواست کے لیے کافی دستیاب گنجائش نہیں ہے۔"

#: lib/porsche/ssh/output.ex:196
#, elixir-autogen, elixir-format
msgid "This action cannot remove the owner's protected access."
msgstr "یہ کارروائی مالک کی محفوظ رسائی نہیں ہٹا سکتی۔"

#: lib/porsche/ssh/output.ex:88
#, elixir-autogen, elixir-format
msgid ""
"This clone has already been published and cannot be retried or cancelled."
msgstr ""
"یہ کلون پہلے ہی شائع ہو چکا ہے؛ اسے دوبارہ آزمایا یا منسوخ نہیں کیا جا سکتا۔"

#: lib/porsche/ssh/output.ex:91
#, elixir-autogen, elixir-format
msgid "This clone request cannot be retried in its current state."
msgstr "موجودہ حالت میں اس کلون کی درخواست دوبارہ نہیں آزمائی جا سکتی۔"

#: lib/porsche/ssh/output.ex:231
#, elixir-autogen, elixir-format
msgid "This connection requires verified HTTPS. Contact your operator."
msgstr "اس کنکشن کے لیے تصدیق شدہ HTTPS ضروری ہے۔ اپنے آپریٹر سے رابطہ کریں۔"

#: lib/porsche/ssh/output.ex:178
#, elixir-autogen, elixir-format
msgid "This machine has been deleted."
msgstr "یہ مشین حذف کر دی گئی ہے۔"

#: lib/porsche/ssh/output.ex:193
#, elixir-autogen, elixir-format
msgid ""
"This machine has reached its execution generation limit. Contact your "
"operator."
msgstr ""
"یہ مشین عمل درآمد کی جنریشن کی حد تک پہنچ گئی ہے۔ اپنے آپریٹر سے رابطہ کریں۔"

#: lib/porsche/ssh/output.ex:136
#, elixir-autogen, elixir-format
msgid "This machine name is unavailable. Choose another name."
msgstr "مشین کا یہ نام دستیاب نہیں ہے۔ دوسرا نام منتخب کریں۔"

#: lib/porsche/ssh/output.ex:130
#, elixir-autogen, elixir-format
msgid "This relocation cannot be retried in its current state."
msgstr "موجودہ حالت میں یہ جگہ کی تبدیلی دوبارہ نہیں آزمائی جا سکتی۔"

#: lib/porsche/ssh/output.ex:127
#, elixir-autogen, elixir-format
msgid "This relocation has already finished."
msgstr "یہ جگہ کی تبدیلی پہلے ہی مکمل ہو چکی ہے۔"

#: lib/porsche/ssh/output.ex:124
#, elixir-autogen, elixir-format
msgid ""
"This relocation has committed its handoff and can no longer be cancelled."
msgstr ""
"اس جگہ کی تبدیلی کی حوالگی حتمی ہو چکی ہے؛ اب اسے منسوخ نہیں کیا جا سکتا۔"

#: lib/porsche/ssh/output.ex:97
#, elixir-autogen, elixir-format
msgid ""
"This request ID was already used for a different command. Use the original "
"command or a new request ID."
msgstr ""
"یہ درخواست ID کسی اور کمانڈ کے لیے استعمال ہو چکی ہے۔ اصل کمانڈ یا نئی "
"درخواست ID استعمال کریں۔"

#: lib/porsche/ssh/output.ex:214
#, elixir-autogen, elixir-format
msgid "This resize request cannot be cancelled in its current state."
msgstr "موجودہ حالت میں حجم کی تبدیلی کی یہ درخواست منسوخ نہیں کی جا سکتی۔"

#: lib/porsche/ssh/output.ex:211
#, elixir-autogen, elixir-format
msgid "This resize request cannot be retried in its current state."
msgstr ""
"موجودہ حالت میں حجم کی تبدیلی کی یہ درخواست دوبارہ نہیں آزمائی جا سکتی۔"

#: lib/porsche/ssh/output.ex:150
#, elixir-autogen, elixir-format
msgid ""
"Too many sessions or approval requests are active. Close an unused "
"connection and try again."
msgstr ""
"بہت زیادہ نشستیں یا منظوری کی درخواستیں فعال ہیں۔ کوئی غیر استعمال شدہ کنکشن"
" بند کر کے دوبارہ کوشش کریں۔"

#: lib/porsche/ssh/output.ex:79
#, elixir-autogen, elixir-format
msgid "You already hold the maximum number of pins; unpin one first."
msgstr "آپ کے پن کی زیادہ سے زیادہ حد پوری ہو گئی ہے؛ پہلے ایک پن ہٹائیں۔"
