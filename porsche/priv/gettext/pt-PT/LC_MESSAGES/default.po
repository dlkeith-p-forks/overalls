#, elixir-autogen, elixir-format
msgid "Resume a suspended machine's preserved memory."
msgstr "Resume a suspended machine's preserved memory."

# Reviewed English fallback pending translation of suspension behavior.
#: lib/porsche/ssh/command_messages.ex:54
#, elixir-autogen, elixir-format
msgid "Resume preserved memory, waiting for capacity or relocation."
msgstr "Resume preserved memory, waiting for capacity or relocation."

# Reviewed English fallback pending translation of suspension behavior.
#: lib/porsche/ssh/command_messages.ex:21
#, elixir-autogen, elixir-format
msgid "Stop a machine, retaining its disk and discarding suspended memory."
msgstr "Stop a machine, retaining its disk and discarding suspended memory."

# Reviewed English fallback pending translation of suspension behavior.
#: lib/porsche/ssh/command_messages.ex:53
#, elixir-autogen, elixir-format
msgid "Suspend a machine, preserving its memory and disk."
msgstr "Suspend a machine, preserving its memory and disk."

#: lib/porsche/ssh/output.ex:94
#, elixir-autogen, elixir-format
msgid "A clone request is already in progress for this machine."
msgstr "Já está em curso um pedido de clonagem para esta máquina."

#: lib/porsche/ssh/output.ex:76
#, elixir-autogen, elixir-format
msgid "A failed machine cannot be pinned; an existing pin can still be removed."
msgstr "Uma máquina com falha não pode ser fixada; uma fixação existente pode ainda ser removida."

#: lib/porsche/ssh/output.ex:121
#, elixir-autogen, elixir-format
msgid "A relocation is already in progress for this machine."
msgstr "Já está em curso uma realocação para esta máquina."

#: lib/porsche/ssh/output.ex:202
#, elixir-autogen, elixir-format
msgid "A repository source is not allowed for this machine profile."
msgstr "Uma origem de repositório não é permitida para este perfil de máquina."

#: lib/porsche/ssh/output.ex:118
#, elixir-autogen, elixir-format
msgid "A resize request is already in progress for this machine."
msgstr "Já está em curso um pedido de redimensionamento para esta máquina."

#: lib/porsche/ssh/output.ex:110
#, elixir-autogen, elixir-format
msgid "A transfer is already using this host's transfer slot. Please try again after it finishes."
msgstr "Uma transferência já está a utilizar a vaga de transferência deste anfitrião. Tente novamente quando terminar."

#: lib/porsche/ssh/output.ex:322
#, elixir-autogen, elixir-format
msgid "Accepted"
msgstr "Aceite"

#: lib/porsche/ssh/output.ex:324
#, elixir-autogen, elixir-format
msgid "Failed"
msgstr "Falhou"

#: lib/porsche/ssh/output.ex:317
#, elixir-autogen, elixir-format
msgid "Operation ID"
msgstr "ID da operação"

#: lib/porsche/ssh/output.ex:314
#, elixir-autogen, elixir-format
msgid "Protocol version"
msgstr "Versão do protocolo"

#: lib/porsche/ssh/output.ex:316
#, elixir-autogen, elixir-format
msgid "Request ID"
msgstr "ID do pedido"

#: lib/porsche/ssh/output.ex:318
#, elixir-autogen, elixir-format
msgid "Result"
msgstr "Resultado"

#: lib/porsche/ssh/output.ex:115
#, elixir-autogen, elixir-format
msgid "Source cleanup is still pending. Wait for cleanup before retrying."
msgstr "A limpeza da origem ainda está pendente. Aguarde a limpeza antes de tentar novamente."

#: lib/porsche/ssh/output.ex:315
#, elixir-autogen, elixir-format
msgid "Status"
msgstr "Estado"

#: lib/porsche/ssh/output.ex:323
#, elixir-autogen, elixir-format
msgid "Succeeded"
msgstr "Concluído com êxito"

#: lib/porsche/ssh/output.ex:325
#, elixir-autogen, elixir-format
msgid "Superseded"
msgstr "Substituído"

#: lib/porsche/ssh/output.ex:242
#, elixir-autogen, elixir-format
msgid "The SSH public key is invalid. Check the key and try again."
msgstr "A chave pública SSH é inválida. Verifique a chave e tente novamente."

#: lib/porsche/ssh/output.ex:237
#, elixir-autogen, elixir-format
msgid "The approval request limit has been reached. Close an unused connection and try again."
msgstr "O limite de pedidos de aprovação foi atingido. Feche uma ligação não utilizada e tente novamente."

#: lib/porsche/ssh/output.ex:184
#, elixir-autogen, elixir-format
msgid "The available host does not meet the machine image's requirements."
msgstr "O anfitrião disponível não cumpre os requisitos da imagem da máquina."

#: lib/porsche/ssh/output.ex:160
#, elixir-autogen, elixir-format
msgid "The connection to the control service was interrupted. Check the request status before submitting it again."
msgstr "A ligação ao serviço de controlo foi interrompida. Verifique o estado do pedido antes de o enviar novamente."

#: lib/porsche/ssh/output.ex:170
#, elixir-autogen, elixir-format
msgid "The control service refused the request. Check the request status before submitting it again."
msgstr "O serviço de controlo recusou o pedido. Verifique o estado do pedido antes de o enviar novamente."

#: lib/porsche/ssh/output.ex:165
#, elixir-autogen, elixir-format
msgid "The control service returned an invalid response. Check the request status before submitting it again."
msgstr "O serviço de controlo devolveu uma resposta inválida. Verifique o estado do pedido antes de o enviar novamente."

#: lib/porsche/ssh/output.ex:190
#, elixir-autogen, elixir-format
msgid "The machine's disk is not reserved for this operation."
msgstr "O disco da máquina não está reservado para esta operação."

#: lib/porsche/ssh/output.ex:220
#, elixir-autogen, elixir-format
msgid "The machine's execution generation has changed. Inspect its current state before retrying."
msgstr "A geração de execução da máquina mudou. Inspecione o estado atual antes de tentar novamente."

#: lib/porsche/ssh/output.ex:85
#, elixir-autogen, elixir-format
msgid "The machine's host is unavailable. Please try again shortly."
msgstr "O anfitrião da máquina está indisponível. Tente novamente dentro de instantes."

#: lib/porsche/ssh/output.ex:133
#, elixir-autogen, elixir-format
msgid "The machine's placement has changed. Inspect its current state before retrying."
msgstr "A localização da máquina mudou. Inspecione o estado atual antes de tentar novamente."

#: lib/porsche/ssh/output.ex:217
#, elixir-autogen, elixir-format
msgid "The machine's stop has not been confirmed. Inspect its state before retrying."
msgstr "A paragem da máquina não foi confirmada. Inspecione o estado da máquina antes de tentar novamente."

#: lib/porsche/ssh/output.ex:102
#, elixir-autogen, elixir-format
msgid "The machine's workload is not stable enough for this operation. Check its state before retrying."
msgstr "A carga de trabalho da máquina não está suficientemente estável para esta operação. Verifique o estado da máquina antes de tentar novamente."

#: lib/porsche/ssh/output.ex:73
#, elixir-autogen, elixir-format
msgid "The owner has this machine pinned; unpin it first: unpin MACHINE"
msgstr "O proprietário mantém esta máquina fixada; remova primeiro a fixação: unpin MACHINE"

#: lib/porsche/ssh/output.ex:199
#, elixir-autogen, elixir-format
msgid "The recipient does not have a registered account."
msgstr "O destinatário não tem uma conta registada."

#: lib/porsche/ssh/output.ex:208
#, elixir-autogen, elixir-format
msgid "The repository source is invalid. Use a supported public repository URL."
msgstr "A origem do repositório é inválida. Utilize um URL de repositório público compatível."

#: lib/porsche/ssh/output.ex:205
#, elixir-autogen, elixir-format
msgid "The repository source is unavailable."
msgstr "A origem do repositório está indisponível."

#: lib/porsche/ssh/output.ex:142
#, elixir-autogen, elixir-format
msgid "The request conflicts with the current state. Inspect the machine or request before retrying."
msgstr "O pedido entra em conflito com o estado atual. Inspecione a máquina ou o pedido antes de tentar novamente."

#: lib/porsche/ssh/output.ex:139
#, elixir-autogen, elixir-format
msgid "The request is invalid. Check the command and its arguments."
msgstr "O pedido é inválido. Verifique o comando e os respetivos argumentos."

#: lib/porsche/ssh/output.ex:147
#, elixir-autogen, elixir-format
msgid "The request or response exceeds the permitted size."
msgstr "O pedido ou a resposta excede o tamanho permitido."

#: lib/porsche/ssh/output.ex:228
#, elixir-autogen, elixir-format
msgid "The requested SSH key could not be found."
msgstr "Não foi possível encontrar a chave SSH solicitada."

#: lib/porsche/ssh/output.ex:225
#, elixir-autogen, elixir-format
msgid "The requested command receipt could not be found."
msgstr "Não foi possível encontrar o comprovativo do comando solicitado."

#: lib/porsche/ssh/output.ex:181
#, elixir-autogen, elixir-format
msgid "The requested machine image is unavailable."
msgstr "A imagem de máquina solicitada está indisponível."

#: lib/porsche/ssh/output.ex:187
#, elixir-autogen, elixir-format
msgid "The requested machine size is invalid. Check the CPU, memory and disk limits."
msgstr "O tamanho de máquina solicitado é inválido. Verifique os limites de CPU, memória e disco."

#: lib/porsche/ssh/output.ex:175
#, elixir-autogen, elixir-format
msgid "The service configuration is invalid. Contact your operator."
msgstr "A configuração do serviço é inválida. Contacte o seu operador."

#: lib/porsche/ssh/output.ex:155
#, elixir-autogen, elixir-format
msgid "The service does not support this protocol version. Ask your operator to update the compatible services."
msgstr "O serviço não suporta esta versão do protocolo. Peça ao seu operador que atualize os serviços compatíveis."

#: lib/porsche/ssh/output.ex:234
#, elixir-autogen, elixir-format
msgid "The session limit has been reached. Close an unused connection and try again."
msgstr "O limite de sessões foi atingido. Feche uma ligação não utilizada e tente novamente."

#: lib/porsche/ssh/output.ex:107
#, elixir-autogen, elixir-format
msgid "The source machine is unavailable for this operation."
msgstr "A máquina de origem está indisponível para esta operação."

#: lib/porsche/ssh/output.ex:82
#, elixir-autogen, elixir-format
msgid "There is not enough available capacity for this request."
msgstr "Não existe capacidade disponível suficiente para este pedido."

#: lib/porsche/ssh/output.ex:196
#, elixir-autogen, elixir-format
msgid "This action cannot remove the owner's protected access."
msgstr "Esta ação não pode remover o acesso protegido do proprietário."

#: lib/porsche/ssh/output.ex:88
#, elixir-autogen, elixir-format
msgid "This clone has already been published and cannot be retried or cancelled."
msgstr "Este clone já foi publicado e não pode ser repetido nem cancelado."

#: lib/porsche/ssh/output.ex:91
#, elixir-autogen, elixir-format
msgid "This clone request cannot be retried in its current state."
msgstr "Este pedido de clonagem não pode ser repetido no estado atual."

#: lib/porsche/ssh/output.ex:231
#, elixir-autogen, elixir-format
msgid "This connection requires verified HTTPS. Contact your operator."
msgstr "Esta ligação exige HTTPS verificado. Contacte o seu operador."

#: lib/porsche/ssh/output.ex:178
#, elixir-autogen, elixir-format
msgid "This machine has been deleted."
msgstr "Esta máquina foi eliminada."

#: lib/porsche/ssh/output.ex:193
#, elixir-autogen, elixir-format
msgid "This machine has reached its execution generation limit. Contact your operator."
msgstr "Esta máquina atingiu o limite de gerações de execução. Contacte o seu operador."

#: lib/porsche/ssh/output.ex:136
#, elixir-autogen, elixir-format
msgid "This machine name is unavailable. Choose another name."
msgstr "Este nome de máquina está indisponível. Escolha outro nome."

#: lib/porsche/ssh/output.ex:130
#, elixir-autogen, elixir-format
msgid "This relocation cannot be retried in its current state."
msgstr "Esta realocação não pode ser repetida no estado atual."

#: lib/porsche/ssh/output.ex:127
#, elixir-autogen, elixir-format
msgid "This relocation has already finished."
msgstr "Esta realocação já terminou."

#: lib/porsche/ssh/output.ex:124
#, elixir-autogen, elixir-format
msgid "This relocation has committed its handoff and can no longer be cancelled."
msgstr "Esta realocação confirmou a transferência de controlo e já não pode ser cancelada."

#: lib/porsche/ssh/output.ex:97
#, elixir-autogen, elixir-format
msgid "This request ID was already used for a different command. Use the original command or a new request ID."
msgstr "Este ID de pedido já foi utilizado para um comando diferente. Utilize o comando original ou um novo ID de pedido."

#: lib/porsche/ssh/output.ex:214
#, elixir-autogen, elixir-format
msgid "This resize request cannot be cancelled in its current state."
msgstr "Este pedido de redimensionamento não pode ser cancelado no estado atual."

#: lib/porsche/ssh/output.ex:211
#, elixir-autogen, elixir-format
msgid "This resize request cannot be retried in its current state."
msgstr "Este pedido de redimensionamento não pode ser repetido no estado atual."

#: lib/porsche/ssh/output.ex:150
#, elixir-autogen, elixir-format
msgid "Too many sessions or approval requests are active. Close an unused connection and try again."
msgstr "Existem demasiadas sessões ou pedidos de aprovação ativos. Feche uma ligação não utilizada e tente novamente."

#: lib/porsche/ssh/output.ex:79
#, elixir-autogen, elixir-format
msgid "You already hold the maximum number of pins; unpin one first."
msgstr "Já tem o número máximo de fixações; remova uma primeiro."

#: lib/porsche/ssh/command_messages.ex:75
#, elixir-autogen, elixir-format
msgid "Register this device for push notifications. The push key is read from stdin."
msgstr "Regista este dispositivo para notificações push. A chave push é lida a partir do stdin."

#: lib/porsche/ssh/command_messages.ex:78
#, elixir-autogen, elixir-format
msgid "List your push notification devices."
msgstr "Lista os seus dispositivos de notificações push."

#: lib/porsche/ssh/command_messages.ex:79
#, elixir-autogen, elixir-format
msgid "Revoke a push notification device."
msgstr "Revoga um dispositivo de notificações push."

#: lib/porsche/ssh/command_messages.ex:80
#, elixir-autogen, elixir-format
msgid "Turn push notifications on or off for one device."
msgstr "Ativa ou desativa as notificações push de um dispositivo."

#: lib/porsche/ssh/command_messages.ex:81
#, elixir-autogen, elixir-format
msgid "Attach this SSH terminal to a shared terminal session; needs ssh -t."
msgstr "Liga este terminal SSH a uma sessão de terminal partilhada; requer ssh -t."

#: lib/porsche/ssh/output.ex:245
#, elixir-autogen, elixir-format
msgid "terminal attach needs a terminal. Connect with ssh -t and run it as the command."
msgstr "terminal attach precisa de um terminal. Ligue-se com ssh -t e execute-o como comando."

#: lib/porsche/ssh/command_messages.ex:56
#, elixir-autogen, elixir-format
msgid "List agent threads you can read, with unread counts."
msgstr "Listar os tópicos de agente que pode ler, com a contagem de não lidos."

#: lib/porsche/ssh/command_messages.ex:57
#, elixir-autogen, elixir-format
msgid "Inspect a thread, its pending question and latest plan."
msgstr "Inspecionar um tópico, a sua pergunta pendente e o plano mais recente."

#: lib/porsche/ssh/command_messages.ex:58
#, elixir-autogen, elixir-format
msgid "List a thread's transcript events after a sequence number."
msgstr "Listar os eventos da transcrição de um tópico após um número de sequência."

#: lib/porsche/ssh/command_messages.ex:59
#, elixir-autogen, elixir-format
msgid "Send a prompt read from standard input to a thread."
msgstr "Enviar para um tópico um pedido lido da entrada padrão."

#: lib/porsche/ssh/command_messages.ex:60
#, elixir-autogen, elixir-format
msgid "Answer a thread's pending question with JSON read from standard input."
msgstr "Responder à pergunta pendente de um tópico com JSON lido da entrada padrão."

#: lib/porsche/ssh/command_messages.ex:63
#, elixir-autogen, elixir-format
msgid "Approve a thread's latest plan and start implementing it."
msgstr "Aprovar o plano mais recente de um tópico e começar a implementá-lo."

#: lib/porsche/ssh/command_messages.ex:64
#, elixir-autogen, elixir-format
msgid "Ask for a revised plan, reading the feedback from standard input."
msgstr "Pedir um plano revisto, lendo o feedback da entrada padrão."

#: lib/porsche/ssh/command_messages.ex:65
#, elixir-autogen, elixir-format
msgid "Switch a thread between plan and work collaboration."
msgstr "Alternar um tópico entre a colaboração plan e work."

#: lib/porsche/ssh/command_messages.ex:66
#, elixir-autogen, elixir-format
msgid "Mark a thread read up to a transcript sequence number."
msgstr "Marcar um tópico como lido até um número de sequência da transcrição."

#: lib/porsche/ssh/command_messages.ex:67
#, elixir-autogen, elixir-format
msgid "List a machine's terminal sessions you can open."
msgstr "Listar as sessões de terminal de uma máquina que pode abrir."

#: lib/porsche/ssh/command_messages.ex:68
#, elixir-autogen, elixir-format
msgid "Open your personal terminal session on a machine."
msgstr "Abrir a sua sessão de terminal pessoal numa máquina."

#: lib/porsche/ssh/command_messages.ex:69
#, elixir-autogen, elixir-format
msgid "Close one of your terminal sessions on a machine."
msgstr "Fechar uma das suas sessões de terminal numa máquina."

#: lib/porsche/ssh/command_messages.ex:70
#, elixir-autogen, elixir-format
msgid "Show a machine's web endpoint, port and visibility."
msgstr "Mostrar o endpoint web, a porta e a visibilidade de uma máquina."

#: lib/porsche/ssh/command_messages.ex:71
#, elixir-autogen, elixir-format
msgid "Change a machine's web port or visibility, optionally at an expected revision."
msgstr "Alterar a porta web ou a visibilidade de uma máquina, opcionalmente numa revisão esperada."

#: lib/porsche/ssh/command_messages.ex:74
#, elixir-autogen, elixir-format
msgid "Stream JSON change notices for machines, threads and this session."
msgstr "Transmitir avisos de alteração em JSON para máquinas, tópicos e esta sessão."

#: lib/porsche/ssh/output.ex:250
#, elixir-autogen, elixir-format
msgid "This thread is not ready for prompts yet."
msgstr "Este tópico ainda não está pronto para pedidos."

#: lib/porsche/ssh/output.ex:253
#, elixir-autogen, elixir-format
msgid "This thread is busy with a turn. Try again when it finishes."
msgstr "Este tópico está ocupado com um turno. Tente novamente quando terminar."

#: lib/porsche/ssh/output.ex:256
#, elixir-autogen, elixir-format
msgid "That plan is no longer the latest proposal. Show the thread again."
msgstr "Esse plano já não é a proposta mais recente. Mostre o tópico novamente."

#: lib/porsche/ssh/output.ex:259
#, elixir-autogen, elixir-format
msgid "That question is no longer pending."
msgstr "Essa pergunta já não está pendente."

#: lib/porsche/ssh/output.ex:262
#, elixir-autogen, elixir-format
msgid "That question has already been answered."
msgstr "Essa pergunta já foi respondida."

#: lib/porsche/ssh/output.ex:265
#, elixir-autogen, elixir-format
msgid "The answers do not match the pending question."
msgstr "As respostas não correspondem à pergunta pendente."

#: lib/porsche/ssh/output.ex:268
#, elixir-autogen, elixir-format
msgid "Answer the pending question before sending another prompt."
msgstr "Responda à pergunta pendente antes de enviar outro pedido."

#: lib/porsche/ssh/output.ex:271
#, elixir-autogen, elixir-format
msgid "The web settings changed since you read them. Show them again and retry."
msgstr "As definições web mudaram desde que as leu. Mostre-as novamente e tente outra vez."

#: lib/porsche/ssh/output.ex:274
#, elixir-autogen, elixir-format
msgid "Port 4444 is reserved for the editor."
msgstr "A porta 4444 está reservada para o editor."

#: lib/porsche/ssh/output.ex:277
#, elixir-autogen, elixir-format
msgid "This machine's profile does not allow web publishing."
msgstr "O perfil desta máquina não permite a publicação web."

#: lib/porsche/ssh/output.ex:280
#, elixir-autogen, elixir-format
msgid "Terminals are unavailable on this machine right now."
msgstr "Os terminais não estão disponíveis nesta máquina neste momento."

#: lib/porsche/ssh/output.ex:283
#, elixir-autogen, elixir-format
msgid "The machine is waking. Retry the terminal shortly."
msgstr "A máquina está a despertar. Tente o terminal novamente dentro de instantes."

#: lib/porsche/ssh/output.ex:286
#, elixir-autogen, elixir-format
msgid "That terminal session no longer exists."
msgstr "Essa sessão de terminal já não existe."

#: lib/porsche/ssh/output.ex:289
#, elixir-autogen, elixir-format
msgid "This command reads its input from standard input. Pipe it in and end the command with -."
msgstr "Este comando lê a sua entrada da entrada padrão. Envie-a por pipe e termine o comando com -."

#: lib/porsche/ssh/output.ex:294
#, elixir-autogen, elixir-format
msgid "The standard input is empty or exceeds this command's size limit."
msgstr "A entrada padrão está vazia ou excede o limite de tamanho deste comando."
