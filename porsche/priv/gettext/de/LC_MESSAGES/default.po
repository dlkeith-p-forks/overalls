#: lib/porsche/ssh/onboarding.ex:60
#, elixir-autogen, elixir-format
msgid ""
"\n"
"\n"
"Keep this SSH connection open while approving the key.\n"
msgstr ""
"\n"
"\n"
"Lassen Sie diese SSH-Verbindung geöffnet, während Sie den Schlüssel bestätigen.\n"

#: lib/porsche/ssh/onboarding.ex:75
#, elixir-autogen, elixir-format
msgid ""
"\n"
"Open an interactive Porsche connection without a remote command:"
msgstr ""
"\n"
"Öffnen Sie eine interaktive Porsche-Verbindung ohne Remote-Befehl:"

#: lib/porsche/ssh/onboarding.ex:58
#, elixir-autogen, elixir-format
msgid ""
"\n"
"Open this link, sign in, and approve the matching fingerprint:\n"
"  "
msgstr ""
"\n"
"Öffnen Sie diesen Link, melden Sie sich an und bestätigen Sie den passenden Fingerabdruck:\n"
"  "

msgid "Show the authenticated account."
msgstr "Das authentifizierte Konto anzeigen."

msgid "List available images."
msgstr "Verfügbare Images auflisten."

msgid "List machines you can access."
msgstr "Maschinen auflisten, auf die Sie zugreifen können."

msgid "Inspect a machine by name or UUID."
msgstr "Eine Maschine anhand ihres Namens oder ihrer UUID untersuchen."

msgid "Create a machine. Disk maximum: 500 GiB. --source clones a public GitHub, GitLab, Codeberg or Bitbucket repository in the guest."
msgstr "Eine Maschine erstellen. Maximale Festplatte: 500 GiB. --source klont ein öffentliches GitHub-, GitLab-, Codeberg- oder Bitbucket-Repository in den Gast."

msgid "Queue an independent full-disk copy of a machine."
msgstr "Eine unabhängige vollständige Festplattenkopie einer Maschine einreihen."

msgid "Move a machine to an automatically selected host."
msgstr "Eine Maschine auf einen automatisch gewählten Host verschieben."

msgid "Change a machine's CPU and memory; disk may only grow. A running machine stops and restarts."
msgstr "CPU und Arbeitsspeicher einer Maschine ändern; die Festplatte kann nur vergrößert werden. Eine laufende Maschine wird angehalten und neu gestartet."

msgid "Retry a failed clone or relocation request."
msgstr "Eine fehlgeschlagene Klon- oder Verlagerungsanfrage erneut versuchen."

msgid "Cancel an unpublished clone or uncommitted relocation request."
msgstr "Eine unveröffentlichte Klonanfrage oder eine noch nicht bestätigte Verlagerungsanfrage abbrechen."

msgid "Start a machine."
msgstr "Eine Maschine starten."

# Reviewed English fallback pending translation of suspension behavior.
msgid "Stop a machine, retaining its disk and discarding suspended memory."
msgstr "Stop a machine, retaining its disk and discarding suspended memory."

msgid "Delete a machine and its disk. Refused while its owner has it pinned."
msgstr "Eine Maschine und ihre Festplatte löschen. Wird verweigert, solange der Eigentümer sie angeheftet hat."

# Reviewed English fallback pending translation of suspension behavior.
msgid "Pin a machine to the top of your lists. Your owner pin wakes it, prevents automatic suspension, and prevents deletion."
msgstr "Pin a machine to the top of your lists. Your owner pin wakes it, prevents automatic suspension, and prevents deletion."

msgid "Remove your pin from a machine."
msgstr "Ihre Anheftung einer Maschine entfernen."

msgid "List access grants."
msgstr "Zugriffsberechtigungen auflisten."

msgid "Grant viewer, operator or manager access."
msgstr "Zugriff als viewer, operator oder manager gewähren."

msgid "Revoke an account's shared access."
msgstr "Den geteilten Zugriff eines Kontos widerrufen."

msgid "List your SSH keys."
msgstr "Ihre SSH-Schlüssel auflisten."

msgid "Revoke one of your SSH keys."
msgstr "Einen Ihrer SSH-Schlüssel widerrufen."

msgid "Create or replace a named integration at https://NAME.integration.internal."
msgstr "Eine benannte Integration unter https://NAME.integration.internal erstellen oder ersetzen."

msgid "Remove a named integration."
msgstr "Eine benannte Integration entfernen."

msgid "List your integrations."
msgstr "Ihre Integrationen auflisten."

msgid "Inspect an integration without secrets."
msgstr "Eine Integration ohne Geheimnisse untersuchen."

msgid "Make an integration available to a machine."
msgstr "Eine Integration für eine Maschine verfügbar machen."

msgid "Remove a machine's explicit availability."
msgstr "Die explizite Verfügbarkeit einer Maschine entfernen."

msgid "Create a team you own."
msgstr "Ein Team erstellen, dessen Eigentümer Sie sind."

msgid "List your teams and roles."
msgstr "Ihre Teams und Rollen auflisten."

msgid "List a team's members."
msgstr "Die Mitglieder eines Teams auflisten."

msgid "Add or change an admin or member."
msgstr "Einen Administrator oder ein Mitglied hinzufügen oder ändern."

msgid "Remove an account's membership."
msgstr "Die Mitgliedschaft eines Kontos entfernen."

msgid "Offer team ownership to an admin."
msgstr "Einem Administrator die Teameigentümerschaft anbieten."

