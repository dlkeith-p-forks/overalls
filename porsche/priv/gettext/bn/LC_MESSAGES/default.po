msgstr "অনুরোধ ID"

#: lib/porsche/ssh/output.ex:266
#, elixir-autogen, elixir-format
msgid "Result"
msgstr "ফলাফল"

#: lib/porsche/ssh/output.ex:115
#, elixir-autogen, elixir-format
msgid "Source cleanup is still pending. Wait for cleanup before retrying."
msgstr ""
"উৎস পরিষ্কার করা এখনও বাকি। আবার চেষ্টা করার আগে পরিষ্কার শেষ হওয়ার অপেক্ষা"
" করুন।"

#: lib/porsche/ssh/output.ex:263
#, elixir-autogen, elixir-format
msgid "Status"
msgstr "অবস্থা"

#: lib/porsche/ssh/output.ex:271
#, elixir-autogen, elixir-format
msgid "Succeeded"
msgstr "সফল"

#: lib/porsche/ssh/output.ex:273
#, elixir-autogen, elixir-format
msgid "Superseded"
msgstr "প্রতিস্থাপিত"

#: lib/porsche/ssh/output.ex:242
#, elixir-autogen, elixir-format
msgid "The SSH public key is invalid. Check the key and try again."
msgstr "SSH পাবলিক কীটি অবৈধ। কী পরীক্ষা করে আবার চেষ্টা করুন।"

#: lib/porsche/ssh/output.ex:237
#, elixir-autogen, elixir-format
msgid ""
"The approval request limit has been reached. Close an unused connection and "
"try again."
msgstr ""
"অনুমোদন অনুরোধের সীমায় পৌঁছেছে। অব্যবহৃত একটি সংযোগ বন্ধ করে আবার চেষ্টা "
"করুন।"

#: lib/porsche/ssh/output.ex:184
#, elixir-autogen, elixir-format
msgid "The available host does not meet the machine image's requirements."
msgstr "উপলব্ধ হোস্ট মেশিন ইমেজের প্রয়োজনীয়তা পূরণ করে না।"

#: lib/porsche/ssh/output.ex:160
#, elixir-autogen, elixir-format
msgid ""
"The connection to the control service was interrupted. Check the request "
"status before submitting it again."
msgstr ""
"নিয়ন্ত্রণ পরিষেবার সঙ্গে সংযোগ বিচ্ছিন্ন হয়েছে। আবার পাঠানোর আগে অনুরোধের "
"অবস্থা পরীক্ষা করুন।"

#: lib/porsche/ssh/output.ex:170
#, elixir-autogen, elixir-format
msgid ""
"The control service refused the request. Check the request status before "
"submitting it again."
msgstr ""
"নিয়ন্ত্রণ পরিষেবা অনুরোধ প্রত্যাখ্যান করেছে। আবার পাঠানোর আগে অনুরোধের "
"অবস্থা পরীক্ষা করুন।"

#: lib/porsche/ssh/output.ex:165
#, elixir-autogen, elixir-format
msgid ""
"The control service returned an invalid response. Check the request status "
"before submitting it again."
msgstr ""
"নিয়ন্ত্রণ পরিষেবা একটি অবৈধ উত্তর দিয়েছে। আবার পাঠানোর আগে অনুরোধের অবস্থা"
" পরীক্ষা করুন।"

#: lib/porsche/ssh/output.ex:190
#, elixir-autogen, elixir-format
msgid "The machine's disk is not reserved for this operation."
msgstr "এই কাজের জন্য মেশিনের ডিস্ক সংরক্ষিত নয়।"

#: lib/porsche/ssh/output.ex:220
#, elixir-autogen, elixir-format
msgid ""
"The machine's execution generation has changed. Inspect its current state "
"before retrying."
msgstr ""
"মেশিনের নির্বাহ প্রজন্ম বদলেছে। আবার চেষ্টা করার আগে বর্তমান অবস্থা পরীক্ষা "
"করুন।"

#: lib/porsche/ssh/output.ex:85
#, elixir-autogen, elixir-format
msgid "The machine's host is unavailable. Please try again shortly."
msgstr "মেশিনের হোস্ট অনুপলব্ধ। কিছুক্ষণ পরে আবার চেষ্টা করুন।"

#: lib/porsche/ssh/output.ex:133
#, elixir-autogen, elixir-format
msgid ""
"The machine's placement has changed. Inspect its current state before "
"retrying."
msgstr ""
"মেশিনের অবস্থান বদলেছে। আবার চেষ্টা করার আগে বর্তমান অবস্থা পরীক্ষা করুন।"

#: lib/porsche/ssh/output.ex:217
#, elixir-autogen, elixir-format
msgid ""
"The machine's stop has not been confirmed. Inspect its state before "
"retrying."
msgstr "মেশিনের থামা নিশ্চিত হয়নি। আবার চেষ্টা করার আগে অবস্থা পরীক্ষা করুন।"

#: lib/porsche/ssh/output.ex:102
#, elixir-autogen, elixir-format
msgid ""
"The machine's workload is not stable enough for this operation. Check its "
"state before retrying."
msgstr ""
"এই কাজের জন্য মেশিনের ওয়ার্কলোড যথেষ্ট স্থিতিশীল নয়। আবার চেষ্টা করার আগে "
"অবস্থা পরীক্ষা করুন।"

#: lib/porsche/ssh/output.ex:73
#, elixir-autogen, elixir-format
msgid "The owner has this machine pinned; unpin it first: unpin MACHINE"
msgstr "মালিক এই মেশিনটি পিন করেছেন; আগে পিন খুলুন: unpin MACHINE"

#: lib/porsche/ssh/output.ex:199
#, elixir-autogen, elixir-format
msgid "The recipient does not have a registered account."
msgstr "প্রাপকের নিবন্ধিত অ্যাকাউন্ট নেই।"

#: lib/porsche/ssh/output.ex:208
#, elixir-autogen, elixir-format
msgid ""
"The repository source is invalid. Use a supported public repository URL."
msgstr "রিপোজিটরি উৎস অবৈধ। সমর্থিত পাবলিক রিপোজিটরির URL ব্যবহার করুন।"

#: lib/porsche/ssh/output.ex:205
#, elixir-autogen, elixir-format
msgid "The repository source is unavailable."
msgstr "রিপোজিটরি উৎস অনুপলব্ধ।"

#: lib/porsche/ssh/output.ex:142
#, elixir-autogen, elixir-format
msgid ""
"The request conflicts with the current state. Inspect the machine or request"
" before retrying."
msgstr ""
"অনুরোধটি বর্তমান অবস্থার সঙ্গে সংঘর্ষ করছে। আবার চেষ্টা করার আগে মেশিন বা "
"অনুরোধ পরীক্ষা করুন।"

#: lib/porsche/ssh/output.ex:139
#, elixir-autogen, elixir-format
msgid "The request is invalid. Check the command and its arguments."
msgstr "অনুরোধটি অবৈধ। কমান্ড এবং তার আর্গুমেন্ট পরীক্ষা করুন।"

#: lib/porsche/ssh/output.ex:147
#, elixir-autogen, elixir-format
msgid "The request or response exceeds the permitted size."
msgstr "অনুরোধ বা উত্তর অনুমোদিত আকার ছাড়িয়ে গেছে।"

#: lib/porsche/ssh/output.ex:228
#, elixir-autogen, elixir-format
msgid "The requested SSH key could not be found."
msgstr "অনুরোধ করা SSH কী পাওয়া যায়নি।"

#: lib/porsche/ssh/output.ex:225
#, elixir-autogen, elixir-format
msgid "The requested command receipt could not be found."
msgstr "অনুরোধ করা কমান্ডের রসিদ পাওয়া যায়নি।"

#: lib/porsche/ssh/output.ex:181
#, elixir-autogen, elixir-format
msgid "The requested machine image is unavailable."
msgstr "অনুরোধ করা মেশিন ইমেজটি অনুপলব্ধ।"

#: lib/porsche/ssh/output.ex:187
#, elixir-autogen, elixir-format
msgid ""
"The requested machine size is invalid. Check the CPU, memory and disk "
"limits."
msgstr ""
"অনুরোধ করা মেশিনের আকার অবৈধ। CPU, মেমরি এবং ডিস্কের সীমা পরীক্ষা করুন।"

#: lib/porsche/ssh/output.ex:175
#, elixir-autogen, elixir-format
msgid "The service configuration is invalid. Contact your operator."
msgstr "পরিষেবার কনফিগারেশন অবৈধ। আপনার অপারেটরের সঙ্গে যোগাযোগ করুন।"

#: lib/porsche/ssh/output.ex:155
#, elixir-autogen, elixir-format
msgid ""
"The service does not support this protocol version. Ask your operator to "
"update the compatible services."
msgstr ""
"পরিষেবাটি এই প্রোটোকল সংস্করণ সমর্থন করে না। উপযুক্ত পরিষেবাগুলি আপডেট করতে "
"আপনার অপারেটরকে বলুন।"

#: lib/porsche/ssh/output.ex:234
#, elixir-autogen, elixir-format
msgid ""
"The session limit has been reached. Close an unused connection and try "
"again."
msgstr "সেশনের সীমায় পৌঁছেছে। অব্যবহৃত একটি সংযোগ বন্ধ করে আবার চেষ্টা করুন।"

#: lib/porsche/ssh/output.ex:107
#, elixir-autogen, elixir-format
msgid "The source machine is unavailable for this operation."
msgstr "এই কাজের জন্য উৎস মেশিন অনুপলব্ধ।"

#: lib/porsche/ssh/output.ex:82
#, elixir-autogen, elixir-format
msgid "There is not enough available capacity for this request."
msgstr "এই অনুরোধের জন্য পর্যাপ্ত উপলব্ধ ধারণক্ষমতা নেই।"

#: lib/porsche/ssh/output.ex:196
#, elixir-autogen, elixir-format
msgid "This action cannot remove the owner's protected access."
msgstr "এই কাজটি মালিকের সুরক্ষিত প্রবেশাধিকার সরাতে পারে না।"

#: lib/porsche/ssh/output.ex:88
#, elixir-autogen, elixir-format
msgid ""
"This clone has already been published and cannot be retried or cancelled."
msgstr ""
"এই ক্লোন ইতিমধ্যে প্রকাশিত হয়েছে; এটি পুনরায় চেষ্টা বা বাতিল করা যায় না।"

#: lib/porsche/ssh/output.ex:91
#, elixir-autogen, elixir-format
msgid "This clone request cannot be retried in its current state."
msgstr "বর্তমান অবস্থায় এই ক্লোন অনুরোধটি পুনরায় চেষ্টা করা যায় না।"

#: lib/porsche/ssh/output.ex:231
#, elixir-autogen, elixir-format
msgid "This connection requires verified HTTPS. Contact your operator."
msgstr ""
"এই সংযোগে যাচাইকৃত HTTPS প্রয়োজন। আপনার অপারেটরের সঙ্গে যোগাযোগ করুন।"

#: lib/porsche/ssh/output.ex:178
#, elixir-autogen, elixir-format
msgid "This machine has been deleted."
msgstr "এই মেশিনটি মুছে ফেলা হয়েছে।"

#: lib/porsche/ssh/output.ex:193
#, elixir-autogen, elixir-format
msgid ""
"This machine has reached its execution generation limit. Contact your "
"operator."
msgstr ""
"এই মেশিন নির্বাহ প্রজন্মের সীমায় পৌঁছেছে। আপনার অপারেটরের সঙ্গে যোগাযোগ "
"করুন।"

#: lib/porsche/ssh/output.ex:136
#, elixir-autogen, elixir-format
msgid "This machine name is unavailable. Choose another name."
msgstr "এই মেশিনের নামটি উপলব্ধ নয়। অন্য নাম বেছে নিন।"

#: lib/porsche/ssh/output.ex:130
#, elixir-autogen, elixir-format
msgid "This relocation cannot be retried in its current state."
msgstr "বর্তমান অবস্থায় এই স্থানান্তর পুনরায় চেষ্টা করা যায় না।"

#: lib/porsche/ssh/output.ex:127
#, elixir-autogen, elixir-format
msgid "This relocation has already finished."
msgstr "এই স্থানান্তর ইতিমধ্যে শেষ হয়েছে।"

#: lib/porsche/ssh/output.ex:124
#, elixir-autogen, elixir-format
msgid ""
"This relocation has committed its handoff and can no longer be cancelled."
msgstr "এই স্থানান্তরের হস্তান্তর কমিট হয়েছে; এটি আর বাতিল করা যাবে না।"

#: lib/porsche/ssh/output.ex:97
#, elixir-autogen, elixir-format
msgid ""
"This request ID was already used for a different command. Use the original "
"command or a new request ID."
msgstr ""
"এই অনুরোধ ID অন্য কমান্ডের জন্য ব্যবহৃত হয়েছে। মূল কমান্ড বা নতুন অনুরোধ ID"
" ব্যবহার করুন।"

#: lib/porsche/ssh/output.ex:214
#, elixir-autogen, elixir-format
msgid "This resize request cannot be cancelled in its current state."
msgstr "বর্তমান অবস্থায় এই আকার পরিবর্তনের অনুরোধ বাতিল করা যায় না।"

#: lib/porsche/ssh/output.ex:211
#, elixir-autogen, elixir-format
msgid "This resize request cannot be retried in its current state."
msgstr ""
"বর্তমান অবস্থায় এই আকার পরিবর্তনের অনুরোধ পুনরায় চেষ্টা করা যায় না।"

#: lib/porsche/ssh/output.ex:150
#, elixir-autogen, elixir-format
msgid ""
"Too many sessions or approval requests are active. Close an unused "
"connection and try again."
msgstr ""
"অতিরিক্ত সংখ্যক সেশন বা অনুমোদনের অনুরোধ সক্রিয় আছে। অব্যবহৃত একটি সংযোগ "
"বন্ধ করে আবার চেষ্টা করুন।"

#: lib/porsche/ssh/output.ex:79
#, elixir-autogen, elixir-format
msgid "You already hold the maximum number of pins; unpin one first."
msgstr "আপনার পিনের সংখ্যা সর্বোচ্চ সীমায় পৌঁছেছে; আগে একটি পিন খুলুন।"
