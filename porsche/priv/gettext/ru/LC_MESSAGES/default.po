#: lib/porsche/ssh/onboarding.ex:60
#, elixir-autogen, elixir-format
msgid ""
"\n"
"\n"
"Keep this SSH connection open while approving the key.\n"
msgstr ""
"\n"
"\n"
"Не закрывайте это SSH-соединение, пока подтверждаете ключ.\n"

#: lib/porsche/ssh/onboarding.ex:75
#, elixir-autogen, elixir-format
msgid ""
"\n"
"Open an interactive Porsche connection without a remote command:"
msgstr ""
"\n"
"Откройте интерактивное соединение Porsche без удалённой команды:"

#: lib/porsche/ssh/onboarding.ex:58
#, elixir-autogen, elixir-format
msgid ""
"\n"
"Open this link, sign in, and approve the matching fingerprint:\n"
"  "
msgstr ""
"\n"
"Откройте эту ссылку, войдите и подтвердите соответствующий отпечаток:\n"
"  "

msgid "Show the authenticated account."
msgstr "Показать аутентифицированную учётную запись."

#: lib/porsche/ssh/command_messages.ex:9
#, elixir-autogen, elixir-format
msgid "List available images."
msgstr "Показать доступные образы."

#: lib/porsche/ssh/command_messages.ex:16
#, elixir-autogen, elixir-format
msgid "List machines you can access."
msgstr "Показать машины, к которым у вас есть доступ."

#: lib/porsche/ssh/command_messages.ex:36
#, elixir-autogen, elixir-format
msgid "Inspect a machine by name or UUID."
msgstr "Просмотреть машину по имени или UUID."

#: lib/porsche/ssh/command_messages.ex:17
#, elixir-autogen, elixir-format
msgid ""
"Create a machine. Disk maximum: 500 GiB. --source clones a public GitHub, "
"GitLab, Codeberg or Bitbucket repository in the guest."
msgstr ""
"Создать машину. Максимальный диск: 500 GiB. --source клонирует публичный "
"репозиторий GitHub, GitLab, Codeberg или Bitbucket в гостевую систему."

#: lib/porsche/ssh/command_messages.ex:6
#, elixir-autogen, elixir-format
msgid "Queue an independent full-disk copy of a machine."
msgstr "Поставить в очередь независимую полную копию диска машины."

#: lib/porsche/ssh/command_messages.ex:24
#, elixir-autogen, elixir-format
msgid "Move a machine to an automatically selected host."
msgstr "Переместить машину на автоматически выбранный хост."

#: lib/porsche/ssh/command_messages.ex:28
#, elixir-autogen, elixir-format
msgid ""
"Change a machine's CPU and memory; disk may only grow. A running machine "
"stops and restarts."
msgstr ""
"Изменить процессор и память машины; диск можно только увеличить. Работающая "
"машина будет остановлена и перезапущена."

msgid "Retry a failed clone or relocation request."
msgstr "Повторить неудачный запрос клонирования или перемещения."

#: lib/porsche/ssh/command_messages.ex:25
#, elixir-autogen, elixir-format
msgid "Cancel an unpublished clone or uncommitted relocation request."
msgstr ""
"Отменить неопубликованный запрос клонирования или незафиксированный запрос "
"перемещения."

msgid "Start a machine."
msgstr "Запустить машину."

# Reviewed English fallback pending translation of suspension behavior.
msgid "Stop a machine, retaining its disk and discarding suspended memory."
msgstr "Stop a machine, retaining its disk and discarding suspended memory."

#: lib/porsche/ssh/command_messages.ex:32
#, elixir-autogen, elixir-format
msgid "Delete a machine and its disk. Refused while its owner has it pinned."
msgstr "Удалить машину и её диск. Запрещено, пока владелец закрепил машину."

# Reviewed English fallback pending translation of suspension behavior.
msgid "Pin a machine to the top of your lists. Your owner pin wakes it, prevents automatic suspension, and prevents deletion."
msgstr "Pin a machine to the top of your lists. Your owner pin wakes it, prevents automatic suspension, and prevents deletion."

#: lib/porsche/ssh/command_messages.ex:51
#, elixir-autogen, elixir-format
msgid "Remove your pin from a machine."
msgstr "Снять своё закрепление машины."

#: lib/porsche/ssh/command_messages.ex:35
#, elixir-autogen, elixir-format
msgid "List access grants."
msgstr "Показать разрешения доступа."

#: lib/porsche/ssh/command_messages.ex:33
#, elixir-autogen, elixir-format
msgid "Grant viewer, operator or manager access."
msgstr "Предоставить доступ viewer, operator или manager."

msgid "Revoke an account's shared access."
msgstr "Отозвать общий доступ учётной записи."

#: lib/porsche/ssh/command_messages.ex:37
#, elixir-autogen, elixir-format
msgid "List your SSH keys."
msgstr "Показать ваши SSH-ключи."

msgid "Revoke one of your SSH keys."
msgstr "Отозвать один из ваших SSH-ключей."

#: lib/porsche/ssh/command_messages.ex:10
#, elixir-autogen, elixir-format
msgid ""
"Create or replace a named integration at https://NAME.integration.internal."
msgstr ""
"Создать или заменить именованную интеграцию по адресу "
"https://NAME.integration.internal."

#: lib/porsche/ssh/command_messages.ex:14
#, elixir-autogen, elixir-format
msgid "Remove a named integration."
msgstr "Удалить именованную интеграцию."

#: lib/porsche/ssh/command_messages.ex:13
#, elixir-autogen, elixir-format
msgid "List your integrations."
msgstr "Показать ваши интеграции."

#: lib/porsche/ssh/command_messages.ex:15
#, elixir-autogen, elixir-format
msgid "Inspect an integration without secrets."
msgstr "Просмотреть интеграцию без секретов."

#: lib/porsche/ssh/command_messages.ex:11
#, elixir-autogen, elixir-format
msgid "Make an integration available to a machine."
msgstr "Сделать интеграцию доступной для машины."

#: lib/porsche/ssh/command_messages.ex:12
#, elixir-autogen, elixir-format
msgid "Remove a machine's explicit availability."
msgstr "Удалить явно заданную доступность машины."

#: lib/porsche/ssh/command_messages.ex:41
#, elixir-autogen, elixir-format
msgid "Create a team you own."
msgstr "Создать команду, владельцем которой будете вы."

#: lib/porsche/ssh/command_messages.ex:42
#, elixir-autogen, elixir-format
msgid "List your teams and roles."
msgstr "Показать ваши команды и роли."

#: lib/porsche/ssh/command_messages.ex:45
#, elixir-autogen, elixir-format
msgid "List a team's members."
msgstr "Показать участников команды."

#: lib/porsche/ssh/command_messages.ex:43
#, elixir-autogen, elixir-format
msgid "Add or change an admin or member."
msgstr "Добавить или изменить администратора или участника."

#: lib/porsche/ssh/command_messages.ex:44
#, elixir-autogen, elixir-format
msgid "Remove an account's membership."
msgstr "Удалить учётную запись из команды."

#: lib/porsche/ssh/command_messages.ex:49
#, elixir-autogen, elixir-format
msgid "Offer team ownership to an admin."
msgstr "Предложить администратору владение командой."

#: lib/porsche/ssh/command_messages.ex:46
#, elixir-autogen, elixir-format
msgid "Accept a pending ownership offer."
msgstr "Принять ожидающее предложение о владении."

#: lib/porsche/ssh/onboarding.ex:64
#, elixir-autogen, elixir-format
msgid "After approval, retry your command here.\n"
msgstr "После подтверждения повторите команду здесь.\n"

#: lib/porsche/ssh/onboarding.ex:61
#, elixir-autogen, elixir-format
msgid ""
"Approval links expire after %{minutes} minutes or when this connection "
"closes.\n"
msgstr ""
"Ссылки подтверждения действуют %{minutes} минут или до закрытия этого "
"соединения.\n"

#: lib/porsche/ssh/output.ex:64
#, elixir-autogen, elixir-format
msgid "Approve this SSH key in your browser, then retry the command."
msgstr "Подтвердите этот SSH-ключ в браузере, затем повторите команду."

#: lib/porsche/ssh/command_messages.ex:47
#, elixir-autogen, elixir-format
msgid "Cancel your pending ownership offer."
msgstr "Отменить своё ожидающее предложение о владении."

#: lib/porsche/ssh/command_messages.ex:7
#, elixir-autogen, elixir-format
msgid "Close this interactive channel."
msgstr "Закрыть этот интерактивный канал."

#: lib/porsche/ssh/command_messages.ex:48
#, elixir-autogen, elixir-format
msgid "Decline a pending ownership offer."
msgstr "Отклонить ожидающее предложение о владении."

#: lib/porsche/ssh/channel.ex:115
#, elixir-autogen, elixir-format
msgid "Docs:"
msgstr "Документация:"

#: lib/porsche/ssh/onboarding.ex:120
#, elixir-autogen, elixir-format
msgid "Follow the browser approval instructions, then run the setup command\n"
msgstr ""
"Следуйте инструкциям подтверждения в браузере, затем выполните команду "
"настройки\n"

#: lib/porsche/ssh/command_messages.ex:27
#, elixir-autogen, elixir-format
msgid "Inspect a previously accepted request."
msgstr "Просмотреть ранее принятый запрос."

#: lib/porsche/ssh/output.ex:58
#, elixir-autogen, elixir-format
msgid "Invalid command. Type help to see available commands."
msgstr "Недопустимая команда. Введите help для просмотра доступных команд."

#: lib/porsche/ssh/onboarding.ex:77
#, elixir-autogen, elixir-format
msgid "Keep that connection open while approving your key in the browser,\n"
msgstr "Не закрывайте это соединение, пока подтверждаете ключ в браузере,\n"

#: lib/porsche/ssh/channel.ex:113
#, elixir-autogen, elixir-format
msgid "Porsche machine management. Type help."
msgstr "Управление машинами Porsche. Введите help."

#: lib/porsche/ssh/onboarding.ex:114
#, elixir-autogen, elixir-format
msgid ""
"Register or check your SSH key in Overalls Account settings > SSH keys.\n"
"\n"
msgstr ""
"Зарегистрируйте или проверьте свой SSH-ключ в настройках учётной записи Overalls > SSH-ключи.\n"
"\n"

#: lib/porsche/ssh/onboarding.ex:110
#, elixir-autogen, elixir-format
msgid ""
"Register or check your key by connecting to:\n"
"  ssh "
msgstr ""
"Зарегистрируйте или проверьте свой ключ, подключившись к:\n"
"  ssh "

#: lib/porsche/ssh/output.ex:104
#, elixir-autogen, elixir-format
msgid "Request %{id}: submitting"
msgstr "Запрос %{id}: отправка"

#: lib/porsche/ssh/output.ex:107
#, elixir-autogen, elixir-format
msgid "Request %{id}: waiting for completion"
msgstr "Запрос %{id}: ожидание завершения"

# Reviewed English fallback pending translation of suspension behavior.
msgid "Suspend a machine, preserving its memory and disk."
msgstr "Suspend a machine, preserving its memory and disk."

# Reviewed English fallback pending translation of suspension behavior.
msgid "Resume preserved memory, waiting for capacity or relocation."
msgstr "Resume preserved memory, waiting for capacity or relocation."

# Reviewed English fallback pending translation of suspension behavior.
msgid "Resume a suspended machine's preserved memory."
msgstr "Resume a suspended machine's preserved memory."

#: lib/porsche/ssh/onboarding.ex:112
#, elixir-autogen, elixir-format
msgid "\nOr manage your keys at:\n  "
msgstr "\nИли управляйте ключами по адресу:\n  "

#: lib/porsche/ssh/command_messages.ex:8
#, elixir-autogen, elixir-format
msgid "Show command help."
msgstr "Показать справку по команде."

#: lib/porsche/ssh/output.ex:73
#, elixir-autogen, elixir-format
msgid "The command could not be completed: %{reason}"
msgstr "Не удалось выполнить команду: %{reason}"

#: lib/porsche/ssh/output.ex:67
#, elixir-autogen, elixir-format
msgid "The requested resource could not be found."
msgstr "Запрошенный ресурс не найден."

#: lib/porsche/ssh/output.ex:61
#, elixir-autogen, elixir-format
msgid "The service is temporarily unavailable. Please try again shortly."
msgstr "Сервис временно недоступен. Повторите попытку чуть позже."

#: lib/porsche/ssh/onboarding.ex:100
#, elixir-autogen, elixir-format
msgid "This SSH connection could not be authorized. Check your machine access and try again.\n\n"
msgstr "Не удалось авторизовать это SSH-соединение. Проверьте свой доступ к машине и повторите попытку.\n\n"

#: lib/porsche/ssh/output.ex:52
#, elixir-autogen, elixir-format
msgid "This connection is not authorized. Please sign in and try again."
msgstr "Это соединение не авторизовано. Войдите в систему и повторите попытку."

#: lib/porsche/ssh/output.ex:70
#, elixir-autogen, elixir-format
msgid "Unexpected input. Please open a new SSH connection."
msgstr "Неожиданный ввод. Откройте новое SSH-соединение."

#: lib/porsche/ssh/onboarding.ex:97
#, elixir-autogen, elixir-format
msgid "We couldn't verify this SSH key right now. Please try again shortly.\n\n"
msgstr "Сейчас не удалось проверить этот SSH-ключ. Повторите попытку чуть позже.\n\n"

#: lib/porsche/ssh/onboarding.ex:53
#, elixir-autogen, elixir-format
msgid "We don't recognize this SSH key:\n  "
msgstr "Этот SSH-ключ нам неизвестен:\n  "

#: lib/porsche/ssh/onboarding.ex:86
#, elixir-autogen, elixir-format
msgid "Welcome to Overalls.\n\nThis connection needs the Overalls SSH configuration.\n\n"
msgstr "Добро пожаловать в Overalls.\n\nДля этого соединения нужна конфигурация SSH Overalls.\n\n"

#: lib/porsche/ssh/output.ex:55
#, elixir-autogen, elixir-format
msgid "You do not have permission to perform this action."
msgstr "У вас нет разрешения на это действие."

#: lib/porsche/ssh/onboarding.ex:121
#, elixir-autogen, elixir-format
msgid "from your machine's page and reconnect without root@.\n"
msgstr "со страницы вашей машины и подключитесь заново без root@.\n"

#: lib/porsche/ssh/onboarding.ex:78
#, elixir-autogen, elixir-format
msgid "then retry your original command.\n"
msgstr "затем повторите исходную команду.\n"

#: lib/porsche/ssh/output.ex:94
#, elixir-autogen, elixir-format
msgid "A clone request is already in progress for this machine."
msgstr "Запрос на клонирование этой машины уже выполняется."

#: lib/porsche/ssh/output.ex:76
#, elixir-autogen, elixir-format
msgid "A failed machine cannot be pinned; an existing pin can still be removed."
msgstr "Машину с ошибкой нельзя закрепить; существующее закрепление можно снять."

#: lib/porsche/ssh/output.ex:121
#, elixir-autogen, elixir-format
msgid "A relocation is already in progress for this machine."
msgstr "Перемещение этой машины уже выполняется."

#: lib/porsche/ssh/output.ex:202
#, elixir-autogen, elixir-format
msgid "A repository source is not allowed for this machine profile."
msgstr "Источник из репозитория не разрешён для этого профиля машины."

#: lib/porsche/ssh/output.ex:118
#, elixir-autogen, elixir-format
msgid "A resize request is already in progress for this machine."
msgstr "Запрос на изменение размера этой машины уже выполняется."

#: lib/porsche/ssh/output.ex:110
#, elixir-autogen, elixir-format
msgid "A transfer is already using this host's transfer slot. Please try again after it finishes."
msgstr "Слот передачи этого хоста уже занят другой передачей. Повторите попытку после её завершения."

#: lib/porsche/ssh/output.ex:270
#, elixir-autogen, elixir-format
msgid "Accepted"
msgstr "Принято"

#: lib/porsche/ssh/output.ex:272
#, elixir-autogen, elixir-format
msgid "Failed"
msgstr "Ошибка"

#: lib/porsche/ssh/output.ex:265
#, elixir-autogen, elixir-format
msgid "Operation ID"
msgstr "ID операции"

#: lib/porsche/ssh/output.ex:262
#, elixir-autogen, elixir-format
msgid "Protocol version"
msgstr "Версия протокола"

#: lib/porsche/ssh/output.ex:264
#, elixir-autogen, elixir-format
msgid "Request ID"
msgstr "ID запроса"

#: lib/porsche/ssh/output.ex:266
#, elixir-autogen, elixir-format
msgid "Result"
msgstr "Результат"

#: lib/porsche/ssh/output.ex:115
#, elixir-autogen, elixir-format
msgid "Source cleanup is still pending. Wait for cleanup before retrying."
msgstr "Очистка источника ещё не завершена. Дождитесь очистки перед повторной попыткой."

#: lib/porsche/ssh/output.ex:263
#, elixir-autogen, elixir-format
msgid "Status"
msgstr "Состояние"

#: lib/porsche/ssh/output.ex:271
#, elixir-autogen, elixir-format
msgid "Succeeded"
msgstr "Успешно"

#: lib/porsche/ssh/output.ex:273
#, elixir-autogen, elixir-format
msgid "Superseded"
msgstr "Заменено"

#: lib/porsche/ssh/output.ex:242
#, elixir-autogen, elixir-format
msgid "The SSH public key is invalid. Check the key and try again."
msgstr "Недопустимый открытый ключ SSH. Проверьте ключ и повторите попытку."

#: lib/porsche/ssh/output.ex:237
#, elixir-autogen, elixir-format
msgid "The approval request limit has been reached. Close an unused connection and try again."
msgstr "Достигнут предел запросов на подтверждение. Закройте неиспользуемое соединение и повторите попытку."

#: lib/porsche/ssh/output.ex:184
#, elixir-autogen, elixir-format
msgid "The available host does not meet the machine image's requirements."
msgstr "Доступный хост не соответствует требованиям образа машины."

#: lib/porsche/ssh/output.ex:160
#, elixir-autogen, elixir-format
msgid "The connection to the control service was interrupted. Check the request status before submitting it again."
msgstr "Соединение со службой управления прервано. Проверьте состояние запроса перед повторной отправкой."

#: lib/porsche/ssh/output.ex:170
#, elixir-autogen, elixir-format
msgid "The control service refused the request. Check the request status before submitting it again."
msgstr "Служба управления отклонила запрос. Проверьте его состояние перед повторной отправкой."

#: lib/porsche/ssh/output.ex:165
#, elixir-autogen, elixir-format
msgid "The control service returned an invalid response. Check the request status before submitting it again."
msgstr "Служба управления вернула недопустимый ответ. Проверьте состояние запроса перед повторной отправкой."

#: lib/porsche/ssh/output.ex:190
#, elixir-autogen, elixir-format
msgid "The machine's disk is not reserved for this operation."
msgstr "Диск машины не зарезервирован для этой операции."

#: lib/porsche/ssh/output.ex:220
#, elixir-autogen, elixir-format
msgid "The machine's execution generation has changed. Inspect its current state before retrying."
msgstr "Поколение выполнения машины изменилось. Проверьте её текущее состояние перед повторной попыткой."

#: lib/porsche/ssh/output.ex:85
#, elixir-autogen, elixir-format
msgid "The machine's host is unavailable. Please try again shortly."
msgstr "Хост машины недоступен. Повторите попытку чуть позже."

#: lib/porsche/ssh/output.ex:133
#, elixir-autogen, elixir-format
msgid "The machine's placement has changed. Inspect its current state before retrying."
msgstr "Размещение машины изменилось. Проверьте её текущее состояние перед повторной попыткой."

#: lib/porsche/ssh/output.ex:217
#, elixir-autogen, elixir-format
msgid "The machine's stop has not been confirmed. Inspect its state before retrying."
msgstr "Остановка машины не подтверждена. Проверьте её состояние перед повторной попыткой."

#: lib/porsche/ssh/output.ex:102
#, elixir-autogen, elixir-format
msgid "The machine's workload is not stable enough for this operation. Check its state before retrying."
msgstr "Рабочая нагрузка машины недостаточно стабильна для этой операции. Проверьте её состояние перед повторной попыткой."

#: lib/porsche/ssh/output.ex:73
#, elixir-autogen, elixir-format
msgid "The owner has this machine pinned; unpin it first: unpin MACHINE"
msgstr "Владелец закрепил эту машину; сначала снимите закрепление: unpin MACHINE"

#: lib/porsche/ssh/output.ex:199
#, elixir-autogen, elixir-format
msgid "The recipient does not have a registered account."
msgstr "У получателя нет зарегистрированной учётной записи."

#: lib/porsche/ssh/output.ex:208
#, elixir-autogen, elixir-format
msgid "The repository source is invalid. Use a supported public repository URL."
msgstr "Недопустимый источник репозитория. Используйте поддерживаемый URL публичного репозитория."

#: lib/porsche/ssh/output.ex:205
#, elixir-autogen, elixir-format
msgid "The repository source is unavailable."
msgstr "Источник репозитория недоступен."

#: lib/porsche/ssh/output.ex:142
#, elixir-autogen, elixir-format
msgid "The request conflicts with the current state. Inspect the machine or request before retrying."
msgstr "Запрос конфликтует с текущим состоянием. Проверьте машину или запрос перед повторной попыткой."

#: lib/porsche/ssh/output.ex:139
#, elixir-autogen, elixir-format
msgid "The request is invalid. Check the command and its arguments."
msgstr "Недопустимый запрос. Проверьте команду и её аргументы."

#: lib/porsche/ssh/output.ex:147
#, elixir-autogen, elixir-format
msgid "The request or response exceeds the permitted size."
msgstr "Размер запроса или ответа превышает допустимый."

#: lib/porsche/ssh/output.ex:228
#, elixir-autogen, elixir-format
msgid "The requested SSH key could not be found."
msgstr "Запрошенный SSH-ключ не найден."

#: lib/porsche/ssh/output.ex:225
#, elixir-autogen, elixir-format
msgid "The requested command receipt could not be found."
msgstr "Квитанция запрошенной команды не найдена."

#: lib/porsche/ssh/output.ex:181
#, elixir-autogen, elixir-format
msgid "The requested machine image is unavailable."
msgstr "Запрошенный образ машины недоступен."

#: lib/porsche/ssh/output.ex:187
#, elixir-autogen, elixir-format
msgid "The requested machine size is invalid. Check the CPU, memory and disk limits."
msgstr "Недопустимый запрошенный размер машины. Проверьте ограничения CPU, памяти и диска."

#: lib/porsche/ssh/output.ex:175
#, elixir-autogen, elixir-format
msgid "The service configuration is invalid. Contact your operator."
msgstr "Недопустимая конфигурация службы. Обратитесь к оператору."

#: lib/porsche/ssh/output.ex:155
#, elixir-autogen, elixir-format
msgid "The service does not support this protocol version. Ask your operator to update the compatible services."
msgstr "Служба не поддерживает эту версию протокола. Попросите оператора обновить совместимые службы."

#: lib/porsche/ssh/output.ex:234
#, elixir-autogen, elixir-format
msgid "The session limit has been reached. Close an unused connection and try again."
msgstr "Достигнут предел сеансов. Закройте неиспользуемое соединение и повторите попытку."

#: lib/porsche/ssh/output.ex:107
#, elixir-autogen, elixir-format
msgid "The source machine is unavailable for this operation."
msgstr "Исходная машина недоступна для этой операции."

#: lib/porsche/ssh/output.ex:82
#, elixir-autogen, elixir-format
msgid "There is not enough available capacity for this request."
msgstr "Для этого запроса недостаточно доступных ресурсов."

#: lib/porsche/ssh/output.ex:196
#, elixir-autogen, elixir-format
msgid "This action cannot remove the owner's protected access."
msgstr "Это действие не может удалить защищённый доступ владельца."

#: lib/porsche/ssh/output.ex:88
#, elixir-autogen, elixir-format
msgid "This clone has already been published and cannot be retried or cancelled."
msgstr "Этот клон уже опубликован; повторить или отменить его нельзя."

#: lib/porsche/ssh/output.ex:91
#, elixir-autogen, elixir-format
msgid "This clone request cannot be retried in its current state."
msgstr "Этот запрос на клонирование нельзя повторить в текущем состоянии."

#: lib/porsche/ssh/output.ex:231
#, elixir-autogen, elixir-format
msgid "This connection requires verified HTTPS. Contact your operator."
msgstr "Для этого соединения требуется проверенный HTTPS. Обратитесь к оператору."

#: lib/porsche/ssh/output.ex:178
#, elixir-autogen, elixir-format
msgid "This machine has been deleted."
msgstr "Эта машина удалена."

#: lib/porsche/ssh/output.ex:193
#, elixir-autogen, elixir-format
msgid "This machine has reached its execution generation limit. Contact your operator."
msgstr "Эта машина достигла предельного поколения выполнения. Обратитесь к оператору."

#: lib/porsche/ssh/output.ex:136
#, elixir-autogen, elixir-format
msgid "This machine name is unavailable. Choose another name."
msgstr "Это имя машины недоступно. Выберите другое имя."

#: lib/porsche/ssh/output.ex:130
#, elixir-autogen, elixir-format
msgid "This relocation cannot be retried in its current state."
msgstr "Это перемещение нельзя повторить в текущем состоянии."

#: lib/porsche/ssh/output.ex:127
#, elixir-autogen, elixir-format
msgid "This relocation has already finished."
msgstr "Это перемещение уже завершено."

#: lib/porsche/ssh/output.ex:124
#, elixir-autogen, elixir-format
msgid "This relocation has committed its handoff and can no longer be cancelled."
msgstr "Передача управления при этом перемещении уже зафиксирована; отмена больше невозможна."

#: lib/porsche/ssh/output.ex:97
#, elixir-autogen, elixir-format
msgid "This request ID was already used for a different command. Use the original command or a new request ID."
msgstr "Этот ID запроса уже использован для другой команды. Используйте исходную команду или новый ID запроса."

#: lib/porsche/ssh/output.ex:214
#, elixir-autogen, elixir-format
msgid "This resize request cannot be cancelled in its current state."
msgstr "Этот запрос на изменение размера нельзя отменить в текущем состоянии."

#: lib/porsche/ssh/output.ex:211
#, elixir-autogen, elixir-format
msgid "This resize request cannot be retried in its current state."
msgstr "Этот запрос на изменение размера нельзя повторить в текущем состоянии."

#: lib/porsche/ssh/output.ex:150
#, elixir-autogen, elixir-format
msgid "Too many sessions or approval requests are active. Close an unused connection and try again."
msgstr "Активно слишком много сеансов или запросов на подтверждение. Закройте неиспользуемое соединение и повторите попытку."

#: lib/porsche/ssh/output.ex:79
#, elixir-autogen, elixir-format
msgid "You already hold the maximum number of pins; unpin one first."
msgstr "У вас уже максимальное число закреплений; сначала снимите одно."
