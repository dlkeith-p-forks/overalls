msgstr "We no recognize dis SSH key:\n  "

#: lib/porsche/ssh/onboarding.ex:95
#, elixir-autogen, elixir-format
msgid "Welcome to Overalls.\n\nThis connection needs the Overalls SSH configuration.\n\n"
msgstr "Welcome to Overalls.\n\nDis connection need di Overalls SSH configuration.\n\n"

#: lib/porsche/ssh/onboarding.ex:142
#, elixir-autogen, elixir-format
msgid "from your machine's page and reconnect without root@.\n"
msgstr "from your machine page and connect again without root@.\n"

#: lib/porsche/ssh/onboarding.ex:87
#, elixir-autogen, elixir-format
msgid "then retry your original command.\n"
msgstr "then try your original command again.\n"
