msgid ""
msgstr ""
"Language: pcm\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "Porsche machine management. Type help."
msgstr "Porsche machine management. Type help."

msgid "Docs:"
msgstr "Document dem:"

msgid "Show command help."
msgstr "Show command help."

msgid "Show the authenticated account."
msgstr "Show di account wey don authenticate."

msgid "List available images."
msgstr "List image dem wey dey available."

msgid "List machines you can access."
msgstr "List machine dem wey you fit access."

msgid "Inspect a machine by name or UUID."
msgstr "Check machine wit im name or UUID."

msgid "Create a machine. Disk maximum: 500 GiB. --source clones a public GitHub, GitLab, Codeberg or Bitbucket repository in the guest."
msgstr "Create machine. Di biggest disk na 500 GiB. --source go clone public GitHub, GitLab, Codeberg or Bitbucket repository inside di guest."

msgid "Queue an independent full-disk copy of a machine."
msgstr "Put independent full-disk copy of machine for queue."

msgid "Move a machine to an automatically selected host."
msgstr "Move machine go host wey system choose by imself."

msgid "Change a machine's CPU and memory; disk may only grow. A running machine stops and restarts."
msgstr "Change machine CPU and memory; disk fit only grow. Machine wey dey run go stop and start again."

msgid "Retry a failed clone or relocation request."
msgstr "Try clone or move request wey fail again."

msgid "Cancel an unpublished clone or uncommitted relocation request."
msgstr "Cancel clone wey dem never publish or move request wey dem never commit."

msgid "Start a machine."
msgstr "Start machine."

msgid "Stop a machine, retaining its disk."
msgstr "Stop machine, but keep im disk."

msgid "Delete a machine and its disk. Refused while its owner has it pinned."
msgstr "Delete machine and im disk. E no go work if di owner pin am."

msgid "Pin a machine to the top of your lists. While you own it and it is pinned, nothing can delete it."
msgstr "Pin machine for top of your list dem. As long as you own am and e dey pinned, nothing fit delete am."

msgid "Remove your pin from a machine."
msgstr "Remove your pin from machine."

msgid "List access grants."
msgstr "List access permission dem."

msgid "Grant viewer, operator or manager access."
msgstr "Give viewer, operator or manager access."

msgid "Revoke an account's shared access."
msgstr "Remove account shared access."

msgid "List your SSH keys."
msgstr "List your SSH key dem."

msgid "Revoke one of your SSH keys."
msgstr "Cancel one of your SSH key dem."

msgid "Create or replace a named integration at https://NAME.integration.internal."
msgstr "Create or replace integration wey get name for https://NAME.integration.internal."

msgid "Remove a named integration."
msgstr "Remove integration wey get name."

msgid "List your integrations."
msgstr "List your integration dem."

msgid "Inspect an integration without secrets."
msgstr "Check integration without secret dem."

msgid "Make an integration available to a machine."
msgstr "Make integration available for machine."

msgid "Remove a machine's explicit availability."
msgstr "Remove di availability wey dem give machine directly."

msgid "Create a team you own."
msgstr "Create team wey you own."

msgid "List your teams and roles."
msgstr "List your team dem and role dem."

msgid "List a team's members."
msgstr "List team member dem."

msgid "Add or change an admin or member."
msgstr "Add or change admin or member."

msgid "Remove an account's membership."
msgstr "Remove account membership."

msgid "Offer team ownership to an admin."
msgstr "Offer team ownership to admin."

msgid "Accept a pending ownership offer."
msgstr "Accept ownership offer wey dey wait."

msgid "Decline a pending ownership offer."
msgstr "Reject ownership offer wey dey wait."

msgid "Cancel your pending ownership offer."
msgstr "Cancel your ownership offer wey dey wait."

msgid "Inspect a previously accepted request."
msgstr "Check request wey dem don accept before."

msgid "Close this interactive channel."
msgstr "Close dis interactive channel."

msgid "We don't recognize this SSH key:\n  "
msgstr "We no recognize dis SSH key:\n  "

msgid "\nOpen this link, sign in, and approve the matching fingerprint:\n  "
msgstr "\nOpen dis link, sign in, and approve di fingerprint wey match:\n  "

msgid "\n\nKeep this SSH connection open while approving the key.\n"
msgstr "\n\nKeep dis SSH connection open as you dey approve di key.\n"

msgid "Approval links expire after %{minutes} minutes or when this connection closes.\n"
msgstr "Approval link dem go expire after %{minutes} minute or when dis connection close.\n"

msgid "After approval, retry your command here.\n"
msgstr "After approval, try your command again here.\n"

msgid "\nOpen an interactive Porsche connection without a remote command:"
msgstr "\nOpen interactive Porsche connection without remote command:"

msgid "Keep that connection open while approving your key in the browser,\n"
msgstr "Keep dat connection open as you dey approve your key for browser,\n"

msgid "then retry your original command.\n"
msgstr "then try your first command again.\n"

msgid "Welcome to Overalls.\n\nThis connection needs the Overalls SSH configuration.\n\n"
msgstr "Welcome to Overalls.\n\nDis connection need Overalls SSH configuration.\n\n"

msgid "We couldn't verify this SSH key right now. Please try again shortly.\n\n"
msgstr "We no fit verify dis SSH key now. Abeg try again soon.\n\n"

msgid "This SSH connection could not be authorized. Check your machine access and try again.\n\n"
msgstr "We no fit authorize dis SSH connection. Check your machine access and try again.\n\n"

msgid "Register or check your key by connecting to:\n  ssh "
msgstr "Register or check your key by connecting to:\n  ssh "

msgid "\nOr manage your keys at:\n  "
msgstr "\nOr manage your key dem for:\n  "

msgid "Register or check your SSH key in Overalls Account settings > SSH keys.\n\n"
msgstr "Register or check your SSH key for Overalls Account settings > SSH keys.\n\n"

msgid "Follow the browser approval instructions, then run the setup command\n"
msgstr "Follow di browser approval instruction dem, then run di setup command\n"

msgid "from your machine's page and reconnect without root@.\n"
msgstr "from your machine page and connect again without root@.\n"

msgid "This connection is not authorized. Please sign in and try again."
msgstr "Dis connection no get authorization. Abeg sign in and try again."

msgid "You do not have permission to perform this action."
msgstr "You no get permission to do dis action."

msgid "Invalid command. Type help to see available commands."
msgstr "Command no valid. Type help to see command dem wey dey available."

msgid "The service is temporarily unavailable. Please try again shortly."
msgstr "Di service no dey available for now. Abeg try again soon."

msgid "Approve this SSH key in your browser, then retry the command."
msgstr "Approve dis SSH key for your browser, then try di command again."

msgid "The requested resource could not be found."
msgstr "We no fit find di resource wey you request."

msgid "Unexpected input. Please open a new SSH connection."
msgstr "Input wey we no expect. Abeg open new SSH connection."

msgid "The command could not be completed: %{reason}"
msgstr "We no fit finish di command: %{reason}"

msgid "Request %{id}: submitting"
msgstr "Request %{id}: e dey submit"

msgid "Request %{id}: waiting for completion"
msgstr "Request %{id}: e dey wait to finish"
