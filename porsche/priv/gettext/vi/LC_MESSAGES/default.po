msgstr ""
"Language: vi\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "Porsche machine management. Type help."
msgstr "Quản lý máy Porsche. Nhập help."

msgid "Docs:"
msgstr "Tài liệu:"

msgid "Show command help."
msgstr "Hiển thị trợ giúp lệnh."

msgid "Show the authenticated account."
msgstr "Hiển thị tài khoản đã xác thực."

msgid "List available images."
msgstr "Liệt kê các ảnh máy khả dụng."

msgid "List machines you can access."
msgstr "Liệt kê các máy bạn có thể truy cập."

msgid "Inspect a machine by name or UUID."
msgstr "Kiểm tra máy theo tên hoặc UUID."

msgid "Create a machine. Disk maximum: 500 GiB. --source clones a public GitHub, GitLab, Codeberg or Bitbucket repository in the guest."
msgstr "Tạo máy. Dung lượng đĩa tối đa: 500 GiB. --source sao chép kho GitHub, GitLab, Codeberg hoặc Bitbucket công khai vào máy khách."

msgid "Queue an independent full-disk copy of a machine."
msgstr "Đưa bản sao toàn bộ đĩa độc lập của máy vào hàng đợi."

msgid "Move a machine to an automatically selected host."
msgstr "Di chuyển máy đến máy chủ được chọn tự động."

msgid "Change a machine's CPU and memory; disk may only grow. A running machine stops and restarts."
msgstr "Thay đổi CPU và bộ nhớ của máy; chỉ có thể tăng dung lượng đĩa. Máy đang chạy sẽ dừng rồi khởi động lại."

msgid "Retry a failed clone or relocation request."
msgstr "Thử lại yêu cầu sao chép hoặc di chuyển thất bại."

msgid "Cancel an unpublished clone or uncommitted relocation request."
msgstr "Hủy bản sao chưa công bố hoặc yêu cầu di chuyển chưa xác nhận."

msgid "Start a machine."
msgstr "Khởi động máy."

msgid "Stop a machine, retaining its disk."
msgstr "Dừng máy và giữ lại đĩa."

msgid "Delete a machine and its disk. Refused while its owner has it pinned."
msgstr "Xóa máy và đĩa. Từ chối khi chủ sở hữu đang ghim máy."

msgid "Pin a machine to the top of your lists. While you own it and it is pinned, nothing can delete it."
msgstr "Ghim máy lên đầu danh sách. Khi bạn còn sở hữu và ghim máy, không thao tác nào có thể xóa máy."

msgid "Remove your pin from a machine."
msgstr "Bỏ ghim máy của bạn."

msgid "List access grants."
msgstr "Liệt kê các quyền truy cập đã cấp."

msgid "Grant viewer, operator or manager access."
msgstr "Cấp quyền người xem, người vận hành hoặc người quản lý."

msgid "Revoke an account's shared access."
msgstr "Thu hồi quyền truy cập chia sẻ của tài khoản."

msgid "List your SSH keys."
msgstr "Liệt kê các khóa SSH của bạn."

msgid "Revoke one of your SSH keys."
msgstr "Thu hồi một khóa SSH của bạn."

msgid "Create or replace a named integration at https://NAME.integration.internal."
msgstr "Tạo hoặc thay thế tích hợp có tên tại https://NAME.integration.internal."

msgid "Remove a named integration."
msgstr "Xóa tích hợp có tên."

msgid "List your integrations."
msgstr "Liệt kê các tích hợp của bạn."

msgid "Inspect an integration without secrets."
msgstr "Kiểm tra tích hợp mà không hiển thị bí mật."

msgid "Make an integration available to a machine."
msgstr "Cho phép máy sử dụng một tích hợp."

msgid "Remove a machine's explicit availability."
msgstr "Gỡ quyền sử dụng được cấp riêng cho máy."

msgid "Create a team you own."
msgstr "Tạo nhóm do bạn sở hữu."

msgid "List your teams and roles."
msgstr "Liệt kê các nhóm và vai trò của bạn."

msgid "List a team's members."
msgstr "Liệt kê thành viên của nhóm."

msgid "Add or change an admin or member."
msgstr "Thêm hoặc thay đổi quản trị viên hay thành viên."

msgid "Remove an account's membership."
msgstr "Xóa tư cách thành viên của tài khoản."

msgid "Offer team ownership to an admin."
msgstr "Đề nghị chuyển quyền sở hữu nhóm cho quản trị viên."

msgid "Accept a pending ownership offer."
msgstr "Chấp nhận đề nghị chuyển quyền sở hữu đang chờ."

msgid "Decline a pending ownership offer."
msgstr "Từ chối đề nghị chuyển quyền sở hữu đang chờ."

msgid "Cancel your pending ownership offer."
msgstr "Hủy đề nghị chuyển quyền sở hữu đang chờ của bạn."

msgid "Inspect a previously accepted request."
msgstr "Kiểm tra yêu cầu đã được chấp nhận trước đó."

msgid "Close this interactive channel."
msgstr "Đóng kênh tương tác này."

msgid "We don't recognize this SSH key:\n  "
msgstr "Chúng tôi không nhận ra khóa SSH này:\n  "

msgid "\nOpen this link, sign in, and approve the matching fingerprint:\n  "
msgstr "\nMở liên kết này, đăng nhập và phê duyệt dấu vân tay trùng khớp:\n  "

msgid "\n\nKeep this SSH connection open while approving the key.\n"
msgstr "\n\nGiữ kết nối SSH này mở trong khi phê duyệt khóa.\n"

msgid "Approval links expire after %{minutes} minutes or when this connection closes.\n"
msgstr "Liên kết phê duyệt hết hạn sau %{minutes} phút hoặc khi kết nối này đóng.\n"

msgid "After approval, retry your command here.\n"
msgstr "Sau khi phê duyệt, hãy thử lại lệnh tại đây.\n"

msgid "\nOpen an interactive Porsche connection without a remote command:"
msgstr "\nMở kết nối Porsche tương tác mà không có lệnh từ xa:"

msgid "Keep that connection open while approving your key in the browser,\n"
msgstr "Giữ kết nối đó mở trong khi phê duyệt khóa trong trình duyệt,\n"

msgid "then retry your original command.\n"
msgstr "sau đó thử lại lệnh ban đầu.\n"

msgid "Welcome to Overalls.\n\nThis connection needs the Overalls SSH configuration.\n\n"
msgstr "Chào mừng đến với Overalls.\n\nKết nối này cần cấu hình SSH của Overalls.\n\n"

msgid "We couldn't verify this SSH key right now. Please try again shortly.\n\n"
msgstr "Hiện chưa thể xác minh khóa SSH này. Vui lòng thử lại sau ít phút.\n\n"

msgid "This SSH connection could not be authorized. Check your machine access and try again.\n\n"
msgstr "Không thể cấp phép cho kết nối SSH này. Hãy kiểm tra quyền truy cập máy và thử lại.\n\n"

msgid "Register or check your key by connecting to:\n  ssh "
msgstr "Đăng ký hoặc kiểm tra khóa bằng cách kết nối đến:\n  ssh "

msgid "\nOr manage your keys at:\n  "
msgstr "\nHoặc quản lý khóa tại:\n  "

msgid "Register or check your SSH key in Overalls Account settings > SSH keys.\n\n"
msgstr "Đăng ký hoặc kiểm tra khóa SSH trong Cài đặt tài khoản Overalls > Khóa SSH.\n\n"

msgid "Follow the browser approval instructions, then run the setup command\n"
msgstr "Làm theo hướng dẫn phê duyệt trong trình duyệt, rồi chạy lệnh thiết lập\n"

msgid "from your machine's page and reconnect without root@.\n"
msgstr "từ trang của máy và kết nối lại mà không có root@.\n"

msgid "This connection is not authorized. Please sign in and try again."
msgstr "Kết nối này chưa được cấp phép. Vui lòng đăng nhập và thử lại."

msgid "You do not have permission to perform this action."
msgstr "Bạn không có quyền thực hiện thao tác này."

msgid "Invalid command. Type help to see available commands."
msgstr "Lệnh không hợp lệ. Nhập help để xem các lệnh khả dụng."

msgid "The service is temporarily unavailable. Please try again shortly."
msgstr "Dịch vụ tạm thời không khả dụng. Vui lòng thử lại sau ít phút."

msgid "Approve this SSH key in your browser, then retry the command."
msgstr "Phê duyệt khóa SSH này trong trình duyệt rồi thử lại lệnh."

msgid "The requested resource could not be found."
msgstr "Không tìm thấy tài nguyên được yêu cầu."

msgid "Unexpected input. Please open a new SSH connection."
msgstr "Dữ liệu đầu vào không mong đợi. Vui lòng mở kết nối SSH mới."

msgid "The command could not be completed: %{reason}"
msgstr "Không thể hoàn tất lệnh: %{reason}"

msgid "Request %{id}: submitting"
msgstr "Yêu cầu %{id}: đang gửi"

msgid "Request %{id}: waiting for completion"
msgstr "Yêu cầu %{id}: đang chờ hoàn tất"
