#: lib/porsche/ssh/onboarding.ex:64
#, elixir-autogen, elixir-format
msgid ""
"\n"
"\n"
"Keep this SSH connection open while approving the key.\n"
msgstr ""
"\n"
"\n"
"Mantenga abierta esta conexión SSH mientras aprueba la clave.\n"

#: lib/porsche/ssh/onboarding.ex:81
#, elixir-autogen, elixir-format
msgid ""
"\n"
"Open an interactive Porsche connection without a remote command:"
msgstr ""
"\n"
"Abra una conexión interactiva de Porsche sin un comando remoto:"

#: lib/porsche/ssh/onboarding.ex:59
#, elixir-autogen, elixir-format
msgid ""
"\n"
"Open this link, sign in, and approve the matching fingerprint:\n"
"  "
msgstr ""
"\n"
"Abra este enlace, inicie sesión y apruebe la huella coincidente:\n"
"  "

#: lib/porsche/ssh/onboarding.ex:126
#, elixir-autogen, elixir-format
msgid "\nOr manage your keys at:\n  "
msgstr "\nO gestiona tus claves en:\n  "

#: lib/porsche/ssh/onboarding.ex:70
#, elixir-autogen, elixir-format
msgid "After approval, retry your command here.\n"
msgstr "Después de la aprobación, vuelva a intentar su comando aquí.\n"

#: lib/porsche/ssh/onboarding.ex:65
#, elixir-autogen, elixir-format
msgid ""
"Approval links expire after %{minutes} minutes or when this connection "
"closes.\n"
msgstr ""
"Los enlaces de aprobación caducan tras %{minutes} minutos o al cerrar esta "
"conexión.\n"

#: lib/porsche/ssh/onboarding.ex:138
#, elixir-autogen, elixir-format
msgid "Follow the browser approval instructions, then run the setup command\n"
msgstr ""
"Siga las instrucciones de aprobación en el navegador y ejecute el comando de"
" configuración\n"

#: lib/porsche/ssh/onboarding.ex:83
#, elixir-autogen, elixir-format
msgid "Keep that connection open while approving your key in the browser,\n"
msgstr ""
"Mantenga esa conexión abierta mientras aprueba su clave en el navegador,\n"

#: lib/porsche/ssh/onboarding.ex:129
#, elixir-autogen, elixir-format
msgid ""
"Register or check your SSH key in Overalls Account settings > SSH keys.\n"
"\n"
msgstr ""
"Registre o compruebe su clave SSH en Configuración de la cuenta de Overalls > Claves SSH.\n"
"\n"

#: lib/porsche/ssh/onboarding.ex:124
#, elixir-autogen, elixir-format
msgid ""
"Register or check your key by connecting to:\n"
"  ssh "
msgstr ""
"Registre o compruebe su clave conectándose a:\n"
"  ssh "

#: lib/porsche/ssh/onboarding.ex:113
#, elixir-autogen, elixir-format
msgid "This SSH connection could not be authorized. Check your machine access and try again.\n\n"
msgstr "No se pudo autorizar esta conexión SSH. Comprueba tu acceso a la máquina y vuelve a intentarlo.\n\n"

#: lib/porsche/ssh/onboarding.ex:107
#, elixir-autogen, elixir-format
msgid "We couldn't verify this SSH key right now. Please try again shortly.\n\n"
msgstr "No hemos podido verificar esta clave SSH en este momento. Vuelve a intentarlo en breve.\n\n"

#: lib/porsche/ssh/onboarding.ex:54
#, elixir-autogen, elixir-format
msgid "We don't recognize this SSH key:\n  "
msgstr "No reconocemos esta clave SSH:\n  "

#: lib/porsche/ssh/onboarding.ex:95
#, elixir-autogen, elixir-format
msgid "Welcome to Overalls.\n\nThis connection needs the Overalls SSH configuration.\n\n"
msgstr "Te damos la bienvenida a Overalls.\n\nEsta conexión necesita la configuración SSH de Overalls.\n\n"

#: lib/porsche/ssh/onboarding.ex:142
#, elixir-autogen, elixir-format
msgid "from your machine's page and reconnect without root@.\n"
msgstr "desde la página de tu máquina y vuelve a conectarte sin root@.\n"

#: lib/porsche/ssh/onboarding.ex:87
#, elixir-autogen, elixir-format
msgid "then retry your original command.\n"
msgstr "y después vuelve a ejecutar el comando original.\n"
