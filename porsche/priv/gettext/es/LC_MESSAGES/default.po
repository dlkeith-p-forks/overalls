msgstr "Mover una máquina a un anfitrión seleccionado automáticamente."

#: lib/porsche/ssh/command_messages.ex:47
#, elixir-autogen, elixir-format
msgid "Offer team ownership to an admin."
msgstr "Ofrecer la propiedad del equipo a un administrador."

#: lib/porsche/ssh/channel.ex:152
#, elixir-autogen, elixir-format
msgid "Porsche machine management. Type help."
msgstr "Gestión de máquinas Porsche. Escriba help."

#: lib/porsche/ssh/command_messages.ex:13
#, elixir-autogen, elixir-format
