msgstr "Comando no válido. Escriba help para ver los comandos disponibles."

#: lib/porsche/ssh/onboarding.ex:77
#, elixir-autogen, elixir-format
msgid "Keep that connection open while approving your key in the browser,\n"
msgstr ""
"Mantenga esa conexión abierta mientras aprueba su clave en el navegador,\n"

#: lib/porsche/ssh/command_messages.ex:44
#, elixir-autogen, elixir-format
msgid "List a team's members."
msgstr "Listar los miembros de un equipo."

#: lib/porsche/ssh/command_messages.ex:29
#, elixir-autogen, elixir-format
