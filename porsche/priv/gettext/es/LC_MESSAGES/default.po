#, elixir-autogen, elixir-format
msgid "\nOr manage your keys at:\n  "
msgstr "\nO gestiona tus claves en:\n  "

#: lib/porsche/ssh/command_messages.ex:48
#, elixir-autogen, elixir-format
msgid "Accept a pending ownership offer."
msgstr "Aceptar una oferta de propiedad pendiente."

#: lib/porsche/ssh/command_messages.ex:45
#, elixir-autogen, elixir-format
msgid "Add or change an admin or member."
msgstr "Añadir o cambiar un administrador o miembro."

#: lib/porsche/ssh/onboarding.ex:64
#, elixir-autogen, elixir-format
msgid "After approval, retry your command here.\n"
msgstr "Después de la aprobación, vuelva a intentar su comando aquí.\n"

#: lib/porsche/ssh/onboarding.ex:61
#, elixir-autogen, elixir-format
msgid "Approval links expire after %{minutes} minutes or when this connection closes.\n"
msgstr ""
"Los enlaces de aprobación caducan tras %{minutes} minutos o al cerrar esta "
"conexión.\n"

#: lib/porsche/ssh/output.ex:64
#, elixir-autogen, elixir-format
msgid "Approve this SSH key in your browser, then retry the command."
msgstr ""
"Apruebe esta clave SSH en su navegador y vuelva a intentar el comando."

#: lib/porsche/ssh/command_messages.ex:19
#, elixir-autogen, elixir-format
msgid "Cancel an unpublished clone or uncommitted relocation request."
msgstr ""
"Cancelar una solicitud de clonación no publicada o de reubicación no "
"confirmada."

#: lib/porsche/ssh/command_messages.ex:50
#, elixir-autogen, elixir-format
msgid "Cancel your pending ownership offer."
msgstr "Cancelar su oferta de propiedad pendiente."

#: lib/porsche/ssh/command_messages.ex:15
#, elixir-autogen, elixir-format
msgid "Change a machine's CPU and memory; disk may only grow. A running machine stops and restarts."
msgstr ""
"Cambiar la CPU y la memoria de una máquina; el disco solo puede ampliarse. "
"Una máquina en ejecución se detiene y reinicia."

#: lib/porsche/ssh/command_messages.ex:52
#, elixir-autogen, elixir-format
msgid "Close this interactive channel."
msgstr "Cerrar este canal interactivo."

#: lib/porsche/ssh/command_messages.ex:10
#, elixir-autogen, elixir-format
msgid "Create a machine. Disk maximum: 500 GiB. --source clones a public GitHub, GitLab, Codeberg or Bitbucket repository in the guest."
msgstr ""
"Crear una máquina. Disco máximo: 500 GiB. --source clona un repositorio "
"público de GitHub, GitLab, Codeberg o Bitbucket en el huésped."

#: lib/porsche/ssh/command_messages.ex:42
#, elixir-autogen, elixir-format
msgid "Create a team you own."
msgstr "Crear un equipo del que sea propietario."

#: lib/porsche/ssh/command_messages.ex:34
#, elixir-autogen, elixir-format
msgid "Create or replace a named integration at https://NAME.integration.internal."
msgstr ""
"Crear o reemplazar una integración con nombre en "
"https://NAME.integration.internal."

#: lib/porsche/ssh/command_messages.ex:49
#, elixir-autogen, elixir-format
msgid "Decline a pending ownership offer."
msgstr "Rechazar una oferta de propiedad pendiente."

#: lib/porsche/ssh/command_messages.ex:22
#, elixir-autogen, elixir-format
msgid "Delete a machine and its disk. Refused while its owner has it pinned."
msgstr ""
"Eliminar una máquina y su disco. Se rechaza mientras su propietario la tenga"
" fijada."

#: lib/porsche/ssh/channel.ex:154
#, elixir-autogen, elixir-format
msgid "Docs:"
msgstr "Documentación:"

#: lib/porsche/ssh/onboarding.ex:120
#, elixir-autogen, elixir-format
msgid "Follow the browser approval instructions, then run the setup command\n"
msgstr ""
"Siga las instrucciones de aprobación en el navegador y ejecute el comando de"
" configuración\n"

#: lib/porsche/ssh/command_messages.ex:30
#, elixir-autogen, elixir-format
msgid "Grant viewer, operator or manager access."
msgstr "Conceder acceso viewer, operator o manager."

#: lib/porsche/ssh/command_messages.ex:9
#, elixir-autogen, elixir-format
