#: lib/porsche/ssh/onboarding.ex:60
#, elixir-autogen, elixir-format
msgid "\n\nKeep this SSH connection open while approving the key.\n"
msgstr ""
"\n"
"\n"
"Gardez cette connexion SSH ouverte pendant l’approbation de la clé.\n"

#: lib/porsche/ssh/onboarding.ex:75
#, elixir-autogen, elixir-format
msgid "\nOpen an interactive Porsche connection without a remote command:"
msgstr ""
"\n"
"Ouvrez une connexion Porsche interactive sans commande distante :"

#: lib/porsche/ssh/onboarding.ex:58
#, elixir-autogen, elixir-format
msgid "\nOpen this link, sign in, and approve the matching fingerprint:\n  "
msgstr ""
"\n"
"Ouvrez ce lien, connectez-vous et approuvez l’empreinte correspondante :\n"
"  "

#: lib/porsche/ssh/onboarding.ex:112
#, elixir-autogen, elixir-format
msgid "\nOr manage your keys at:\n  "
msgstr "\nOu gérez vos clés à l’adresse :\n  "

#: lib/porsche/ssh/command_messages.ex:48
#, elixir-autogen, elixir-format
msgid "Accept a pending ownership offer."
msgstr "Accepter une proposition de propriété en attente."

#: lib/porsche/ssh/command_messages.ex:45
#, elixir-autogen, elixir-format
msgid "Add or change an admin or member."
msgstr "Ajouter ou modifier un administrateur ou un membre."

#: lib/porsche/ssh/onboarding.ex:64
#, elixir-autogen, elixir-format
msgid "After approval, retry your command here.\n"
msgstr "Après l’approbation, réessayez votre commande ici.\n"

#: lib/porsche/ssh/onboarding.ex:61
#, elixir-autogen, elixir-format
msgid "Approval links expire after %{minutes} minutes or when this connection closes.\n"
msgstr ""
"Les liens d’approbation expirent après %{minutes} minutes ou à la fermeture "
"de cette connexion.\n"

#: lib/porsche/ssh/output.ex:64
#, elixir-autogen, elixir-format
msgid "Approve this SSH key in your browser, then retry the command."
msgstr ""
"Approuvez cette clé SSH dans votre navigateur, puis réessayez la commande."

#: lib/porsche/ssh/command_messages.ex:19
#, elixir-autogen, elixir-format
msgid "Cancel an unpublished clone or uncommitted relocation request."
msgstr ""
"Annuler une demande de clonage non publiée ou de déplacement non validée."

#: lib/porsche/ssh/command_messages.ex:50
#, elixir-autogen, elixir-format
msgid "Cancel your pending ownership offer."
msgstr "Annuler votre proposition de propriété en attente."

#: lib/porsche/ssh/command_messages.ex:15
#, elixir-autogen, elixir-format
msgid "Change a machine's CPU and memory; disk may only grow. A running machine stops and restarts."
msgstr ""
"Modifier le processeur et la mémoire d’une machine ; le disque peut "
"seulement être agrandi. Une machine en cours d’exécution s’arrête puis "
"redémarre."

#: lib/porsche/ssh/command_messages.ex:52
#, elixir-autogen, elixir-format
msgid "Close this interactive channel."
msgstr "Fermer ce canal interactif."

#: lib/porsche/ssh/command_messages.ex:10
#, elixir-autogen, elixir-format
msgid "Create a machine. Disk maximum: 500 GiB. --source clones a public GitHub, GitLab, Codeberg or Bitbucket repository in the guest."
msgstr ""
"Créer une machine. Disque maximal : 500 GiB. --source clone un dépôt public "
"GitHub, GitLab, Codeberg ou Bitbucket dans l’invité."

#: lib/porsche/ssh/command_messages.ex:42
#, elixir-autogen, elixir-format
msgid "Create a team you own."
msgstr "Créer une équipe dont vous êtes propriétaire."

#: lib/porsche/ssh/command_messages.ex:34
#, elixir-autogen, elixir-format
msgid "Create or replace a named integration at https://NAME.integration.internal."
msgstr ""
"Créer ou remplacer une intégration nommée à l’adresse "
"https://NAME.integration.internal."

#: lib/porsche/ssh/command_messages.ex:49
#, elixir-autogen, elixir-format
msgid "Decline a pending ownership offer."
msgstr "Refuser une proposition de propriété en attente."

#: lib/porsche/ssh/command_messages.ex:22
#, elixir-autogen, elixir-format
msgid "Delete a machine and its disk. Refused while its owner has it pinned."
msgstr ""
"Supprimer une machine et son disque. Refusé tant que son propriétaire l’a "
"épinglée."

#: lib/porsche/ssh/channel.ex:154
#, elixir-autogen, elixir-format
msgid "Docs:"
msgstr "Documentation :"

#: lib/porsche/ssh/onboarding.ex:120
#, elixir-autogen, elixir-format
msgid "Follow the browser approval instructions, then run the setup command\n"
msgstr ""
"Suivez les instructions d’approbation dans le navigateur, puis exécutez la "
"commande de configuration\n"

#: lib/porsche/ssh/command_messages.ex:30
#, elixir-autogen, elixir-format
msgid "Grant viewer, operator or manager access."
msgstr "Accorder un accès viewer, operator ou manager."

#: lib/porsche/ssh/command_messages.ex:9
#, elixir-autogen, elixir-format
msgid "Inspect a machine by name or UUID."
msgstr "Inspecter une machine par nom ou UUID."

#: lib/porsche/ssh/command_messages.ex:51
#, elixir-autogen, elixir-format
msgid "Inspect a previously accepted request."
msgstr "Inspecter une demande précédemment acceptée."

#: lib/porsche/ssh/command_messages.ex:39
#, elixir-autogen, elixir-format
msgid "Inspect an integration without secrets."
msgstr "Inspecter une intégration sans secrets."

#: lib/porsche/ssh/output.ex:58
#, elixir-autogen, elixir-format
msgid "Invalid command. Type help to see available commands."
msgstr "Commande invalide. Tapez help pour voir les commandes disponibles."

#: lib/porsche/ssh/onboarding.ex:77
#, elixir-autogen, elixir-format
msgid "Keep that connection open while approving your key in the browser,\n"
msgstr ""
"Gardez cette connexion ouverte pendant l’approbation de votre clé dans le "
"navigateur,\n"

#: lib/porsche/ssh/command_messages.ex:44
#, elixir-autogen, elixir-format
msgid "List a team's members."
msgstr "Lister les membres d’une équipe."

#: lib/porsche/ssh/command_messages.ex:29
#, elixir-autogen, elixir-format
msgid "List access grants."
msgstr "Lister les autorisations d’accès."

#: lib/porsche/ssh/command_messages.ex:7
#, elixir-autogen, elixir-format
msgid "List available images."
msgstr "Lister les images disponibles."

#: lib/porsche/ssh/command_messages.ex:8
#, elixir-autogen, elixir-format
msgid "List machines you can access."
msgstr "Lister les machines auxquelles vous avez accès."

#: lib/porsche/ssh/command_messages.ex:32
#, elixir-autogen, elixir-format
msgid "List your SSH keys."
msgstr "Lister vos clés SSH."

#: lib/porsche/ssh/command_messages.ex:38
#, elixir-autogen, elixir-format
msgid "List your integrations."
msgstr "Lister vos intégrations."

#: lib/porsche/ssh/command_messages.ex:43
#, elixir-autogen, elixir-format
msgid "List your teams and roles."
msgstr "Lister vos équipes et vos rôles."

#: lib/porsche/ssh/command_messages.ex:40
#, elixir-autogen, elixir-format
msgid "Make an integration available to a machine."
msgstr "Rendre une intégration disponible pour une machine."

#: lib/porsche/ssh/command_messages.ex:14
#, elixir-autogen, elixir-format
msgid "Move a machine to an automatically selected host."
msgstr "Déplacer une machine vers un hôte sélectionné automatiquement."

#: lib/porsche/ssh/command_messages.ex:47
#, elixir-autogen, elixir-format
msgid "Offer team ownership to an admin."
msgstr "Proposer la propriété de l’équipe à un administrateur."

#: lib/porsche/ssh/channel.ex:152
#, elixir-autogen, elixir-format
msgid "Porsche machine management. Type help."
msgstr "Gestion des machines Porsche. Tapez help."

#: lib/porsche/ssh/command_messages.ex:13
#, elixir-autogen, elixir-format
msgid "Queue an independent full-disk copy of a machine."
msgstr ""
"Mettre en file une copie indépendante du disque complet d’une machine."

#: lib/porsche/ssh/onboarding.ex:114
#, elixir-autogen, elixir-format
msgid "Register or check your SSH key in Overalls Account settings > SSH keys.\n\n"
msgstr ""
"Enregistrez ou vérifiez votre clé SSH dans les paramètres du compte Overalls > Clés SSH.\n"
"\n"

#: lib/porsche/ssh/onboarding.ex:110
#, elixir-autogen, elixir-format
msgid "Register or check your key by connecting to:\n  ssh "
msgstr ""
"Enregistrez ou vérifiez votre clé en vous connectant à :\n"
"  ssh "

#: lib/porsche/ssh/command_messages.ex:41
#, elixir-autogen, elixir-format
msgid "Remove a machine's explicit availability."
msgstr "Retirer la disponibilité explicite d’une machine."

#: lib/porsche/ssh/command_messages.ex:37
#, elixir-autogen, elixir-format
msgid "Remove a named integration."
msgstr "Supprimer une intégration nommée."

#: lib/porsche/ssh/command_messages.ex:46
#, elixir-autogen, elixir-format
msgid "Remove an account's membership."
msgstr "Retirer l’adhésion d’un compte."

#: lib/porsche/ssh/command_messages.ex:28
#, elixir-autogen, elixir-format
msgid "Remove your pin from a machine."
msgstr "Retirer votre épingle d’une machine."

#: lib/porsche/ssh/output.ex:349
#, elixir-autogen, elixir-format
msgid "Request %{id}: submitting"
msgstr "Demande %{id} : envoi en cours"

#: lib/porsche/ssh/output.ex:352
#, elixir-autogen, elixir-format
msgid "Request %{id}: waiting for completion"
msgstr "Demande %{id} : en attente de la fin"

#: lib/porsche/ssh/command_messages.ex:18
#, elixir-autogen, elixir-format
msgid "Retry a failed clone or relocation request."
msgstr "Réessayer une demande de clonage ou de déplacement échouée."

#: lib/porsche/ssh/command_messages.ex:31
#, elixir-autogen, elixir-format
msgid "Revoke an account's shared access."
msgstr "Révoquer l’accès partagé d’un compte."

#: lib/porsche/ssh/command_messages.ex:33
#, elixir-autogen, elixir-format
msgid "Revoke one of your SSH keys."
msgstr "Révoquer l’une de vos clés SSH."

#: lib/porsche/ssh/command_messages.ex:5
#, elixir-autogen, elixir-format
msgid "Show command help."
msgstr "Afficher l’aide des commandes."

#: lib/porsche/ssh/command_messages.ex:6
#, elixir-autogen, elixir-format
msgid "Show the authenticated account."
msgstr "Afficher le compte authentifié."

#: lib/porsche/ssh/command_messages.ex:20
#, elixir-autogen, elixir-format
msgid "Start a machine."
msgstr "Démarrer une machine."

#: lib/porsche/ssh/output.ex:297
#, elixir-autogen, elixir-format
msgid "The command could not be completed: %{reason}"
msgstr "La commande n’a pas pu être exécutée jusqu’au bout : %{reason}"

#: lib/porsche/ssh/output.ex:67
#, elixir-autogen, elixir-format
msgid "The requested resource could not be found."
msgstr "La ressource demandée est introuvable."

#: lib/porsche/ssh/output.ex:61
#, elixir-autogen, elixir-format
msgid "The service is temporarily unavailable. Please try again shortly."
msgstr "Le service est temporairement indisponible. Veuillez réessayer dans un instant."

#: lib/porsche/ssh/onboarding.ex:100
#, elixir-autogen, elixir-format
msgid "This SSH connection could not be authorized. Check your machine access and try again.\n\n"
msgstr "Cette connexion SSH n’a pas pu être autorisée. Vérifiez votre accès à la machine et réessayez.\n\n"

#: lib/porsche/ssh/output.ex:52
#, elixir-autogen, elixir-format
msgid "This connection is not authorized. Please sign in and try again."
msgstr "Cette connexion n’est pas autorisée. Connectez-vous et réessayez."

#: lib/porsche/ssh/output.ex:70
#, elixir-autogen, elixir-format
msgid "Unexpected input. Please open a new SSH connection."
msgstr "Entrée inattendue. Veuillez ouvrir une nouvelle connexion SSH."

#: lib/porsche/ssh/onboarding.ex:97
#, elixir-autogen, elixir-format
msgid "We couldn't verify this SSH key right now. Please try again shortly.\n\n"
msgstr "Nous n’avons pas pu vérifier cette clé SSH pour le moment. Veuillez réessayer dans un instant.\n\n"

#: lib/porsche/ssh/onboarding.ex:53
#, elixir-autogen, elixir-format
msgid "We don't recognize this SSH key:\n  "
msgstr "Nous ne reconnaissons pas cette clé SSH :\n  "

#: lib/porsche/ssh/onboarding.ex:86
#, elixir-autogen, elixir-format
msgid "Welcome to Overalls.\n\nThis connection needs the Overalls SSH configuration.\n\n"
msgstr "Bienvenue sur Overalls.\n\nCette connexion nécessite la configuration SSH d’Overalls.\n\n"

#: lib/porsche/ssh/output.ex:55
#, elixir-autogen, elixir-format
msgid "You do not have permission to perform this action."
msgstr "Vous n’avez pas l’autorisation d’effectuer cette action."

#: lib/porsche/ssh/onboarding.ex:121
#, elixir-autogen, elixir-format
msgid "from your machine's page and reconnect without root@.\n"
msgstr "depuis la page de votre machine et reconnectez-vous sans root@.\n"

#: lib/porsche/ssh/onboarding.ex:78
#, elixir-autogen, elixir-format
msgid "then retry your original command.\n"
msgstr "puis réessayez votre commande initiale.\n"

