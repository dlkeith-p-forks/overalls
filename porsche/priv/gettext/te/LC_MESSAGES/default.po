msgid ""
msgstr ""
"Language: te\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Porsche machine management. Type help."
msgstr "Porsche యంత్ర నిర్వహణ. help టైప్ చేయండి."

msgid "Docs:"
msgstr "పత్రాలు:"

msgid "Show command help."
msgstr "ఆదేశ సహాయాన్ని చూపించండి."

msgid "Show the authenticated account."
msgstr "ధృవీకరించబడిన ఖాతాను చూపించండి."

msgid "List available images."
msgstr "అందుబాటులో ఉన్న ఇమేజ్‌లను జాబితా చేయండి."

msgid "List machines you can access."
msgstr "మీరు యాక్సెస్ చేయగల యంత్రాలను జాబితా చేయండి."

msgid "Inspect a machine by name or UUID."
msgstr "పేరు లేదా UUID ద్వారా యంత్రాన్ని పరిశీలించండి."

msgid "Create a machine. Disk maximum: 500 GiB. --source clones a public GitHub, GitLab, Codeberg or Bitbucket repository in the guest."
msgstr "యంత్రాన్ని సృష్టించండి. డిస్క్ గరిష్ఠ పరిమాణం: 500 GiB. --source గెస్ట్‌లో పబ్లిక్ GitHub, GitLab, Codeberg లేదా Bitbucket రిపోజిటరీని క్లోన్ చేస్తుంది."

msgid "Queue an independent full-disk copy of a machine."
msgstr "యంత్రం మొత్తం డిస్క్ యొక్క స్వతంత్ర కాపీని వరుసలో ఉంచండి."

msgid "Move a machine to an automatically selected host."
msgstr "యంత్రాన్ని స్వయంచాలకంగా ఎంచుకున్న హోస్ట్‌కు తరలించండి."

msgid "Change a machine's CPU and memory; disk may only grow. A running machine stops and restarts."
msgstr "యంత్రం CPU మరియు మెమరీని మార్చండి; డిస్క్‌ను పెంచడం మాత్రమే సాధ్యం. నడుస్తున్న యంత్రం ఆగి తిరిగి ప్రారంభమవుతుంది."

msgid "Retry a failed clone or relocation request."
msgstr "విఫలమైన క్లోన్ లేదా తరలింపు అభ్యర్థనను మళ్లీ ప్రయత్నించండి."

msgid "Cancel an unpublished clone or uncommitted relocation request."
msgstr "ప్రచురించని క్లోన్ లేదా ఖరారు కాని తరలింపు అభ్యర్థనను రద్దు చేయండి."

msgid "Start a machine."
msgstr "యంత్రాన్ని ప్రారంభించండి."

msgid "Stop a machine, retaining its disk."
msgstr "డిస్క్‌ను ఉంచి యంత్రాన్ని ఆపండి."

msgid "Delete a machine and its disk. Refused while its owner has it pinned."
msgstr "యంత్రాన్ని, దాని డిస్క్‌ను తొలగించండి. యజమాని పిన్ చేసి ఉంచితే నిరాకరించబడుతుంది."

msgid "Pin a machine to the top of your lists. While you own it and it is pinned, nothing can delete it."
msgstr "యంత్రాన్ని మీ జాబితాల పైభాగంలో పిన్ చేయండి. మీరు యజమానిగా ఉండి అది పిన్ చేసి ఉన్నంతవరకు దానిని ఏదీ తొలగించలేదు."

msgid "Remove your pin from a machine."
msgstr "యంత్రంపై మీ పిన్‌ను తీసివేయండి."

msgid "List access grants."
msgstr "యాక్సెస్ అనుమతులను జాబితా చేయండి."

msgid "Grant viewer, operator or manager access."
msgstr "వీక్షకుడు, ఆపరేటర్ లేదా నిర్వాహకుడి యాక్సెస్ ఇవ్వండి."

msgid "Revoke an account's shared access."
msgstr "ఖాతా భాగస్వామ్య యాక్సెస్‌ను ఉపసంహరించండి."

msgid "List your SSH keys."
msgstr "మీ SSH కీలను జాబితా చేయండి."

msgid "Revoke one of your SSH keys."
msgstr "మీ SSH కీలలో ఒకదాన్ని ఉపసంహరించండి."

msgid "Create or replace a named integration at https://NAME.integration.internal."
msgstr "https://NAME.integration.internal వద్ద పేరుతో అనుసంధానాన్ని సృష్టించండి లేదా భర్తీ చేయండి."

msgid "Remove a named integration."
msgstr "పేరుతో ఉన్న అనుసంధానాన్ని తీసివేయండి."

msgid "List your integrations."
msgstr "మీ అనుసంధానాలను జాబితా చేయండి."

msgid "Inspect an integration without secrets."
msgstr "రహస్యాలు చూపకుండా అనుసంధానాన్ని పరిశీలించండి."

msgid "Make an integration available to a machine."
msgstr "యంత్రానికి అనుసంధానాన్ని అందుబాటులో ఉంచండి."

msgid "Remove a machine's explicit availability."
msgstr "యంత్రానికి ప్రత్యేకంగా ఇచ్చిన అందుబాటును తీసివేయండి."

msgid "Create a team you own."
msgstr "మీ యాజమాన్యంలో బృందాన్ని సృష్టించండి."

msgid "List your teams and roles."
msgstr "మీ బృందాలు, పాత్రలను జాబితా చేయండి."

msgid "List a team's members."
msgstr "బృంద సభ్యులను జాబితా చేయండి."

msgid "Add or change an admin or member."
msgstr "నిర్వాహకుడిని లేదా సభ్యుడిని జోడించండి లేదా మార్చండి."

msgid "Remove an account's membership."
msgstr "ఖాతా సభ్యత్వాన్ని తీసివేయండి."

msgid "Offer team ownership to an admin."
msgstr "నిర్వాహకుడికి బృంద యాజమాన్యాన్ని అందించే ప్రతిపాదన చేయండి."

msgid "Accept a pending ownership offer."
msgstr "పెండింగ్‌లో ఉన్న యాజమాన్య ప్రతిపాదనను అంగీకరించండి."

msgid "Decline a pending ownership offer."
msgstr "పెండింగ్‌లో ఉన్న యాజమాన్య ప్రతిపాదనను తిరస్కరించండి."

msgid "Cancel your pending ownership offer."
msgstr "మీ పెండింగ్ యాజమాన్య ప్రతిపాదనను రద్దు చేయండి."

msgid "Inspect a previously accepted request."
msgstr "గతంలో అంగీకరించిన అభ్యర్థనను పరిశీలించండి."

msgid "Close this interactive channel."
msgstr "ఈ పరస్పర సంభాషణ ఛానెల్‌ను మూసివేయండి."

msgid "We don't recognize this SSH key:\n  "
msgstr "ఈ SSH కీని మేము గుర్తించలేకపోయాము:\n  "

msgid "\nOpen this link, sign in, and approve the matching fingerprint:\n  "
msgstr "\nఈ లింక్ తెరిచి, సైన్ ఇన్ చేసి, సరిపోలే వేలిముద్రను ఆమోదించండి:\n  "

msgid "\n\nKeep this SSH connection open while approving the key.\n"
msgstr "\n\nకీని ఆమోదిస్తున్నప్పుడు ఈ SSH కనెక్షన్‌ను తెరిచి ఉంచండి.\n"

msgid "Approval links expire after %{minutes} minutes or when this connection closes.\n"
msgstr "ఆమోద లింక్‌లు %{minutes} నిమిషాల తర్వాత లేదా ఈ కనెక్షన్ మూసినప్పుడు గడువు ముగుస్తాయి.\n"

msgid "After approval, retry your command here.\n"
msgstr "ఆమోదం తర్వాత మీ ఆదేశాన్ని ఇక్కడ మళ్లీ ప్రయత్నించండి.\n"

msgid "\nOpen an interactive Porsche connection without a remote command:"
msgstr "\nరిమోట్ ఆదేశం లేకుండా పరస్పర Porsche కనెక్షన్‌ను తెరవండి:"

msgid "Keep that connection open while approving your key in the browser,\n"
msgstr "బ్రౌజర్‌లో మీ కీని ఆమోదిస్తున్నప్పుడు ఆ కనెక్షన్‌ను తెరిచి ఉంచండి,\n"

msgid "then retry your original command.\n"
msgstr "తర్వాత మీ అసలు ఆదేశాన్ని మళ్లీ ప్రయత్నించండి.\n"

msgid "Welcome to Overalls.\n\nThis connection needs the Overalls SSH configuration.\n\n"
msgstr "Overalls‌కు స్వాగతం.\n\nఈ కనెక్షన్‌కు Overalls SSH కాన్ఫిగరేషన్ అవసరం.\n\n"

msgid "We couldn't verify this SSH key right now. Please try again shortly.\n\n"
msgstr "ప్రస్తుతం ఈ SSH కీని ధృవీకరించలేకపోయాము. కొద్దిసేపట్లో మళ్లీ ప్రయత్నించండి.\n\n"

msgid "This SSH connection could not be authorized. Check your machine access and try again.\n\n"
msgstr "ఈ SSH కనెక్షన్‌కు అనుమతి ఇవ్వలేకపోయాము. మీ యంత్ర యాక్సెస్‌ను తనిఖీ చేసి మళ్లీ ప్రయత్నించండి.\n\n"

msgid "Register or check your key by connecting to:\n  ssh "
msgstr "ఇక్కడ కనెక్ట్ చేసి మీ కీని నమోదు చేయండి లేదా తనిఖీ చేయండి:\n  ssh "

msgid "\nOr manage your keys at:\n  "
msgstr "\nలేదా మీ కీలను ఇక్కడ నిర్వహించండి:\n  "

msgid "Register or check your SSH key in Overalls Account settings > SSH keys.\n\n"
msgstr "Overalls ఖాతా సెట్టింగ్‌లు > SSH కీలలో మీ SSH కీని నమోదు చేయండి లేదా తనిఖీ చేయండి.\n\n"

msgid "Follow the browser approval instructions, then run the setup command\n"
msgstr "బ్రౌజర్ ఆమోద సూచనలను అనుసరించి, ఆపై సెటప్ ఆదేశాన్ని అమలు చేయండి\n"

msgid "from your machine's page and reconnect without root@.\n"
msgstr "మీ యంత్రం పేజీ నుంచి తీసుకుని root@ లేకుండా తిరిగి కనెక్ట్ అవ్వండి.\n"

msgid "This connection is not authorized. Please sign in and try again."
msgstr "ఈ కనెక్షన్‌కు అనుమతి లేదు. సైన్ ఇన్ చేసి మళ్లీ ప్రయత్నించండి."

msgid "You do not have permission to perform this action."
msgstr "ఈ చర్య చేయడానికి మీకు అనుమతి లేదు."

msgid "Invalid command. Type help to see available commands."
msgstr "చెల్లని ఆదేశం. అందుబాటులో ఉన్న ఆదేశాల కోసం help టైప్ చేయండి."

msgid "The service is temporarily unavailable. Please try again shortly."
msgstr "సేవ తాత్కాలికంగా అందుబాటులో లేదు. కొద్దిసేపట్లో మళ్లీ ప్రయత్నించండి."

msgid "Approve this SSH key in your browser, then retry the command."
msgstr "బ్రౌజర్‌లో ఈ SSH కీని ఆమోదించి, తర్వాత ఆదేశాన్ని మళ్లీ ప్రయత్నించండి."

msgid "The requested resource could not be found."
msgstr "అభ్యర్థించిన వనరు కనుగొనబడలేదు."

msgid "Unexpected input. Please open a new SSH connection."
msgstr "ఊహించని ఇన్‌పుట్. కొత్త SSH కనెక్షన్‌ను తెరవండి."

msgid "The command could not be completed: %{reason}"
msgstr "ఆదేశాన్ని పూర్తి చేయలేకపోయాము: %{reason}"

msgid "Request %{id}: submitting"
msgstr "అభ్యర్థన %{id}: సమర్పిస్తోంది"

msgid "Request %{id}: waiting for completion"
msgstr "అభ్యర్థన %{id}: పూర్తయ్యే వరకు వేచి ఉంది"
