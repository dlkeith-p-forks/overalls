"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: lib/porsche/ssh/onboarding.ex:64
msgid "\n\nKeep this SSH connection open while approving the key.\n"
msgstr "\n\nAnahtarı onaylarken bu SSH bağlantısını açık tutun.\n"

#: lib/porsche/ssh/onboarding.ex:81
#, elixir-autogen, elixir-format
msgid "\nOpen an interactive Porsche connection without a remote command:"
msgstr "\nUzak komut olmadan etkileşimli bir Porsche bağlantısı açın:"

#: lib/porsche/ssh/onboarding.ex:59
#, elixir-autogen, elixir-format
msgid "\nOpen this link, sign in, and approve the matching fingerprint:\n  "
msgstr "\nBu bağlantıyı açın, giriş yapın ve eşleşen parmak izini onaylayın:\n  "

#: lib/porsche/ssh/onboarding.ex:126
#, elixir-autogen, elixir-format
msgid "\nOr manage your keys at:\n  "
msgstr "\nVeya anahtarlarınızı şuradan yönetin:\n  "

#: lib/porsche/ssh/onboarding.ex:70
#, elixir-autogen, elixir-format
msgid "After approval, retry your command here.\n"
msgstr "Onaydan sonra komutunuzu burada yeniden deneyin.\n"

#: lib/porsche/ssh/onboarding.ex:65
#, elixir-autogen, elixir-format
msgid "Approval links expire after %{minutes} minutes or when this connection closes.\n"
msgstr "Onay bağlantıları %{minutes} dakika sonra veya bu bağlantı kapandığında sona erer.\n"

#: lib/porsche/ssh/onboarding.ex:138
#, elixir-autogen, elixir-format
msgid "Follow the browser approval instructions, then run the setup command\n"
msgstr "Tarayıcıdaki onay talimatlarını izleyin, ardından kurulum komutunu çalıştırın\n"

#: lib/porsche/ssh/onboarding.ex:83
#, elixir-autogen, elixir-format
msgid "Keep that connection open while approving your key in the browser,\n"
msgstr "Anahtarınızı tarayıcıda onaylarken bu bağlantıyı açık tutun,\n"

#: lib/porsche/ssh/onboarding.ex:129
#, elixir-autogen, elixir-format
msgid "Register or check your SSH key in Overalls Account settings > SSH keys.\n\n"
msgstr "SSH anahtarınızı Overalls Hesap ayarları > SSH anahtarları bölümünde kaydedin veya kontrol edin.\n\n"

#: lib/porsche/ssh/onboarding.ex:124
#, elixir-autogen, elixir-format
msgid "Register or check your key by connecting to:\n  ssh "
msgstr "Şuraya bağlanarak anahtarınızı kaydedin veya kontrol edin:\n  ssh "

#: lib/porsche/ssh/onboarding.ex:113
#, elixir-autogen, elixir-format
msgid "This SSH connection could not be authorized. Check your machine access and try again.\n\n"
msgstr "Bu SSH bağlantısı yetkilendirilemedi. Makine erişiminizi kontrol edip yeniden deneyin.\n\n"

#: lib/porsche/ssh/onboarding.ex:107
#, elixir-autogen, elixir-format
msgid "We couldn't verify this SSH key right now. Please try again shortly.\n\n"
msgstr "Bu SSH anahtarını şu anda doğrulayamadık. Lütfen kısa bir süre sonra yeniden deneyin.\n\n"

#: lib/porsche/ssh/onboarding.ex:54
msgid "We don't recognize this SSH key:\n  "
msgstr "Bu SSH anahtarını tanımıyoruz:\n  "

#: lib/porsche/ssh/onboarding.ex:95
#, elixir-autogen, elixir-format
msgid "Welcome to Overalls.\n\nThis connection needs the Overalls SSH configuration.\n\n"
msgstr "Overalls'a hoş geldiniz.\n\nBu bağlantı için Overalls SSH yapılandırması gerekiyor.\n\n"

#: lib/porsche/ssh/onboarding.ex:142
#, elixir-autogen, elixir-format
msgid "from your machine's page and reconnect without root@.\n"
msgstr "makinenizin sayfasından alın ve root@ olmadan yeniden bağlanın.\n"

#: lib/porsche/ssh/onboarding.ex:87
#, elixir-autogen, elixir-format
msgid "then retry your original command.\n"
msgstr "ardından ilk komutunuzu yeniden deneyin.\n"
