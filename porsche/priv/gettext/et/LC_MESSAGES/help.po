#: lib/porsche/ssh/command_messages.ex:59
#, elixir-autogen, elixir-format
msgid "Accept a pending ownership offer."
msgstr "Võta ootel omandiõiguse pakkumine vastu."

#: lib/porsche/ssh/command_messages.ex:56
#, elixir-autogen, elixir-format
msgid "Add or change an admin or member."
msgstr "Lisa või muuda administraatorit või liiget."

#: lib/porsche/ssh/command_messages.ex:21
#, elixir-autogen, elixir-format
msgid "Cancel an unpublished clone or uncommitted relocation request."
msgstr "Tühista avaldamata kloonimis- või kinnitamata teisaldustaotlus."

#: lib/porsche/ssh/command_messages.ex:61
#, elixir-autogen, elixir-format
msgid "Cancel your pending ownership offer."
msgstr "Tühista oma ootel omandiõiguse pakkumine."

#: lib/porsche/ssh/command_messages.ex:16
#, elixir-autogen, elixir-format
msgid "Change a machine's CPU and memory; disk may only grow. A running machine stops and restarts."
msgstr "Muuda masina protsessorit ja mälu; ketast saab ainult suurendada. Töötav masin peatatakse ja käivitatakse uuesti."

#: lib/porsche/ssh/command_messages.ex:63
#, elixir-autogen, elixir-format
msgid "Close this interactive channel."
msgstr "Sulge see interaktiivne kanal."

#: lib/porsche/ssh/command_messages.ex:10
#, elixir-autogen, elixir-format
msgid "Create a machine. Disk maximum: 500 GiB. --source clones a public GitHub, GitLab, Codeberg or Bitbucket repository in the guest."
msgstr "Loo masin. Ketta ülempiir: 500 GiB. --source kloonib külalises avaliku GitHubi, GitLabi, Codebergi või Bitbucketi hoidla."

#: lib/porsche/ssh/command_messages.ex:53
#, elixir-autogen, elixir-format
msgid "Create a team you own."
msgstr "Loo endale kuuluv meeskond."

#: lib/porsche/ssh/command_messages.ex:44
#, elixir-autogen, elixir-format
msgid "Create or replace a named integration at https://NAME.integration.internal."
msgstr "Loo või asenda nimega integratsioon aadressil https://NAME.integration.internal."

#: lib/porsche/ssh/command_messages.ex:60
#, elixir-autogen, elixir-format
msgid "Decline a pending ownership offer."
msgstr "Lükka ootel omandiõiguse pakkumine tagasi."

#: lib/porsche/ssh/command_messages.ex:30
#, elixir-autogen, elixir-format
msgid "Delete a machine and its disk. Refused while its owner has it pinned."
msgstr "Kustuta masin ja selle ketas. Keeldutakse, kui omanik on masina kinnitanud."

#: lib/porsche/ssh/command_messages.ex:40
#, elixir-autogen, elixir-format
msgid "Grant viewer, operator or manager access."
msgstr "Anna vaataja, operaatori või halduri juurdepääs."

#: lib/porsche/ssh/command_messages.ex:9
#, elixir-autogen, elixir-format
msgid "Inspect a machine by name or UUID."
msgstr "Vaata masinat nime või UUID järgi."

#: lib/porsche/ssh/command_messages.ex:62
#, elixir-autogen, elixir-format
msgid "Inspect a previously accepted request."
msgstr "Vaata varem vastu võetud taotlust."

#: lib/porsche/ssh/command_messages.ex:50
#, elixir-autogen, elixir-format
msgid "Inspect an integration without secrets."
msgstr "Vaata integratsiooni ilma saladusteta."

#: lib/porsche/ssh/command_messages.ex:55
#, elixir-autogen, elixir-format
msgid "List a team's members."
msgstr "Loetle meeskonna liikmed."

#: lib/porsche/ssh/command_messages.ex:39
#, elixir-autogen, elixir-format
msgid "List access grants."
msgstr "Loetle antud juurdepääsuõigused."

#: lib/porsche/ssh/command_messages.ex:7
#, elixir-autogen, elixir-format
msgid "List available images."
msgstr "Loetle saadaolevad tõmmised."

#: lib/porsche/ssh/command_messages.ex:8
#, elixir-autogen, elixir-format
msgid "List machines you can access."
msgstr "Loetle masinad, millele sul on juurdepääs."

#: lib/porsche/ssh/command_messages.ex:42
#, elixir-autogen, elixir-format
msgid "List your SSH keys."
msgstr "Loetle oma SSH-võtmed."

#: lib/porsche/ssh/command_messages.ex:49
#, elixir-autogen, elixir-format
msgid "List your integrations."
msgstr "Loetle oma integratsioonid."

#: lib/porsche/ssh/command_messages.ex:54
#, elixir-autogen, elixir-format
msgid "List your teams and roles."
msgstr "Loetle oma meeskonnad ja rollid."

#: lib/porsche/ssh/command_messages.ex:51
#, elixir-autogen, elixir-format
msgid "Make an integration available to a machine."
msgstr "Muuda integratsioon masinale kättesaadavaks."

#: lib/porsche/ssh/command_messages.ex:15
#, elixir-autogen, elixir-format
msgid "Move a machine to an automatically selected host."
msgstr "Teisalda masin automaatselt valitud hosti."

#: lib/porsche/ssh/command_messages.ex:58
#, elixir-autogen, elixir-format
msgid "Offer team ownership to an admin."
msgstr "Paku meeskonna omandiõigust administraatorile."

# Reviewed English fallback pending translation of suspension behavior.
#: lib/porsche/ssh/command_messages.ex:34
msgid "Pin a machine to the top of your lists. Your owner pin wakes it, prevents automatic suspension, and prevents deletion."
msgstr "Kinnita masin oma loendite algusesse. Omanikuna kinnitamine äratab masina ning takistab automaatset uinutamist ja kustutamist."

#: lib/porsche/ssh/command_messages.ex:14
#, elixir-autogen, elixir-format
msgid "Queue an independent full-disk copy of a machine."
msgstr "Lisa järjekorda masina kogu ketta sõltumatu koopia."

#: lib/porsche/ssh/command_messages.ex:52
#, elixir-autogen, elixir-format
msgid "Remove a machine's explicit availability."
msgstr "Eemalda masinale sõnaselgelt antud kättesaadavus."

#: lib/porsche/ssh/command_messages.ex:48
#, elixir-autogen, elixir-format
msgid "Remove a named integration."
msgstr "Eemalda nimega integratsioon."

#: lib/porsche/ssh/command_messages.ex:57
#, elixir-autogen, elixir-format
msgid "Remove an account's membership."
msgstr "Eemalda konto liikmesus."

#: lib/porsche/ssh/command_messages.ex:38
#, elixir-autogen, elixir-format
msgid "Remove your pin from a machine."
msgstr "Eemalda masina kinnitus."

# Reviewed English fallback pending translation of suspension behavior.
#: lib/porsche/ssh/command_messages.ex:69
msgid "Resume a suspended machine's preserved memory."
msgstr "Jätka uinutatud masina tööd säilitatud mälust."

# Reviewed English fallback pending translation of suspension behavior.
#: lib/porsche/ssh/command_messages.ex:65
msgid "Resume preserved memory, waiting for capacity or relocation."
msgstr "Jätka tööd säilitatud mälust, oodates vaba mahtu või ümberpaigutamist."

#: lib/porsche/ssh/command_messages.ex:20
msgid "Retry a failed clone or relocation request."
msgstr "Proovi nurjunud kloonimis- või teisaldustaotlust uuesti."

#: lib/porsche/ssh/command_messages.ex:41
msgid "Revoke an account's shared access."
msgstr "Tühista konto jagatud juurdepääs."

#: lib/porsche/ssh/command_messages.ex:43
msgid "Revoke one of your SSH keys."
msgstr "Tühista üks oma SSH-võtmetest."

#: lib/porsche/ssh/command_messages.ex:5
msgid "Show command help."
msgstr "Kuva käskude abi."

#: lib/porsche/ssh/command_messages.ex:6
msgid "Show the authenticated account."
msgstr "Kuva autenditud konto."

#: lib/porsche/ssh/command_messages.ex:25
msgid "Start a machine."
msgstr "Käivita masin."

# Reviewed English fallback pending translation of suspension behavior.
#: lib/porsche/ssh/command_messages.ex:26
msgid "Stop a machine, retaining its disk and discarding suspended memory."
msgstr "Seiska masin, säilitades ketta ja eemaldades uinutamisel salvestatud mälu."

# Reviewed English fallback pending translation of suspension behavior.
#: lib/porsche/ssh/command_messages.ex:64
msgid "Suspend a machine, preserving its memory and disk."
msgstr "Uinuta masin, säilitades mälu ja ketta."