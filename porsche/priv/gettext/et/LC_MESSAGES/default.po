#, elixir-autogen, elixir-format
msgid "This clone request cannot be retried in its current state."
msgstr "Seda kloonimistaotlust ei saa praeguses olekus uuesti proovida."

#: lib/porsche/ssh/output.ex:231
#, elixir-autogen, elixir-format
msgid "This connection requires verified HTTPS. Contact your operator."
msgstr "See ühendus nõuab kontrollitud HTTPS-i. Võtke ühendust operaatoriga."

#: lib/porsche/ssh/output.ex:178
#, elixir-autogen, elixir-format
msgid "This machine has been deleted."
msgstr "See masin on kustutatud."

#: lib/porsche/ssh/output.ex:193
#, elixir-autogen, elixir-format
msgid "This machine has reached its execution generation limit. Contact your operator."
msgstr "See masin on saavutanud käituspõlvkonna piiri. Võtke ühendust operaatoriga."

#: lib/porsche/ssh/output.ex:136
#, elixir-autogen, elixir-format
msgid "This machine name is unavailable. Choose another name."
msgstr "See masinanimi pole saadaval. Valige teine nimi."

#: lib/porsche/ssh/output.ex:130
#, elixir-autogen, elixir-format
msgid "This relocation cannot be retried in its current state."
msgstr "Seda ümberpaigutamist ei saa praeguses olekus uuesti proovida."

#: lib/porsche/ssh/output.ex:127
#, elixir-autogen, elixir-format
msgid "This relocation has already finished."
msgstr "See ümberpaigutamine on juba lõppenud."

#: lib/porsche/ssh/output.ex:124
#, elixir-autogen, elixir-format
msgid "This relocation has committed its handoff and can no longer be cancelled."
msgstr "Selle ümberpaigutamise üleandmine on kinnitatud ning seda ei saa enam tühistada."

#: lib/porsche/ssh/output.ex:97
#, elixir-autogen, elixir-format
msgid "This request ID was already used for a different command. Use the original command or a new request ID."
msgstr "Seda taotluse ID-d on juba kasutatud teise käsu jaoks. Kasutage algset käsku või uut taotluse ID-d."

#: lib/porsche/ssh/output.ex:214
#, elixir-autogen, elixir-format
msgid "This resize request cannot be cancelled in its current state."
msgstr "Seda suuruse muutmise taotlust ei saa praeguses olekus tühistada."

#: lib/porsche/ssh/output.ex:211
#, elixir-autogen, elixir-format
msgid "This resize request cannot be retried in its current state."
msgstr "Seda suuruse muutmise taotlust ei saa praeguses olekus uuesti proovida."

#: lib/porsche/ssh/output.ex:150
#, elixir-autogen, elixir-format
msgid "Too many sessions or approval requests are active. Close an unused connection and try again."
msgstr "Aktiivseid seansse või heakskiidutaotlusi on liiga palju. Sulgege kasutamata ühendus ja proovige uuesti."

#: lib/porsche/ssh/output.ex:79
#, elixir-autogen, elixir-format
msgid "You already hold the maximum number of pins; unpin one first."
msgstr "Teil on juba maksimaalne arv kinnitusi; eemaldage esmalt üks."

#: lib/porsche/ssh/command_messages.ex:75
#, elixir-autogen, elixir-format
msgid "Register this device for push notifications. The push key is read from stdin."
msgstr "Registreeri see seade tõuketeavituste jaoks. Tõukevõti loetakse stdin-ist."

#: lib/porsche/ssh/command_messages.ex:78
#, elixir-autogen, elixir-format
msgid "List your push notification devices."
msgstr "Loetle oma tõuketeavituste seadmed."

#: lib/porsche/ssh/command_messages.ex:79
#, elixir-autogen, elixir-format
msgid "Revoke a push notification device."
msgstr "Tühista tõuketeavituste seade."

#: lib/porsche/ssh/command_messages.ex:80
#, elixir-autogen, elixir-format
msgid "Turn push notifications on or off for one device."
msgstr "Lülita ühe seadme tõuketeavitused sisse või välja."

#: lib/porsche/ssh/command_messages.ex:81
#, elixir-autogen, elixir-format
msgid "Attach this SSH terminal to a shared terminal session; needs ssh -t."
msgstr "Ühendab selle SSH-terminali jagatud terminaliseansiga; vajab ssh -t."

#: lib/porsche/ssh/output.ex:245
#, elixir-autogen, elixir-format
msgid "terminal attach needs a terminal. Connect with ssh -t and run it as the command."
msgstr "terminal attach vajab terminali. Ühenda ssh -t abil ja käivita see käsuna."

#: lib/porsche/ssh/command_messages.ex:56
#, elixir-autogen, elixir-format
msgid "List agent threads you can read, with unread counts."
msgstr "Loetle agendi lõimed, mida saad lugeda, koos lugemata kirjete arvuga."

#: lib/porsche/ssh/command_messages.ex:57
#, elixir-autogen, elixir-format
msgid "Inspect a thread, its pending question and latest plan."
msgstr "Vaata lõime, selle ootel küsimust ja uusimat plaani."

#: lib/porsche/ssh/command_messages.ex:58
#, elixir-autogen, elixir-format
msgid "List a thread's transcript events after a sequence number."
msgstr "Loetle lõime transkriptsiooni sündmused pärast järjenumbrit."

#: lib/porsche/ssh/command_messages.ex:59
#, elixir-autogen, elixir-format
msgid "Send a prompt read from standard input to a thread."
msgstr "Saada lõimele standardsisendist loetud viip."

#: lib/porsche/ssh/command_messages.ex:60
#, elixir-autogen, elixir-format
msgid "Answer a thread's pending question with JSON read from standard input."
msgstr "Vasta lõime ootel küsimusele standardsisendist loetud JSON-iga."

#: lib/porsche/ssh/command_messages.ex:63
#, elixir-autogen, elixir-format
msgid "Approve a thread's latest plan and start implementing it."
msgstr "Kinnita lõime uusim plaan ja alusta selle elluviimist."

#: lib/porsche/ssh/command_messages.ex:64
#, elixir-autogen, elixir-format
msgid "Ask for a revised plan, reading the feedback from standard input."
msgstr "Küsi muudetud plaani, lugedes tagasiside standardsisendist."

#: lib/porsche/ssh/command_messages.ex:65
#, elixir-autogen, elixir-format
msgid "Switch a thread between plan and work collaboration."
msgstr "Lülita lõim plan- ja work-koostöö vahel."

#: lib/porsche/ssh/command_messages.ex:66
#, elixir-autogen, elixir-format
msgid "Mark a thread read up to a transcript sequence number."
msgstr "Märgi lõim loetuks kuni transkriptsiooni järjenumbrini."

#: lib/porsche/ssh/command_messages.ex:67
#, elixir-autogen, elixir-format
msgid "List a machine's terminal sessions you can open."
msgstr "Loetle masina terminaliseansid, mida saad avada."

#: lib/porsche/ssh/command_messages.ex:68
#, elixir-autogen, elixir-format
msgid "Open your personal terminal session on a machine."
msgstr "Ava masinas oma isiklik terminaliseanss."

#: lib/porsche/ssh/command_messages.ex:69
#, elixir-autogen, elixir-format
msgid "Close one of your terminal sessions on a machine."
msgstr "Sulge üks oma terminaliseanssidest masinas."

#: lib/porsche/ssh/command_messages.ex:70
#, elixir-autogen, elixir-format
msgid "Show a machine's web endpoint, port and visibility."
msgstr "Näita masina veebi lõpp-punkti, porti ja nähtavust."

#: lib/porsche/ssh/command_messages.ex:71
#, elixir-autogen, elixir-format
msgid "Change a machine's web port or visibility, optionally at an expected revision."
msgstr "Muuda masina veebiporti või nähtavust, valikuliselt oodatud redaktsiooni juures."

#: lib/porsche/ssh/command_messages.ex:74
#, elixir-autogen, elixir-format
msgid "Stream JSON change notices for machines, threads and this session."
msgstr "Edasta voona JSON-muudatusteateid masinate, lõimede ja selle seansi kohta."

#: lib/porsche/ssh/output.ex:250
#, elixir-autogen, elixir-format
msgid "This thread is not ready for prompts yet."
msgstr "See lõim pole veel viipade jaoks valmis."

#: lib/porsche/ssh/output.ex:253
#, elixir-autogen, elixir-format
msgid "This thread is busy with a turn. Try again when it finishes."
msgstr "See lõim on käigu tõttu hõivatud. Proovi uuesti, kui see lõpeb."

#: lib/porsche/ssh/output.ex:256
#, elixir-autogen, elixir-format
msgid "That plan is no longer the latest proposal. Show the thread again."
msgstr "See plaan pole enam uusim ettepanek. Näita lõime uuesti."

#: lib/porsche/ssh/output.ex:259
#, elixir-autogen, elixir-format
msgid "That question is no longer pending."
msgstr "See küsimus pole enam ootel."

#: lib/porsche/ssh/output.ex:262
#, elixir-autogen, elixir-format
msgid "That question has already been answered."
msgstr "Sellele küsimusele on juba vastatud."

#: lib/porsche/ssh/output.ex:265
#, elixir-autogen, elixir-format
msgid "The answers do not match the pending question."
msgstr "Vastused ei vasta ootel küsimusele."

#: lib/porsche/ssh/output.ex:268
#, elixir-autogen, elixir-format
msgid "Answer the pending question before sending another prompt."
msgstr "Vasta ootel küsimusele enne uue viiba saatmist."

#: lib/porsche/ssh/output.ex:271
#, elixir-autogen, elixir-format
msgid "The web settings changed since you read them. Show them again and retry."
msgstr "Veebiseaded on pärast nende lugemist muutunud. Näita neid uuesti ja proovi siis uuesti."

#: lib/porsche/ssh/output.ex:274
#, elixir-autogen, elixir-format
msgid "Port 4444 is reserved for the editor."
msgstr "Port 4444 on reserveeritud redaktori jaoks."

#: lib/porsche/ssh/output.ex:277
#, elixir-autogen, elixir-format
msgid "This machine's profile does not allow web publishing."
msgstr "Selle masina profiil ei luba veebis avaldamist."

#: lib/porsche/ssh/output.ex:280
#, elixir-autogen, elixir-format
msgid "Terminals are unavailable on this machine right now."
msgstr "Terminalid pole selles masinas praegu saadaval."

#: lib/porsche/ssh/output.ex:283
#, elixir-autogen, elixir-format
msgid "The machine is waking. Retry the terminal shortly."
msgstr "Masin ärkab. Proovi terminali varsti uuesti."

#: lib/porsche/ssh/output.ex:286
#, elixir-autogen, elixir-format
msgid "That terminal session no longer exists."
msgstr "Seda terminaliseanssi pole enam olemas."

#: lib/porsche/ssh/output.ex:289
#, elixir-autogen, elixir-format
msgid "This command reads its input from standard input. Pipe it in and end the command with -."
msgstr "See käsk loeb sisendi standardsisendist. Suuna see torusse ja lõpeta käsk märgiga -."

#: lib/porsche/ssh/output.ex:294
#, elixir-autogen, elixir-format
msgid "The standard input is empty or exceeds this command's size limit."
msgstr "Standardsisend on tühi või ületab selle käsu suurusepiirangu."
