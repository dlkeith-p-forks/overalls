#, elixir-autogen, elixir-format
msgid "There is not enough available capacity for this request."
msgstr "没有足够的可用容量来处理此请求。"

#: lib/porsche/ssh/output.ex:196
#, elixir-autogen, elixir-format
msgid "This action cannot remove the owner's protected access."
msgstr "此操作无法移除所有者受保护的访问权限。"

#: lib/porsche/ssh/output.ex:88
