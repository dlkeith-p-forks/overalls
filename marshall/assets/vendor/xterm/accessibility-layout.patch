+  private _alignRowWidths(elements: HTMLElement[]): void {
+    // Complete DOM writes before measuring so one row cannot invalidate the
+    // geometry cache used by the next row. Retain each row's natural width.
+    for (const element of elements) {
+      element.style.transform = '';
+    }
+    const widths = elements.map(element => element.getBoundingClientRect().width);
+    for (let i = 0; i < elements.length; i++) {
+      const element = elements[i];
+      const lastColumn = this._rowColumns.get(element)?.slice(-1)?.[0];
+      if (!lastColumn) {
+        continue;
+      }
+      const targetWidth = lastColumn * this._renderService.dimensions.css.cell.width;
+      element.style.transform = `scaleX(${targetWidth / widths[i]})`;
+    }
   }
