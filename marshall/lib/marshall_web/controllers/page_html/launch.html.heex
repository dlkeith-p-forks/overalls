<%!-- Hidden until the script finds a repository fragment; every other visit is
      redirected before anything is painted, so signed-in visits to / do not
      flash this capture page. --%>
<div id="repository-launch-page" class="public-page" hidden>
  <Layouts.console_header />
  <main id="main-content" class="auth-shell">
    <section
      id="repository-launch-entry"
      class="auth-panel"
      data-idle-to={@idle_to}
      aria-live="polite"
    >
      <h1 class="ident">{gettext("Preparing your repository…")}</h1>
      <p class="muted">{gettext("Sign in if needed, then Overalls will create your machine.")}</p>
      <.form for={%{}} id="repository-launch-capture" action={~p"/launch/pending"} method="post">
        <input type="hidden" name="source" id="repository-launch-source" />
        <input type="hidden" name="visit" id="repository-launch-visit" />
      </.form>
    </section>
  </main>
</div>
<noscript>
  <div class="public-page">
    <p>
      {gettext("Enable JavaScript to open a repository link, or")} <a href={@idle_to}>{gettext("continue to Overalls")}</a>.
    </p>
  </div>
</noscript>
