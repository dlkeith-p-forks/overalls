#: lib/marshall/documentation_messages.ex:4537
#, elixir-autogen, elixir-format
msgid ""
"Boundary: Guest terminald local session and atomic ring reservations; "
"authenticated upstream authority remains separate."
msgstr ""

#: lib/marshall/documentation_messages.ex:4541
#, elixir-autogen, elixir-format
msgid ""
"Boundary: Guest terminald owns raw scrollback and frame prefix parsing; boot"
