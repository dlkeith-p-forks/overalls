#: lib/marshall/documentation_messages.ex:7507
#, elixir-autogen, elixir-format
msgid ""
"Required refusal: Invalid and forbidden command outcomes stay outside the "
"denominator; ordinary Porsche UID cannot connect to the collector socket; "
"command text, sessions and receipts never become labels."
msgstr ""

#: lib/marshall/documentation_messages.ex:7511
#, elixir-autogen, elixir-format
msgid ""
"Required refusal: Invalid certificate/key material fails the listener child "
"with exact invalid_configuration; expected supervisor/listener attempts "
"never reach daemon/status/observability and leave no serving state."
msgstr ""

#: lib/marshall/documentation_messages.ex:7515
#, elixir-autogen, elixir-format
msgid ""
"Required refusal: Invalid files, required fields, bind types, ports, paths, "
"token contents, missing certificate/key references and non-directory state "
"return exact invalid_configuration and the catalogued rejection before "
"reviewed serving calls."
msgstr ""

#: lib/marshall/documentation_messages.ex:7519
#, elixir-autogen, elixir-format
msgid ""
"Required refusal: Invalid keys, unsupported versions and unknown session "
"credentials preserve exact closed refusal names."
msgstr ""

#: lib/marshall/documentation_messages.ex:7523
#, elixir-autogen, elixir-format
msgid ""
"Required refusal: Invalid or rejected admission cannot add a successful "
"outcome; duplicate completion cannot count again; ordinary Ziggy UID cannot "
