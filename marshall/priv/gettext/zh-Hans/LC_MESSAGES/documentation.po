msgstr ""

#: lib/marshall/documentation_messages.ex:7383
#, elixir-autogen, elixir-format
msgid ""
"Required refusal: Anonymous Grafana queries, reader credentials on insert "
"paths and unprivileged credential reads refuse. Marshall has no diagnostic "
"reader credential or query path."
msgstr ""

#: lib/marshall/documentation_messages.ex:7387
#, elixir-autogen, elixir-format
