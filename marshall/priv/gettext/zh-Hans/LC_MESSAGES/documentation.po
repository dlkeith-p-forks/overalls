#: lib/marshall/documentation_messages.ex:7611
#, elixir-autogen, elixir-format
msgid ""
"Required refusal: Old peer owners must terminate after budget death. The "
"replacement starts empty and admits exactly the requested replacement pairs "
"while the synthetic host stream remains alive."
msgstr ""

#: lib/marshall/documentation_messages.ex:7615
#, elixir-autogen, elixir-format
msgid ""
"Required refusal: One request beyond the advertised integer1..256 limit is "
"refused as busy without wire dispatch; missing or invalid limits use eight."
