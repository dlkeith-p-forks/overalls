#: lib/marshall/documentation_messages.ex:7655
#, elixir-autogen, elixir-format
msgid ""
"Required refusal: Refuse anonymous visitors with a sign-in redirect; answer "
"404 on /settings/profile, /settings/security and /settings/ssh-keys; refuse "
