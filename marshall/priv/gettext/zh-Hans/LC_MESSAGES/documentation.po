msgstr ""

#: lib/marshall/documentation_messages.ex:7379
#, elixir-autogen, elixir-format
msgid ""
"Required refusal: An unknown agent set string, a workspace source version 2 "
"on an agentless manifest or a ninth manifest key is refused by the protocol;"
