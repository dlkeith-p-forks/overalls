msgstr ""

#: lib/marshall/documentation_messages.ex:7483
#, elixir-autogen, elixir-format
msgid ""
"Required refusal: Full ring budget refuses new sessions without changing "
"survivor identities or retaining unreserved backing; retirement releases "
"backing before replacement growth."
msgstr ""

#: lib/marshall/documentation_messages.ex:7487
#, elixir-autogen, elixir-format
msgid ""
"Required refusal: GET and digest URLs cannot approve/authenticate; stale "
"sharing or browser login refuses approval. Existing CLI requests refuse "
"withdrawn write access, retired account, deleted VM, expiry, foreign IDs or "
"changed request payload. Browser sign-out alone does not revoke an "
