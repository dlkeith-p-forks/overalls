#: lib/marshall/documentation_messages.ex:4585
#, elixir-autogen, elixir-format
msgid ""
"Boundary: Lilly-resolved attribution and a terminal Brady outcome enter "
"fixed cumulative counters; a private file is checked by a Rust host exporter"
" before separate local OTLP collection."
msgstr ""

#: lib/marshall/documentation_messages.ex:4589
#, elixir-autogen, elixir-format
msgid ""
"Boundary: Live stored login and five-minute passkey elevation gate "
