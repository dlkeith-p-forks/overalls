msgstr ""

#: lib/marshall/documentation_messages.ex:4605
#, elixir-autogen, elixir-format
msgid ""
"Boundary: Marshall Editor owns single-use account login and renewable "
"current-write execution/release leases; DNS and generic web policy cannot "
