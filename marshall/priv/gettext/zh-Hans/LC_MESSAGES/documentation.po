msgstr ""

#: lib/marshall/documentation_messages.ex:7491
#, elixir-autogen, elixir-format
msgid ""
"Required refusal: Health probes and early machine-API refusals do not enter "
"the denominator; request paths, credentials and user identity cannot become "
"labels; the exporter cannot replace the source snapshot through directory "
"permissions, and ordinary Marshall UID lacks direct collector socket group "
