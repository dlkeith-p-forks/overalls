#: lib/marshall/documentation_messages.ex:7399
#, elixir-autogen, elixir-format
msgid ""
"Required refusal: Before-submission loss must fail that generation without "
"launch; after-submission loss must preserve the exact native VMM. Reopens "
"cannot replace original outcome identity or unrelated guests."
msgstr ""

#: lib/marshall/documentation_messages.ex:7403
#, elixir-autogen, elixir-format
msgid ""
"Required refusal: Candidate spawn failure or unsuccessful registration "
"restores the predecessor; a stale executor cannot retain authority. No "
"semantic rollback is provided after registration."
msgstr ""

#: lib/marshall/documentation_messages.ex:7407
#, elixir-autogen, elixir-format
msgid ""
"Required refusal: Close a live response after access becomes private; expire"
