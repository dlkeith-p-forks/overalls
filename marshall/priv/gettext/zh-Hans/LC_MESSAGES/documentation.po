#: lib/marshall/documentation_messages.ex:4577
#, elixir-autogen, elixir-format
msgid ""
"Boundary: Kernel flow label, current execution proof, verified origin and "
"fail-closed proxy path."
msgstr ""

#: lib/marshall/documentation_messages.ex:4581
#, elixir-autogen, elixir-format
msgid ""
"Boundary: Lilly owns each linked/monitored opening worker; worker death "
"cannot occupy an attempt forever or confer stream readiness, and abrupt "
"stream-owner death retires its worker."
