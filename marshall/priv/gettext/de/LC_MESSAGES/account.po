msgstr "Passkeyname"

#: lib/marshall_web/live/account_live.ex:148
#, elixir-autogen, elixir-format
msgid "Passkey request cancelled or unavailable. You can try again."
msgstr ""
"Passkeyanfrage abgebrochen oder nicht verfügbar. Sie können es erneut "
"versuchen."

#: lib/marshall_web/live/account_live.ex:103
#, elixir-autogen, elixir-format
msgid "Passkey verified for 15 minutes."
msgstr "Passkey für 15 Minuten verifiziert."

#: lib/marshall_web/live/account_live.ex:606
#, elixir-autogen, elixir-format
