msgid_plural "Passkey verified · %{count} seconds remaining."
msgstr[0] "Passkey verifiziert · %{count} Sekunde verbleibt."
msgstr[1] "Passkey verifiziert · %{count} Sekunden verbleiben."

#: lib/marshall_web/live/account_live.ex:789
#, elixir-autogen, elixir-format
msgid "Paste a public key from your .pub file. Never paste a private key."
msgstr ""
"Fügen Sie einen öffentlichen Schlüssel aus Ihrer .pub-Datei ein. Niemals "
"einen privaten Schlüssel einfügen."

