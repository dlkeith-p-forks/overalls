msgstr "Dieser Schlüssel konnte nicht entfernt werden."

#: lib/marshall_web/live/account_live.ex:191
#, elixir-autogen, elixir-format
msgid "Could not rename this key. Use at most 128 characters."
msgstr "Dieser Schlüssel konnte nicht umbenannt werden. Verwende höchstens 128 Zeichen."

#: lib/marshall_web/live/account_live.ex:134
#, elixir-autogen, elixir-format
msgid "Credential change refused. Names must be 1–80 characters, changes need a passkey verified in the last 15 minutes, and administrators must keep at least one passkey."
msgstr ""
"Änderung der Anmeldedaten verweigert. Namen müssen 1–80 Zeichen lang sein, "
"Änderungen erfordern einen in den letzten 15 Minuten verifizierten Passkey "
"und Administratoren müssen mindestens einen Passkey behalten."

#: lib/marshall_web/live/account_live.ex:757
#, elixir-autogen, elixir-format
msgid "Description"
msgstr "Beschreibung"

#: lib/marshall_web/live/account_live.ex:451
#, elixir-autogen, elixir-format
msgid "Detected from your browser: %{value1}. Save it so others can see your local time."
msgstr ""
"Von Ihrem Browser erkannt: %{value1}. Speichern Sie dies, damit andere Ihre "
"Ortszeit sehen können."

#: lib/marshall_web/live/account_live.ex:544
#, elixir-autogen, elixir-format
msgid "Email"
msgstr "E-Mail"

#: lib/marshall_web/live/account_live.ex:651
#, elixir-autogen, elixir-format
msgid "End this verification before the fifteen minutes are up."
msgstr "Beenden Sie diese Verifizierung vor Ablauf der fünfzehn Minuten."

#: lib/marshall_web/live/account_live.ex:274
#, elixir-autogen, elixir-format
msgid "Enter a valid Git name and email address."
msgstr "Geben Sie einen gültigen Git-Namen und eine gültige E-Mail-Adresse ein."

#: lib/marshall_web/live/account_live.ex:763
#, elixir-autogen, elixir-format
msgid "Fingerprint"
msgstr "Fingerabdruck"

#: lib/marshall_web/live/account_live.ex:820
#, elixir-autogen, elixir-format
msgid "Git email"
msgstr "Git-E-Mail-Adresse"

#: lib/marshall_web/live/account_live.ex:508
#, elixir-autogen, elixir-format
msgid "Git identity"
msgstr "Git-Identität"

#: lib/marshall_web/live/account_live.ex:267
#, elixir-autogen, elixir-format
msgid "Git settings saved."
msgstr "Git-Einstellungen gespeichert."

#: lib/marshall_web/live/account_live.ex:813
