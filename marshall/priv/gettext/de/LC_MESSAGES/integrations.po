#: lib/marshall_web/live/integrations_live.ex:423
#, elixir-autogen, elixir-format
msgid "Name the endpoint and point it at an HTTPS API, or mark it as a peer connection to another machine. Secrets are write-only: they are stored for injection and never shown again."
msgstr ""
"Benennen Sie den Endpunkt und verweisen Sie ihn auf eine HTTPS-API oder "
"kennzeichnen Sie ihn als Peer-Verbindung zu einer anderen Maschine. "
"Geheimnisse sind nur schreibbar: Sie werden zur Injektion gespeichert und "
"niemals erneut angezeigt."

#: lib/marshall_web/live/integrations_live.ex:219
#, elixir-autogen, elixir-format
msgid "Named endpoints your machines reach at https://NAME.integration.internal. Credentials are injected at the edge and are never readable from a machine."
msgstr ""
"Benannte Endpunkte, die Ihre Maschinen unter "
"https://NAME.integration.internal erreichen. Anmeldedaten werden am Netzrand"
" injiziert und sind auf einer Maschine niemals lesbar."

#: lib/marshall_web/live/integrations_live.ex:360
#, elixir-autogen, elixir-format
msgid "No explicit attachments. Current team members' machines have access."
msgstr ""
"Keine ausdrücklichen Zuordnungen. Maschinen aktueller Teammitglieder haben "
"Zugriff."

#: lib/marshall_web/live/integrations_live.ex:347
#, elixir-autogen, elixir-format
msgid "No injected headers."
msgstr "Keine injizierten Header."

#: lib/marshall_web/live/integrations_live.ex:295
#, elixir-autogen, elixir-format
msgid "No integrations yet. Add one below to give your machines a named connection to an API or to another machine."
msgstr ""
"Noch keine Integrationen. Fügen Sie unten eine hinzu, um Ihren Maschinen "
"eine benannte Verbindung zu einer API oder einer anderen Maschine zu geben."

#: lib/marshall_web/live/integrations_live.ex:365
#, elixir-autogen, elixir-format
msgid "No machines have access. Attach a machine to use this integration."
msgstr ""
"Keine Maschinen haben Zugriff. Ordnen Sie eine Maschine zu, um diese "
"Integration zu verwenden."

