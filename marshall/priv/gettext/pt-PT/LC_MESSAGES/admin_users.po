#: lib/marshall_web/live/admin/users_live.ex:146
#, elixir-autogen, elixir-format
msgid "Email address"
msgstr "Endereço de e-mail"

#: lib/marshall_web/live/admin/users_live.ex:139
#, elixir-autogen, elixir-format
msgid "Every account on this deployment. Signed-in users can read this page; changes need an administrator with a recent passkey verification."
msgstr ""
"Todas as contas desta implantação. Utilizadors autenticados podem ler esta "
"página; alterações exigem um administrador com verificação recente por chave"
" de acesso."

#: lib/marshall_web/live/admin/users_live.ex:194
#, elixir-autogen, elixir-format
msgid "Grant this account access to administer the entire fleet and all machines?"
