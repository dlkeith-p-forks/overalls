msgstr "Convidar um utilizador"

#: lib/marshall_web/live/admin/users_live.ex:166
#, elixir-autogen, elixir-format
msgid "MFA enabled"
msgstr "MFA ativada"

#: lib/marshall_web/live/admin/users_live.ex:167
#, elixir-autogen, elixir-format
