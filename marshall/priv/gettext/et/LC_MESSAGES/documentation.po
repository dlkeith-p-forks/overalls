#: lib/marshall/documentation_messages.ex:6178
#, elixir-autogen, elixir-format
msgid "Inception requires nested KVM, its registered image, and a private SMTP bundle.\nIts minimum shape is 16 vCPUs, 32 GiB RAM, a 64 GiB root, and a separate sparse\n256 GiB data drive. Both drives count toward admission. The inner deployment\nretains its database, keys, and ZFS identity; initialization must not format an\nalready initialized but mismatched disk. It does not offer another Inception layer."
msgstr ""

#: lib/marshall/documentation_messages.ex:6182
#, elixir-autogen, elixir-format
msgid "Include these keys in every managed encrypted document."
