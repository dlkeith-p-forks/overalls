#, elixir-autogen, elixir-format
msgid "Loopback port of the egress node's outbound HTTP proxy."
msgstr ""

#: lib/marshall/documentation_messages.ex:6426
#, elixir-autogen, elixir-format
msgid "Loopback-only Fluent Bit numeric application health exporter when fleet telemetry and logging are enabled."
msgstr ""

