msgid "Verification required. Use an existing passkey, or sign out and request a fresh email link before first enrollment."
msgstr "Verifikasi diperlukan. Gunakan kunci sandi yang ada, atau keluar dan minta tautan email baru sebelum pendaftaran pertama."

