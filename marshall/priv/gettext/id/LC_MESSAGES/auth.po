msgstr "Identitas ini telah dihentikan secara permanen"

#: lib/marshall_web/scim_sign_in_live.ex:53
#, elixir-autogen, elixir-format
msgid "Your organization manages Overalls accounts through its directory."
msgstr "Organisasi Anda mengelola akun Overalls melalui direktorinya."
