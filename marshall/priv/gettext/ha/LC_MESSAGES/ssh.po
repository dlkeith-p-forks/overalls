msgstr "Wannan amincewar SSH ba ta samuwa ko ta ƙare. Fara sabon haɗin SSH don sake gwadawa."

#: lib/marshall_web/live/ssh_approval_live.ex:96
#, elixir-autogen, elixir-format
msgid "This key will sign in as %{value1}. It can manage machines according to your account's permissions."
msgstr "Wannan maɓallin zai shiga azaman %{value1} . Yana iya sarrafa inji bisa ga izinin asusun ku."

