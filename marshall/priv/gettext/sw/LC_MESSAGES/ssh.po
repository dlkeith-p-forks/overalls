#: lib/marshall_web/live/ssh_approval_live.ex:114
#, elixir-autogen, elixir-format
msgid "Approve key"
msgstr "Idhinisha ufunguo"

#: lib/marshall_web/live/ssh_approval_live.ex:89
#, elixir-autogen, elixir-format
msgid "Approve this key only if you started the SSH connection and its fingerprint matches your SSH client."
msgstr "Idhinisha ufunguo huu ikiwa tu umeanzisha muunganisho wa SSH na alama yake ya kidole inalingana na mteja wako wa SSH."

#: lib/marshall_web/live/ssh_approval_live.ex:112
#, elixir-autogen, elixir-format
msgid "Approving…"
msgstr "Inaidhinisha..."

#: lib/marshall_web/live/ssh_approval_live.ex:104
#, elixir-autogen, elixir-format
msgid "Label (optional)"
msgstr "Lebo (ya hiari)"

#: lib/marshall_web/live/ssh_approval_live.ex:124
#, elixir-autogen, elixir-format
msgid "Manage your SSH keys"
msgstr "Dhibiti funguo zako za SSH"

#: lib/marshall_web/live/ssh_approval_live.ex:106
#, elixir-autogen, elixir-format
msgid "My laptop"
msgstr "Laptop yangu"

#: lib/marshall_web/live/ssh_approval_live.ex:52
#: lib/marshall_web/live/ssh_approval_live.ex:118
#, elixir-autogen, elixir-format
msgid "SSH key approved. You can return to your SSH client."
msgstr "Ufunguo wa SSH umeidhinishwa. Unaweza kurudi kwenye mteja wako wa SSH."

#: lib/marshall_web/live/ssh_approval_live.ex:67
#, elixir-autogen, elixir-format
msgid "This SSH approval is unavailable or has expired. Start a new SSH connection to try again."
msgstr "Uidhinishaji huu wa SSH haupatikani au umeisha muda wake. Anzisha muunganisho mpya wa SSH ili ujaribu tena."

#: lib/marshall_web/live/ssh_approval_live.ex:96
#, elixir-autogen, elixir-format
msgid "This key will sign in as %{value1}. It can manage machines according to your account's permissions."
msgstr "Ufunguo huu utaingia kama %{value1} . Inaweza kudhibiti mashine kulingana na ruhusa za akaunti yako."

#: lib/marshall_web/ssh_approval_login.ex:29
#, elixir-autogen, elixir-format
msgid "Unavailable"
msgstr "Haipatikani"

