#: lib/marshall_web/live/integrations_live.ex:425
#, elixir-autogen, elixir-format
msgid "Name the endpoint and point it at an HTTPS API, or mark it as a peer connection to another machine. Secrets are write-only: they are stored for injection and never shown again."
msgstr "Ipe sehemu ya kufikia huduma jina na uielekeze kwenye API ya HTTPS, au uiweke kuwa muunganisho wa rika kwa mashine nyingine. Siri ni za kuandika pekee: huhifadhiwa ili kuingizwa kwenye maombi na hazionyeshwi tena."

#: lib/marshall_web/live/integrations_live.ex:219
#, elixir-autogen, elixir-format
msgid "Named endpoints your machines reach at https://NAME.integration.internal. Credentials are injected at the edge and are never readable from a machine."
msgstr "Sehemu za kufikia huduma zenye majina ambazo mashine zako hufikia kupitia https://NAME.integration.internal. Vitambulisho vya ufikiaji huingizwa kwenye mpaka wa mfumo na haviwezi kusomwa kamwe kutoka mashine."

#: lib/marshall_web/live/integrations_live.ex:362
#, elixir-autogen, elixir-format
msgid "No explicit attachments. Current team members' machines have access."
msgstr "Hakuna viambatisho dhahiri. Mashine za sasa za washiriki wa timu zinaweza kufikia."

#: lib/marshall_web/live/integrations_live.ex:349
#, elixir-autogen, elixir-format
msgid "No injected headers."
msgstr "Hakuna vichwa vilivyoingizwa."

#: lib/marshall_web/live/integrations_live.ex:295
#, elixir-autogen, elixir-format
msgid "No integrations yet. Add one below to give your machines a named connection to an API or to another machine."
msgstr "Bado hakuna miunganisho. Ongeza moja hapa chini ili kuzipa mashine zako muunganisho uliopewa jina kwa API au kwa mashine nyingine."

#: lib/marshall_web/live/integrations_live.ex:367
#, elixir-autogen, elixir-format
msgid "No machines have access. Attach a machine to use this integration."
msgstr "Hakuna mashine zinazoweza kufikia. Ambatisha mashine ili kutumia muunganisho huu."

