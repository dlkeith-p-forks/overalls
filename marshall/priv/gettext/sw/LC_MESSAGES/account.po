#: lib/marshall_web/live/account_live.ex:508
#, elixir-autogen, elixir-format
msgid "Git identity"
msgstr "Kitambulisho cha Git"

#: lib/marshall_web/live/account_live.ex:836
#, elixir-autogen, elixir-format
msgid "Git identity changes apply to new machines. Commit attribution changes apply to future agent requests."
msgstr "Mabadiliko ya utambulisho wa Git hutumika kwa mashine mpya. Mabadiliko ya utambuzi kwenye komiti hutumika kwa maombi yajayo ya wakala."

#: lib/marshall_web/live/account_live.ex:267
#, elixir-autogen, elixir-format
