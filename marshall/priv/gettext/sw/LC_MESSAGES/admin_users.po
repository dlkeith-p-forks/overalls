msgid "%{count} owned machine"
msgid_plural "%{count} owned machines"
msgstr[0] "Mashine %{count} inayomilikiwa"
msgstr[1] "Mashine %{count} zinazomilikiwa"

#: lib/marshall_web/live/admin/users_live.ex:302
#, elixir-autogen, elixir-format
msgid "Account pages"
msgstr "Kurasa za akaunti"

#: lib/marshall_web/live/admin/users_live.ex:100
#, elixir-autogen, elixir-format
msgid "Account request accepted."
msgstr "Ombi la akaunti limekubaliwa."

#: lib/marshall_web/live/admin/users_live.ex:134
#, elixir-autogen, elixir-format
msgid "Accounts are temporarily unavailable."
msgstr "Akaunti hazipatikani kwa sasa."

#: lib/marshall_web/live/admin/users_live.ex:190
#, elixir-autogen, elixir-format
msgid "Administrator"
msgstr "Msimamizi"

#: lib/marshall_web/live/admin/users_live.ex:45
#, elixir-autogen, elixir-format
msgid "Administrator access updated."
msgstr "Idhini ya kufikia ya msimamizi imesasishwa."

#: lib/marshall_web/live/admin/users_live.ex:72
#, elixir-autogen, elixir-format
msgid "Browser sessions revoked."
msgstr "Vipindi vya kivinjari vimebatilishwa."

#: lib/marshall_web/live/admin/users_live.ex:108
#, elixir-autogen, elixir-format
msgid "Could not accept this account change. Check confirmation and verify your passkey."
msgstr "Mabadiliko haya ya akaunti hayakuweza kukubaliwa. Kagua uthibitisho na uthibitishe ufunguo wako wa kuingia."

#: lib/marshall_web/live/admin/users_live.ex:53
#, elixir-autogen, elixir-format
msgid "Could not change administrator access."
msgstr "Haikuweza kubadilisha ufikiaji wa msimamizi."

#: lib/marshall_web/live/admin/users_live.ex:77
#, elixir-autogen, elixir-format
msgid "Could not revoke browser sessions."
msgstr "Haikuweza kubatilisha vipindi vya kivinjari."

#: lib/marshall_web/live/admin/users_live.ex:293
#, elixir-autogen, elixir-format
msgid "Delete user and machines"
msgstr "Futa mtumiaji na mashine"

#: lib/marshall_web/live/admin/users_live.ex:170
#, elixir-autogen, elixir-format
msgid "Email address"
msgstr "Anwani ya barua pepe"

#: lib/marshall_web/live/admin/users_live.ex:154
#, elixir-autogen, elixir-format
msgid "Every account on this deployment. Signed-in users can read this page; changes need an administrator with a recent passkey verification."
msgstr "Kila akaunti katika usambazaji huu. Watumiaji walioingia wanaweza kusoma ukurasa huu; mabadiliko yanahitaji msimamizi aliyethibitisha ufunguo wa kuingia hivi karibuni."

#: lib/marshall_web/live/admin/users_live.ex:233
#, elixir-autogen, elixir-format
msgid "Grant this account access to administer the entire fleet and all machines?"
msgstr "Je, ungependa kuipa akaunti hii idhini ya kufikia ili kudhibiti kundi zima na mashine zote?"

#: lib/marshall_web/live/admin/users_live.ex:91
#, elixir-autogen, elixir-format
msgid "Invalid request."
msgstr "Ombi batili."

#: lib/marshall_web/live/admin/users_live.ex:163
#, elixir-autogen, elixir-format
msgid "Invite a user"
msgstr "Alika mtumiaji"

#: lib/marshall_web/live/admin/users_live.ex:202
#, elixir-autogen, elixir-format
msgid "MFA enabled"
msgstr "MFA imewashwa"

#: lib/marshall_web/live/admin/users_live.ex:203
#, elixir-autogen, elixir-format
msgid "MFA not enrolled"
msgstr "MFA haijasajiliwa"

#: lib/marshall_web/live/admin/users_live.ex:242
#, elixir-autogen, elixir-format
msgid "Make administrator"
msgstr "Fanya msimamizi"

#: lib/marshall_web/live/admin/users_live.ex:308
#, elixir-autogen, elixir-format
msgid "Next page →"
msgstr "Ukurasa unaofuata →"

#: lib/marshall_web/live/admin/users_live.ex:300
#, elixir-autogen, elixir-format
msgid "No accounts on this page."
msgstr "Hakuna akaunti kwenye ukurasa huu."

#: lib/marshall_web/live/admin/users_live.ex:287
#, elixir-autogen, elixir-format
msgid "Permanently delete this account and ALL machines they own, including machines shared with others?"
msgstr "Ungependa kufuta kabisa akaunti hii na mashine ZOTE inazomiliki, pamoja na mashine zinazoshirikiwa na wengine?"

#: lib/marshall_web/live/admin/users_live.ex:241
#, elixir-autogen, elixir-format
msgid "Remove administrator"
msgstr "Ondoa msimamizi"

#: lib/marshall_web/live/admin/users_live.ex:231
#, elixir-autogen, elixir-format
msgid "Remove administrator access for this account?"
msgstr "Je, ungependa kuondoa ufikiaji wa msimamizi wa akaunti hii?"

#: lib/marshall_web/live/admin/users_live.ex:264
#, elixir-autogen, elixir-format
msgid "Reset MFA"
msgstr "Weka upya MFA"

#: lib/marshall_web/live/admin/users_live.ex:258
#, elixir-autogen, elixir-format
msgid "Reset this user's MFA and revoke all browser sessions? They must enroll a replacement passkey."
msgstr "Ungependa kuweka upya MFA ya mtumiaji huyu na kubatilisha vipindi vyote vya kivinjari? Lazima asajili ufunguo mbadala wa kuingia."

#: lib/marshall_web/live/admin/users_live.ex:173
#, elixir-autogen, elixir-format
msgid "Send invitation"
msgstr "Tuma mwaliko"

#: lib/marshall_web/live/admin/users_live.ex:252
#, elixir-autogen, elixir-format
msgid "Sign out everywhere"
msgstr "Ondoka kila mahali"

#: lib/marshall_web/live/admin/users_live.ex:249
#, elixir-autogen, elixir-format
msgid "Sign this account out of every browser session?"
msgstr "Ungependa kuondoa akaunti hii kwenye kila kipindi cha kivinjari?"

#: lib/marshall_web/live/admin/users_live.ex:277
#, elixir-autogen, elixir-format
msgid "Type the email to delete this account and its %{count} machines"
msgstr "Andika barua pepe ili kufuta akaunti hii na mashine zake za %{count}"

#: lib/marshall_web/live/admin/users_live.ex:191
#, elixir-autogen, elixir-format
msgid "User"
msgstr "Mtumiaji"

#: lib/marshall_web/live/admin/users_live.ex:152
#, elixir-autogen, elixir-format
msgid "Users"
msgstr "Watumiaji"

#: lib/marshall_web/live/admin/users_live.ex:177
#, elixir-autogen, elixir-format
msgid "Verify with passkey · administrative access lasts 15 minutes →"
msgstr "Thibitisha kwa kutumia nenosiri · ufikiaji wa msimamizi hudumu dakika 15 →"

#: lib/marshall_web/live/admin/users_live.ex:205
#, elixir-autogen, elixir-format
msgid "· Your account"
msgstr "· Akaunti yako"

#: lib/marshall_web/live/admin/users_live.ex:303
#, elixir-autogen, elixir-format
msgid "← First page"
msgstr "← Ukurasa wa kwanza"

#: lib/marshall_web/live/admin/users_live.ex:322
#, elixir-autogen, elixir-format
msgid "Deleted"
msgstr "Imefutwa"

#: lib/marshall_web/live/admin/users_live.ex:327
#, elixir-autogen, elixir-format
msgid "Deleting machines"
msgstr "Inafuta mashine"

#: lib/marshall_web/live/admin/users_live.ex:325
#, elixir-autogen, elixir-format
