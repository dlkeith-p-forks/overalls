#: lib/marshall_web/controllers/auth_controller.ex:89
#, elixir-autogen, elixir-format
msgid "An account with this email already exists. We've sent a link to that\naddress - confirm it to finish linking this provider to your account.\n"
msgstr ""
"इस ईमेल का खाता पहले से मौजूद है। हमने उस पते पर एक लिंक भेजा है -\n"
"इस प्रदाता को अपने खाते से जोड़ने के लिए उसकी पुष्टि करें।\n"

#: lib/marshall_web/auth_overrides.ex:15
#: lib/marshall_web/auth_text.ex:29
#, elixir-autogen, elixir-format
msgid "Check your email for a sign-in link. Your account will be created automatically when you sign in."
msgstr ""
"साइन इन लिंक के लिए अपना ईमेल देखें। साइन इन करने पर आपका खाता अपने आप बन "
"जाएगा।"

#: lib/marshall_web/automatic_magic_sign_in_live.ex:33
#, elixir-autogen, elixir-format
msgid "Continue to Overalls"
msgstr "Overalls पर आगे बढ़ें"

#: lib/marshall_web/auth_text.ex:23
#, elixir-autogen, elixir-format
msgid "Email"
msgstr "ईमेल"

#: lib/marshall_web/auth_text.ex:14
#, elixir-autogen, elixir-format
msgid "Email me a sign-in link"
msgstr "मुझे साइन इन लिंक ईमेल करें"

#: lib/marshall/accounts/deliver_auth_email.ex:153
#, elixir-autogen, elixir-format
msgid "If you did not request this, ignore this email."
msgstr "यदि आपने यह अनुरोध नहीं किया है, तो इस ईमेल को अनदेखा करें।"

#: lib/marshall_web/controllers/auth_controller.ex:95
#, elixir-autogen, elixir-format
msgid "Incorrect email or password"
msgstr "ईमेल या पासवर्ड गलत है"

#: lib/marshall_web/auth_text.ex:26
#, elixir-autogen, elixir-format
msgid "Remember me"
msgstr "मुझे याद रखें"

#: lib/marshall_web/auth_text.ex:17
#, elixir-autogen, elixir-format
msgid "Sending link…"
msgstr "लिंक भेजा जा रहा है…"

#: lib/marshall/accounts/deliver_auth_email.ex:149
#: lib/marshall_web/auth_text.ex:20
#, elixir-autogen, elixir-format
msgid "Sign in"
msgstr "साइन इन करें"

#: lib/marshall/accounts/deliver_auth_email.ex:146
#, elixir-autogen, elixir-format
msgid "Sign in to Overalls:"
msgstr "Overalls में साइन इन करें:"

#: lib/marshall/accounts/deliver_auth_email.ex:138
#, elixir-autogen, elixir-format
msgid "Sign in to Overalls: %{link}\n\nIf you did not request this, ignore this email."
msgstr ""
"Overalls में साइन इन करें: %{link}\n"
"\n"
"यदि आपने यह अनुरोध नहीं किया है, तो इस ईमेल को अनदेखा करें।"

#: lib/marshall_web/controllers/audi_login_controller.ex:35
#, elixir-autogen, elixir-format
msgid "Sign-in unavailable"
msgstr "साइन इन उपलब्ध नहीं है"

#: lib/marshall_web/automatic_magic_sign_in_live.ex:27
#, elixir-autogen, elixir-format
msgid "Signing you in"
msgstr "आपको साइन इन किया जा रहा है"

#: lib/marshall_web/controllers/audi_login_controller.ex:44
#, elixir-autogen, elixir-format
msgid "Unavailable"
msgstr "अनुपलब्ध"

#: lib/marshall_web/controllers/auth_controller.ex:38
#, elixir-autogen, elixir-format
msgid "You are now signed in"
msgstr "आप साइन इन हो गए हैं"

#: lib/marshall_web/controllers/auth_controller.ex:152
#, elixir-autogen, elixir-format
msgid "You are now signed out"
msgstr "आप साइन आउट हो गए हैं"

#: lib/marshall_web/controllers/auth_controller.ex:80
#, elixir-autogen, elixir-format
msgid "You have already signed in another way, but have not confirmed your account.\nYou can confirm your account using the link we sent to you, or by resetting your password.\n"
msgstr ""
"आप दूसरे तरीके से साइन इन कर चुके हैं, लेकिन खाते की पुष्टि नहीं की है।\n"
"भेजे गए लिंक से या पासवर्ड रीसेट करके अपने खाते की पुष्टि कर सकते हैं।\n"

#: lib/marshall/accounts/deliver_auth_email.ex:135
#, elixir-autogen, elixir-format
msgid "Your Overalls sign-in link"
msgstr "आपका Overalls साइन इन लिंक"

#: lib/marshall_web/controllers/auth_controller.ex:36
#, elixir-autogen, elixir-format
msgid "Your email address has now been confirmed"
msgstr "आपके ईमेल पते की पुष्टि हो गई है"

#: lib/marshall_web/automatic_magic_sign_in_live.ex:28
#, elixir-autogen, elixir-format
msgid "Your email link is being verified."
msgstr "आपके ईमेल लिंक का सत्यापन किया जा रहा है।"

#: lib/marshall_web/controllers/auth_controller.ex:37
#, elixir-autogen, elixir-format
msgid "Your password has successfully been reset"
msgstr "आपका पासवर्ड सफलतापूर्वक रीसेट हुआ"

#: lib/marshall_web/controllers/auth_controller.ex:58
#, elixir-autogen, elixir-format
msgid "Your sign-in is no longer valid. Request a new sign-in link."
msgstr "आपका साइन इन अब मान्य नहीं है। नया साइन इन लिंक माँगें।"
