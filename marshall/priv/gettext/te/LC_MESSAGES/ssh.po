#: lib/marshall_web/live/ssh_approval_live.ex:68
#, elixir-autogen, elixir-format
msgid "Approve SSH key"
msgstr "SSH కీకి ఆమోదం ఇవ్వు"

#: lib/marshall_web/live/ssh_approval_live.ex:94
#, elixir-autogen, elixir-format
msgid "Approve key"
msgstr "కీకి ఆమోదం ఇవ్వు"

#: lib/marshall_web/live/ssh_approval_live.ex:71
#, elixir-autogen, elixir-format
msgid "Approve this key only if you started the SSH connection and its fingerprint matches your SSH client."
msgstr ""
"మీరు SSH కనెక్షన్ ప్రారంభించి, దాని వేలిముద్ర మీ SSH క్లయింట్‌తో సరిపోలితేనే"
" ఈ కీని ఆమోదించండి."

#: lib/marshall_web/live/ssh_approval_live.ex:92
#, elixir-autogen, elixir-format
msgid "Approving…"
msgstr "ఆమోదిస్తోంది…"

#: lib/marshall_web/live/ssh_approval_live.ex:84
#, elixir-autogen, elixir-format
msgid "Label (optional)"
msgstr "లేబుల్ (ఐచ్ఛికం)"

#: lib/marshall_web/live/ssh_approval_live.ex:97
#, elixir-autogen, elixir-format
msgid "Manage your SSH keys"
msgstr "SSH కీలను నిర్వహించండి"

#: lib/marshall_web/live/ssh_approval_live.ex:86
#, elixir-autogen, elixir-format
msgid "My laptop"
msgstr "నా ల్యాప్‌టాప్"

#: lib/marshall_web/live/ssh_approval_live.ex:35
#, elixir-autogen, elixir-format
msgid "SSH key approved. You can return to your SSH client."
msgstr "SSH కీ ఆమోదించబడింది. SSH క్లయింట్‌కు తిరిగి వెళ్లవచ్చు."

#: lib/marshall_web/live/ssh_approval_live.ex:50
#, elixir-autogen, elixir-format
msgid "This SSH approval is unavailable or has expired. Start a new SSH connection to try again."
msgstr ""
"SSH ఆమోదం అందుబాటులో లేదు లేదా గడువు ముగిసింది. కొత్త SSH కనెక్షన్ "
"ప్రారంభించండి."

#: lib/marshall_web/live/ssh_approval_live.ex:77
#, elixir-autogen, elixir-format
msgid "This key will sign in as %{value1}. It can manage machines according to your account's permissions."
msgstr ""
"ఈ కీ %{value1}గా సైన్ ఇన్ అవుతుంది. ఖాతా అనుమతుల ప్రకారం యంత్రాలు "
"నిర్వహించగలదు."

#: lib/marshall_web/ssh_approval_login.ex:29
#, elixir-autogen, elixir-format
msgid "Unavailable"
msgstr "అందుబాటులో లేదు"
