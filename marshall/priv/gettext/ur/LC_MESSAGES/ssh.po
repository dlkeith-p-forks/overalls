#: lib/marshall_web/live/ssh_approval_live.ex:86
#, elixir-autogen, elixir-format
msgid "Approve this key only if you started the SSH connection and its fingerprint matches your SSH client."
msgstr "یہ کلید صرف تب منظور کریں جب SSH اتصال آپ نے شروع کیا ہو اور اس کا فنگرپرنٹ آپ کے SSH کلائنٹ سے ملتا ہو۔"

#: lib/marshall_web/live/ssh_approval_live.ex:109
#, elixir-autogen, elixir-format
msgid "Approving…"
msgstr "منظوری جاری ہے…"

#: lib/marshall_web/live/ssh_approval_live.ex:101
#, elixir-autogen, elixir-format
msgid "Label (optional)"
msgstr "لیبل (اختیاری)"

#: lib/marshall_web/live/ssh_approval_live.ex:120
#, elixir-autogen, elixir-format
msgid "Manage your SSH keys"
msgstr "اپنی SSH کلیدیں سنبھالیں"

#: lib/marshall_web/live/ssh_approval_live.ex:103
#, elixir-autogen, elixir-format
msgid "My laptop"
msgstr "میرا لیپ ٹاپ"

#: lib/marshall_web/live/ssh_approval_live.ex:50
#: lib/marshall_web/live/ssh_approval_live.ex:115
#, elixir-autogen, elixir-format
msgid "SSH key approved. You can return to your SSH client."
msgstr "SSH کلید منظور ہوئی۔ اپنے SSH کلائنٹ پر واپس جا سکتے ہیں۔"

#: lib/marshall_web/live/ssh_approval_live.ex:64
#, elixir-autogen, elixir-format
msgid "This SSH approval is unavailable or has expired. Start a new SSH connection to try again."
msgstr "یہ SSH منظوری دستیاب نہیں یا اس کی میعاد ختم ہو گئی ہے۔ دوبارہ کوشش کے لیے نیا SSH رابطہ شروع کریں۔"

#: lib/marshall_web/live/ssh_approval_live.ex:93
#, elixir-autogen, elixir-format
msgid "This key will sign in as %{value1}. It can manage machines according to your account's permissions."
msgstr "یہ کلید %{value1} کے طور پر سائن ان کرے گی۔ یہ آپ کے کھاتے کی اجازتوں کے مطابق مشینوں کا انتظام کر سکتی ہے۔"

#: lib/marshall_web/ssh_approval_login.ex:29
