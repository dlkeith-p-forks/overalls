#: lib/marshall_web/browser_messages.ex:11
#, elixir-autogen, elixir-format
msgid "%{count}d ago"
msgstr "hace %{count} días"

#: lib/marshall_web/browser_messages.ex:12
#, elixir-autogen, elixir-format
msgid "%{count}h ago"
msgstr "hace %{count} horas"

#: lib/marshall_web/browser_messages.ex:13
#, elixir-autogen, elixir-format
msgid "%{count}m ago"
msgstr "hace %{count} minutos"

#: lib/marshall_web/browser_messages.ex:14
#, elixir-autogen, elixir-format
msgid "%{label} copied."
msgstr "%{label} copiado."

#: lib/marshall_web/browser_messages.ex:9
#, elixir-autogen, elixir-format
msgid "%{name} · %{count} viewing"
msgstr "%{name} · %{count} viendo"

#: lib/marshall_web/browser_messages.ex:10
#, elixir-autogen, elixir-format
msgid "%{name} · %{count} viewing · %{activity}"
msgstr "%{name} · %{count} viendo · %{activity}"

#: lib/marshall_web/browser_messages.ex:8
#, elixir-autogen, elixir-format
msgid "%{name} · Terminals"
msgstr "%{name} · Terminales"

#: lib/marshall_web/browser_messages.ex:15
#, elixir-autogen, elixir-format
msgid "+ New"
msgstr "+ Nuevo"

#: lib/marshall_web/browser_messages.ex:16
#, elixir-autogen, elixir-format
msgid "Applying administrative change…"
msgstr "Aplicando cambio administrativo…"

#: lib/marshall_web/browser_messages.ex:17
#, elixir-autogen, elixir-format
msgid "Boot log · read-only"
msgstr "Registro de arranque · solo lectura"

#: lib/marshall_web/browser_messages.ex:18
#, elixir-autogen, elixir-format
msgid "Close this terminal session?"
msgstr "¿Cerrar esta sesión de terminal?"

#: lib/marshall_web/browser_messages.ex:19
#, elixir-autogen, elixir-format
msgid "Command"
msgstr "Comando"

#: lib/marshall_web/browser_messages.ex:20
#, elixir-autogen, elixir-format
msgid "Could not copy. Select the text and copy it manually."
msgstr "No se pudo copiar. Selecciona el texto y cópialo manualmente."

#: lib/marshall_web/browser_messages.ex:21
#, elixir-autogen, elixir-format
msgid "Could not update access. Check the account's machine access."
msgstr ""
"No se pudo actualizar el acceso. Comprueba el acceso de la cuenta a la "
"máquina."

#: lib/marshall_web/browser_messages.ex:22
#, elixir-autogen, elixir-format
msgid "Design diagram; explanation follows in the handbook"
msgstr "Diagrama de diseño; la explicación aparece en el manual"

#: lib/marshall_web/browser_messages.ex:23
#, elixir-autogen, elixir-format
msgid "Enter full screen"
msgstr "Entrar en pantalla completa"

#: lib/marshall_web/browser_messages.ex:24
#, elixir-autogen, elixir-format
msgid "Exit full screen"
msgstr "Salir de pantalla completa"

#: lib/marshall_web/browser_messages.ex:25
#, elixir-autogen, elixir-format
msgid "Input buffer full — that input was not sent"
msgstr "Búfer de entrada lleno — no se envió esa entrada"

#: lib/marshall_web/browser_messages.ex:26
#, elixir-autogen, elixir-format
msgid "Match found"
msgstr "Coincidencia encontrada"

#: lib/marshall_web/browser_messages.ex:27
#, elixir-autogen, elixir-format
msgid "No matches"
msgstr "Sin coincidencias"

#: lib/marshall_web/browser_messages.ex:28
#, elixir-autogen, elixir-format
msgid "Open this link?\n\n%{url}"
msgstr ""
"¿Abrir este enlace?\n"
"\n"
"%{url}"

#: lib/marshall_web/browser_messages.ex:29
#, elixir-autogen, elixir-format
msgid "Opening…"
msgstr "Abriendo…"

#: lib/marshall_web/browser_messages.ex:30
#, elixir-autogen, elixir-format
msgid "Passkey request cancelled. You can try again."
msgstr "Solicitud de clave de acceso cancelada. Puedes volver a intentarlo."

#: lib/marshall_web/browser_messages.ex:31
#, elixir-autogen, elixir-format
msgid "Passkey verification failed or unavailable. Try again."
msgstr ""
"La verificación con clave de acceso falló o no está disponible. Inténtalo de"
" nuevo."

#: lib/marshall_web/browser_messages.ex:32
#, elixir-autogen, elixir-format
msgid "Terminal name (this browser only; empty restores the generated name)"
msgstr ""
"Nombre de terminal (solo en este navegador; vacío restablece el nombre "
"generado)"

#: lib/marshall_web/browser_messages.ex:33
#, elixir-autogen, elixir-format
msgid "The result could not be confirmed. Reload the page and check the result before retrying."
msgstr ""
"No se pudo confirmar el resultado. Recarga la página y comprueba el "
"resultado antes de reintentar."

#: lib/marshall_web/browser_messages.ex:34
#, elixir-autogen, elixir-format
msgid "This machine asks to write %{bytes} bytes to your clipboard. Type once, session, or mute."
msgstr ""
"Esta máquina solicita escribir %{bytes} bytes en tu portapapeles. Escribe "
"once, session o mute."

#: lib/marshall_web/browser_messages.ex:35
#, elixir-autogen, elixir-format
msgid "This repository link could not be launched. Open the link again."
msgstr ""
"No se pudo iniciar este enlace de repositorio. Abre el enlace de nuevo."

#: lib/marshall_web/browser_messages.ex:36
#, elixir-autogen, elixir-format
msgid "Type to interact"
msgstr "Escribe para interactuar"

#: lib/marshall_web/browser_messages.ex:37
#, elixir-autogen, elixir-format
msgid "Updating viewing access…"
msgstr "Actualizando acceso de visualización…"

#: lib/marshall_web/browser_messages.ex:38
#, elixir-autogen, elixir-format
msgid "Verification could not be completed. Try again."
msgstr "No se pudo completar la verificación. Inténtalo de nuevo."

#: lib/marshall_web/browser_messages.ex:39
#, elixir-autogen, elixir-format
msgid "Verify with your passkey to %{action}. This runs once after verification."
msgstr ""
"Verifica con tu clave de acceso para %{action}. Se ejecutará una vez tras la"
" verificación."

#: lib/marshall_web/browser_messages.ex:40
#, elixir-autogen, elixir-format
msgid "View only"
msgstr "Solo lectura"

#: lib/marshall_web/browser_messages.ex:41
#, elixir-autogen, elixir-format
msgid "Viewing access updated."
msgstr "Acceso de visualización actualizado."

#: lib/marshall_web/browser_messages.ex:42
#, elixir-autogen, elixir-format
msgid "Waiting for your passkey…"
msgstr "Esperando tu clave de acceso…"

#: lib/marshall_web/browser_messages.ex:43
#, elixir-autogen, elixir-format
msgid "complete this administrative change"
msgstr "completar este cambio administrativo"

#: lib/marshall_web/browser_messages.ex:44
#, elixir-autogen, elixir-format
msgid "just now"
msgstr "justo ahora"

#: lib/marshall_web/browser_messages.ex:45
#, elixir-autogen, elixir-format
msgid "● live"
msgstr "● en directo"

#: lib/marshall_web/browser_messages.ex:46
#, elixir-autogen, elixir-format
msgid "● read-only"
msgstr "● solo lectura"

#: lib/marshall_web/browser_messages.ex:47
#, elixir-autogen, elixir-format
msgid "⟳ reconnecting…"
msgstr "⟳ reconectando…"

#: lib/marshall_web/browser_messages.ex:48
#, elixir-autogen, elixir-format
msgid "⟳ restoring scrollback…"
msgstr "⟳ restaurando historial…"
