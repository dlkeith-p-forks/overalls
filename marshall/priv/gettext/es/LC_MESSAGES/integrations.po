#: lib/marshall_web/live/integrations_live.ex:477
#, elixir-autogen, elixir-format
msgid "Name the endpoint and point it at an HTTPS API, or mark it as a peer connection to another machine. Secrets are write-only: they are stored for injection and never shown again."
msgstr ""
"Asigna un nombre al punto de conexión y una API HTTPS de destino, o márcalo "
"como conexión entre pares con otra máquina. Los secretos son de solo "
"escritura: se almacenan para su inyección y nunca se vuelven a mostrar."

#: lib/marshall_web/live/integrations_live.ex:271
#, elixir-autogen, elixir-format
msgid "Named endpoints your machines reach at https://NAME.integration.internal. Credentials are injected at the edge and are never readable from a machine."
msgstr ""
"Puntos de conexión con nombre a los que tus máquinas acceden en "
"https://NAME.integration.internal. Las credenciales se inyectan en el "
"perímetro y nunca se pueden leer desde una máquina."

#: lib/marshall_web/live/integrations_live.ex:414
#, elixir-autogen, elixir-format
msgid "No explicit attachments. Current team members' machines have access."
msgstr ""
"No hay máquinas adjuntadas explícitamente. Las máquinas de los miembros "
"actuales del equipo tienen acceso."

#: lib/marshall_web/live/integrations_live.ex:401
#, elixir-autogen, elixir-format
msgid "No injected headers."
msgstr "No hay cabeceras inyectadas."

#: lib/marshall_web/live/integrations_live.ex:347
#, elixir-autogen, elixir-format
msgid "No integrations yet. Add one below to give your machines a named connection to an API or to another machine."
msgstr ""
"Aún no hay integraciones. Añade una abajo para dar a tus máquinas una "
"conexión con nombre a una API o a otra máquina."

#: lib/marshall_web/live/integrations_live.ex:419
#, elixir-autogen, elixir-format
msgid "No machines have access. Attach a machine to use this integration."
msgstr ""
"Ninguna máquina tiene acceso. Adjunta una máquina para usar esta "
"integración."

