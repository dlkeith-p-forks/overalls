msgstr "No se pudo eliminar esta clave."

#: lib/marshall_web/live/account_live.ex:183
#, elixir-autogen, elixir-format
msgid "Could not rename this key. Use at most 128 characters."
msgstr "No se pudo cambiar el nombre de esta clave. Usa un máximo de 128 caracteres."

#: lib/marshall_web/live/account_live.ex:132
#, elixir-autogen, elixir-format
msgid "Credential change refused. Names must be 1–80 characters, changes need a passkey verified in the last 15 minutes, and administrators must keep at least one passkey."
msgstr ""
"Cambio de credenciales rechazado. Los nombres deben tener entre 1 y 80 "
"caracteres, los cambios requieren una clave de acceso verificada en los "
"últimos 15 minutos y los administradores deben conservar al menos una clave "
"de acceso."

#: lib/marshall_web/live/account_live.ex:703
#, elixir-autogen, elixir-format
