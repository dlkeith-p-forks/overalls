#: lib/marshall_web/live/account_live.ex:605
#, elixir-autogen, elixir-format
msgid "End this verification before the fifteen minutes are up."
msgstr ""
"Finaliza esta verificación antes de que transcurran los quince minutos."

#: lib/marshall_web/live/account_live.ex:251
#, elixir-autogen, elixir-format
