#: lib/marshall_web/live/account_live.ex:673
#, elixir-autogen, elixir-format
msgid "No SSH keys yet. You can always sign in here using email."
msgstr ""
"Aún no hay claves SSH. Siempre puedes iniciar sesión aquí por correo "
"electrónico."

#: lib/marshall_web/live/account_live.ex:613
#, elixir-autogen, elixir-format
msgid "No passkeys yet. First enrollment requires a fresh email sign-in completed within the last five minutes. After setup, return to the page you came from and retry the action."
msgstr ""
"Aún no hay claves de acceso. El registro inicial requiere un inicio de "
"sesión por correo realizado en los últimos cinco minutos. Tras configurarlo,"
" vuelve a la página anterior y reintenta la acción."

#: lib/marshall_web/live/account_live.ex:427
#, elixir-autogen, elixir-format
msgid "No zone saved and none detected; times are shown in UTC until you choose one."
msgstr ""
"No hay zona guardada ni detectada; las horas se muestran en UTC hasta que "
"elijas una."

#: lib/marshall_web/live/account_live.ex:448
#, elixir-autogen, elixir-format
msgid "On this page"
msgstr "En esta página"

#: lib/marshall_web/live/account_live.ex:98
#, elixir-autogen, elixir-format
msgid "Passkey added. Verify it when you need to approve an administrative change."
