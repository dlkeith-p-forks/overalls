#: lib/marshall_web/live/account_live.ex:656
#, elixir-autogen, elixir-format
msgid "Keep a backup passkey. If you lose access, another administrator can reset your passkeys."
msgstr ""
"Conserva una clave de acceso de respaldo. Si pierdes el acceso, otro "
"administrador puede restablecer tus claves de acceso."

#: lib/marshall_web/live/account_live.ex:668
#, elixir-autogen, elixir-format
msgid "Keys registered here open your machines over SSH with the same account and permissions as this site. Remove a key to revoke its access; email sign-in keeps working without any key."
msgstr ""
"Las claves registradas aquí abren tus máquinas por SSH con la misma cuenta y"
" permisos que este sitio. Elimina una clave para revocar su acceso; el "
"inicio de sesión por correo seguirá funcionando sin ninguna clave."

#: lib/marshall_web/live/account_live.ex:722
#, elixir-autogen, elixir-format
msgid "Label (optional)"
msgstr "Etiqueta (opcional)"

#: lib/marshall_web/live/account_live.ex:479
#, elixir-autogen, elixir-format
msgid "Language"
msgstr "Idioma"

#: lib/marshall_web/live/account_live.ex:485
#, elixir-autogen, elixir-format
msgid "Language is detected from your browser."
msgstr "El idioma se detecta a partir de tu navegador."

