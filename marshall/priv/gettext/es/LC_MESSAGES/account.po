#: lib/marshall_web/live/account_live.ex:111
#, elixir-autogen, elixir-format
msgid "Verification could not be completed. Please try again."
msgstr "No se pudo completar la verificación. Inténtalo de nuevo."

#: lib/marshall_web/live/account_live.ex:75
#, elixir-autogen, elixir-format
msgid "Verification required. Use an existing passkey, or sign out and request a fresh email link before first enrollment."
msgstr ""
"Se requiere verificación. Utiliza una clave de acceso existente o cierra "
"sesión y solicita un nuevo enlace por correo antes del primer registro."

#: lib/marshall_web/live/account_live.ex:570
#, elixir-autogen, elixir-format
msgid "Verify a passkey before making administrative changes or changing passkeys."
msgstr ""
"Verifica una clave de acceso antes de realizar cambios administrativos o "
"cambiar claves de acceso."

#: lib/marshall_web/live/account_live.ex:595
#, elixir-autogen, elixir-format
msgid "Verify with passkey"
msgstr "Verificar con clave de acceso"

#: lib/marshall_web/live/account_live.ex:446
#, elixir-autogen, elixir-format
msgid "Who you are, how you prove it, and the keys that reach your machines."
msgstr ""
"Quién eres, cómo lo demuestras y las claves que acceden a tus máquinas."

#: lib/marshall_web/live/account_live.ex:555
#, elixir-autogen, elixir-format
msgid "You sign in with an email link. A passkey proves it is you before administrative changes and before passkey changes; everyday use of your workspace never asks for one."
msgstr ""
"Inicias sesión mediante un enlace por correo electrónico. Una clave de "
"acceso verifica tu identidad antes de cambios administrativos y de claves de"
" acceso; el uso diario de tu espacio de trabajo nunca la solicita."

#: lib/marshall_web/live/account_live.ex:519
#, elixir-autogen, elixir-format
msgid "Your email is your sign-in identity and cannot be edited here. Every time on Overalls is shown in your zone; people who share a team, machine or thread with you, and administrators, see your current local time next to your email once a zone is saved."
msgstr ""
"Tu correo electrónico es tu identidad de inicio de sesión y no se puede "
"editar aquí. Todas las horas de Overalls se muestran en tu zona; quienes "
"compartan un equipo, una máquina o un hilo contigo, así como los "
"administradores, verán tu hora local junto a tu correo una vez que guardes "
"una zona."

#: lib/marshall_web/live/account_live.ex:617
#, elixir-autogen, elixir-format
msgid "Your passkeys"
msgstr "Tus claves de acceso"

#: lib/marshall_web/live/account_live.ex:576
#, elixir-autogen, elixir-format
msgid "Your passkeys were reset. Register a replacement before approving administrative changes."
msgstr ""
"Tus claves de acceso se han restablecido. Registra una de sustitución antes "
"de aprobar cambios administrativos."

#: lib/marshall_web/live/account_live.ex:484
#, elixir-autogen, elixir-format
msgid "Your saved language overrides browser preferences."
msgstr ""
"Tu idioma guardado tiene prioridad sobre las preferencias del navegador."

