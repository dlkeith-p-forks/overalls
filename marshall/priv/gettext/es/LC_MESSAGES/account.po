msgstr "Descripción"

#: lib/marshall_web/live/account_live.ex:422
#, elixir-autogen, elixir-format
msgid "Detected from your browser: %{value1}. Save it so others can see your local time."
msgstr ""
"Detectada en tu navegador: %{value1}. Guárdala para que otras personas vean "
"tu hora local."

#: lib/marshall_web/live/account_live.ex:503
