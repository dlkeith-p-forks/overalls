<?xml version="1.0" encoding="utf-8"?>
<!--
  Mila's MSIX manifest (ADR-0235). mila-build fills @PUBLISHER@ (the signing
  certificate's subject, or CN=Mila Development for the unsigned dev layout),
  @VERSION@ (four-part, last part zero) and @WNS_APP_ID@ (the Entra ID
  application id WNS issues channels for, the runner's MILA_WNS_REMOTE_ID).

  - overalls:// links start mila.exe with the link as its argument; a
    running window receives it from the second instance.
  - Notification clicks activate the COM server App SDK registers for
    ToastActivatorCLSID; raw pushes the Windows App SDK push server.
  - The Windows App SDK 1.6 runtime is a framework dependency; the runner's
    MILA_WINDOWS_APP_SDK_DIR must hold the same release.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap com desktop rescap">

  <Identity
    Name="dev.overalls.mila"
    Publisher="@PUBLISHER@"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Mila</DisplayName>
    <PublisherDisplayName>Overalls</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <PackageDependency
      Name="Microsoft.WindowsAppRuntime.1.6"
      MinVersion="6000.0.0.0"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Mila" Executable="mila.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Mila"
        Description="Mila for Overalls"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="overalls" Parameters="&quot;%1&quot;">
            <uap:DisplayName>Overalls link</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>

        <!-- Notification clicks (AppNotificationManager). -->
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="ff9cb632-0867-4f74-8b7c-b34d8a47d1fc" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="mila.exe" DisplayName="Mila notifications"
              Arguments="----AppNotificationActivated:">
              <com:Class Id="ff9cb632-0867-4f74-8b7c-b34d8a47d1fc" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>

        <!-- Raw WNS pushes (PushNotificationManager). -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="mila.exe" DisplayName="Mila push"
              Arguments="----WindowsAppRuntimePushServer:">
              <com:Class Id="@WNS_APP_ID@" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
