<Window x:Class="Mila.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <NavigationView x:Name="Navigation" IsBackEnabled="False" SelectionChanged="OnNavigationChanged">
    <NavigationView.MenuItems>
      <NavigationViewItem Content="Machines" Tag="machines" Icon="&#xE7F4;" />
      <NavigationViewItem Content="Threads" Tag="threads" Icon="&#xE8BD;" />
      <NavigationViewItem Content="Settings" Tag="settings" Icon="&#xE713;" />
    </NavigationView.MenuItems>
    <Grid Padding="24">
      <StackPanel Spacing="12">
        <TextBlock x:Name="PageTitle" Text="Machines" FontSize="28" />
        <TextBlock x:Name="PageBody" Text="Select a machine to view its status." TextWrapping="Wrap" />
        <TextBlock x:Name="StatusText" Text="Ready" Opacity="0.7" />
        <ListView x:Name="MachineRows" DisplayMemberPath="Name" MinHeight="120" />
        <StackPanel x:Name="ThreadPanel" Visibility="Collapsed" Spacing="8">
          <TextBlock Text="Thread commands" FontSize="18" />
          <TextBlock Text="Commands are validated by the Rust core before execution." TextWrapping="Wrap" Opacity="0.7" />
          <StackPanel Orientation="Horizontal">
            <Button Content="List" Click="ClassifyThreadList" Margin="0,0,8,0" />
            <Button Content="Show" Click="ClassifyThreadShow" Margin="0,0,8,0" />
            <Button Content="Turns" Click="ClassifyThreadTurns" Margin="0,0,8,0" />
            <Button Content="Read" Click="ClassifyThreadRead" />
          </StackPanel>
          <TextBlock x:Name="ThreadCommandStatus" Opacity="0.7" />
        </StackPanel>
        <Button Content="Refresh" Click="CheckNativeBridge" HorizontalAlignment="Left" />
      </StackPanel>
    </Grid>
  </NavigationView>
</Window>
