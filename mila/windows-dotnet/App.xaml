<Application
    x:Class="Mila.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="MilaTextBrush" Color="#000000" />
    <SolidColorBrush x:Key="MilaTextAltBrush" Color="#666666" />
    <SolidColorBrush x:Key="MilaBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MilaBackgroundAltBrush" Color="#EEEEEE" />
    <ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary x:Key="Dark">
        <SolidColorBrush x:Key="MilaTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MilaTextAltBrush" Color="#AAAAAA" />
        <SolidColorBrush x:Key="MilaBackgroundBrush" Color="#000000" />
        <SolidColorBrush x:Key="MilaBackgroundAltBrush" Color="#111111" />
      </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="JetBrains Mono" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource MilaTextBrush}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="JetBrains Mono" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <XamlControlsResources
        xmlns="using:Microsoft.UI.Xaml.Controls" />
  </Application.Resources>
</Application>
