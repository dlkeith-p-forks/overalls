{
  "format": 1,
  "name": "access-smtp",
  "compose_files": [
    "antithesis/config/docker-compose.yaml",
    "antithesis/config/compose.smtp.yaml"
  ],
  "templates": ["access"],
  "runtime_packages": ["core", "access", "repository"],
  "services": [
    "pg", "migrate", "marshall-a", "marshall-b", "lilly-a", "enrollment",
    "workload", "smtp"
  ],
  "workload_environment": [
    "ANTITHESIS_MARSHALL_URLS", "ANTITHESIS_CA_FILE", "ANTITHESIS_FIXTURE_MANIFEST",
    "ANTITHESIS_DB_HOST", "ANTITHESIS_DB_PASSWORD_FILE",
    "ANTITHESIS_CONTROL_CREDENTIAL_FILE", "ANTITHESIS_CONTROL_REQUEST_DIR",
    "ANTITHESIS_BOOTSTRAP_PROFILE", "ANTITHESIS_SMTP_CA_FILE",
    "ANTITHESIS_SMTP_ADMIN_TOKEN_FILE", "ANTITHESIS_SMTP_ADMIN_ORIGIN",
    "ANTITHESIS_ACCESS_FIXTURE_FILE"
  ],
  "bootstrap_template": "access-smtp",
  "singleton_templates": []
}
