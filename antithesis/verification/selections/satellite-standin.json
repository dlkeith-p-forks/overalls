{
  "format": 1,
  "name": "satellite-standin",
  "compose_files": [
    "antithesis/config/docker-compose.yaml",
    "antithesis/config/compose.origin.yaml",
    "antithesis/config/compose.satellites.yaml",
    "antithesis/config/compose.satellite-standin.yaml"
  ],
  "templates": ["satellite"],
  "runtime_packages": [
    "core", "satellite", "access", "admission", "repository", "terminal"
  ],
  "services": [
    "pg", "migrate", "marshall-a", "marshall-b", "lilly-a", "enrollment",
    "workload", "origin", "ziggy", "galileo", "audi-private", "porsche",
    "guest-standin"
  ],
  "workload_environment": [
    "ANTITHESIS_MARSHALL_URLS", "ANTITHESIS_CA_FILE", "ANTITHESIS_FIXTURE_MANIFEST",
    "ANTITHESIS_DB_HOST", "ANTITHESIS_DB_PASSWORD_FILE",
    "ANTITHESIS_CONTROL_CREDENTIAL_FILE", "ANTITHESIS_CONTROL_REQUEST_DIR",
    "ANTITHESIS_BOOTSTRAP_PROFILE", "ANTITHESIS_SATELLITE_READY",
    "ANTITHESIS_PRIVATE_ROOT_CA", "ANTITHESIS_GUEST_STANDIN_ROOT",
    "ANTITHESIS_ORIGIN_ADMIN_URL", "ANTITHESIS_ORIGIN_ADMIN_TOKEN_FILE",
    "ANTITHESIS_ACCESS_FIXTURE_FILE"
  ],
  "bootstrap_template": "satellite-standin",
  "singleton_templates": []
}
