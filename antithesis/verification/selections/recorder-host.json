{
  "format": 1,
  "name": "recorder-host",
  "compose_files": [
    "antithesis/config/docker-compose.yaml",
    "antithesis/config/compose.recorder-host.yaml"
  ],
  "templates": ["recorder"],
  "runtime_packages": ["core", "recorder", "access", "repository"],
  "services": [
    "pg", "migrate", "marshall-a", "marshall-b", "lilly-a", "enrollment",
    "workload", "recorder-host-vmm"
  ],
  "workload_environment": [
    "ANTITHESIS_MARSHALL_URLS", "ANTITHESIS_CA_FILE", "ANTITHESIS_FIXTURE_MANIFEST",
    "ANTITHESIS_DB_HOST", "ANTITHESIS_DB_PASSWORD_FILE",
    "ANTITHESIS_CONTROL_CREDENTIAL_FILE", "ANTITHESIS_CONTROL_REQUEST_DIR",
    "ANTITHESIS_BOOTSTRAP_PROFILE", "ANTITHESIS_RECORDER_REQUESTS",
    "ANTITHESIS_RECORDER_RESULTS", "ANTITHESIS_RECORDER_OBSERVATION",
    "ANTITHESIS_RECORDER_LEDGER"
  ],
  "bootstrap_template": "recorder-host",
  "singleton_templates": []
}
